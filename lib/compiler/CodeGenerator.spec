#! Package compiler
#! Pure Spec compiler implementation: Lexer, Parser, AST, Linter, TypeChecker, and CodeGenerator.

## Pure Spec C code generator translating [ProgramNode] AST to C11 code.
class CodeGenerator{

	replace local Array of String is using: [
		base:struct:Array,
		base:struct:Map,
		base:iterator:*,
		base:reflect:Type,
		base:reflect:Class,
		base:reflect:Member,
		base:reflect:Parameter,
		base:meta:*
	];

	## Name of the class currently being code-generated.
	local String is currentClassName: "";

	replace local Function is init(){
	}

	## Maps a Spec type name to its corresponding C11 type.
	##
	## @param typeName: Spec type name.
	## @return: C11 type signature string.
	replace local Function of String is cTypeFor(String is typeName){
		return when (typeName) {
			is "Int", "int": "long long";
			is "Float", "float": "double";
			is "Boolean", "bool": "bool";
			is "String", "string": "const char*";
			is "void", "": "void";
			is "Array": "SpecArray*";
			is "Map": "SpecMap*";
			else: typeName . "*";
		};
	}

	## Escapes special characters within string literals for C source output.
	##
	## @param s: Raw string text.
	## @return: C-escaped string.
	replace local Function of String is escapeString(String is s){
		class EscapeLoop extends Loop{
			local String is src;
			local Int is pos: 0;
			local String is res: "";

			init(String is src){
				self:src: src;
				self:pos: 0;
				self:res: "";
			}

			evaluate(){
				return pos < src:length();
			}

			iteration(control){
				local String is ch: src:charAt(index: pos, default: "");
				pos: pos + 1;
				when (ch) {
					is "\n": { res: res . "\\n"; }
					is "\t": { res: res . "\\t"; }
					is "\r": { res: res . "\\r"; }
					is "\"": { res: res . "\\\""; }
					is "\\": { res: res . "\\\\"; }
					else: { res: res . ch; }
				}
				return true;
			}
		}

		local EscapeLoop is escLoop: EscapeLoop:init(src: s);
		While:run(loop: escLoop);
		return escLoop:res;
	}

	## Emits the standard Spec C runtime prelude.
	##
	## @return: Complete C runtime prelude text.
	replace local Function of String is generatePrelude(){
		local String is p: "";
		p: p . "/* Generated by Pure-Spec Compiler */\n";
		p: p . "#include <stdio.h>\n";
		p: p . "#include <stdlib.h>\n";
		p: p . "#include <string.h>\n";
		p: p . "#include <stdbool.h>\n";
		p: p . "#include <stdint.h>\n";
		p: p . "#include <time.h>\n\n";

		p: p . "/* Spec Runtime String Utilities */\n";
		p: p . "char* spec_str_concat(const char* a, const char* b) {\n";
		p: p . "    if (!a) a = \"\";\n";
		p: p . "    if (!b) b = \"\";\n";
		p: p . "    size_t la = strlen(a);\n";
		p: p . "    size_t lb = strlen(b);\n";
		p: p . "    char* res = (char*)malloc(la + lb + 1);\n";
		p: p . "    memcpy(res, a, la);\n";
		p: p . "    memcpy(res + la, b, lb);\n";
		p: p . "    res[la + lb] = '\\0';\n";
		p: p . "    return res;\n";
		p: p . "}\n\n";

		p: p . "char* spec_to_string_int(long long v) {\n";
		p: p . "    char buf[64];\n";
		p: p . "    snprintf(buf, sizeof(buf), \"%lld\", v);\n";
		p: p . "    return strdup(buf);\n";
		p: p . "}\n\n";

		p: p . "char* spec_to_string_float(double v) {\n";
		p: p . "    char buf[64];\n";
		p: p . "    snprintf(buf, sizeof(buf), \"%g\", v);\n";
		p: p . "    return strdup(buf);\n";
		p: p . "}\n\n";

		p: p . "char* spec_to_string_bool(bool v) {\n";
		p: p . "    return v ? \"true\" : \"false\";\n";
		p: p . "}\n\n";

		p: p . "/* Spec Dynamic Array */\n";
		p: p . "typedef struct {\n";
		p: p . "    void** items;\n";
		p: p . "    size_t length;\n";
		p: p . "    size_t capacity;\n";
		p: p . "} SpecArray;\n\n";

		p: p . "SpecArray* spec_array_new(void) {\n";
		p: p . "    SpecArray* a = (SpecArray*)malloc(sizeof(SpecArray));\n";
		p: p . "    a->items = (void**)malloc(sizeof(void*) * 8);\n";
		p: p . "    a->length = 0;\n";
		p: p . "    a->capacity = 8;\n";
		p: p . "    return a;\n";
		p: p . "}\n\n";

		p: p . "void spec_array_add(SpecArray* a, void* item) {\n";
		p: p . "    if (!a) return;\n";
		p: p . "    if (a->length >= a->capacity) {\n";
		p: p . "        a->capacity *= 2;\n";
		p: p . "        a->items = (void**)realloc(a->items, sizeof(void*) * a->capacity);\n";
		p: p . "    }\n";
		p: p . "    a->items[a->length++] = item;\n";
		p: p . "}\n\n";

		p: p . "long long spec_array_length(SpecArray* a) {\n";
		p: p . "    return a ? (long long)a->length : 0;\n";
		p: p . "}\n\n";

		p: p . "void* spec_array_get(SpecArray* a, long long idx) {\n";
		p: p . "    if (!a || idx < 0 || (size_t)idx >= a->length) return NULL;\n";
		p: p . "    return a->items[idx];\n";
		p: p . "}\n\n";

		p: p . "/* Spec Hash Map */\n";
		p: p . "typedef struct SpecMapEntry {\n";
		p: p . "    char* key;\n";
		p: p . "    char* value;\n";
		p: p . "    struct SpecMapEntry* next;\n";
		p: p . "} SpecMapEntry;\n\n";

		p: p . "typedef struct {\n";
		p: p . "    SpecMapEntry* head;\n";
		p: p . "} SpecMap;\n\n";

		p: p . "SpecMap* spec_map_new(void) {\n";
		p: p . "    SpecMap* m = (SpecMap*)malloc(sizeof(SpecMap));\n";
		p: p . "    m->head = NULL;\n";
		p: p . "    return m;\n";
		p: p . "}\n\n";

		p: p . "void spec_map_set(SpecMap* m, const char* key, const char* val) {\n";
		p: p . "    if (!m || !key) return;\n";
		p: p . "    SpecMapEntry* curr = m->head;\n";
		p: p . "    while (curr) {\n";
		p: p . "        if (strcmp(curr->key, key) == 0) {\n";
		p: p . "            free(curr->value);\n";
		p: p . "            curr->value = val ? strdup(val) : \"\";\n";
		p: p . "            return;\n";
		p: p . "        }\n";
		p: p . "        curr = curr->next;\n";
		p: p . "    }\n";
		p: p . "    SpecMapEntry* e = (SpecMapEntry*)malloc(sizeof(SpecMapEntry));\n";
		p: p . "    e->key = strdup(key);\n";
		p: p . "    e->value = val ? strdup(val) : \"\";\n";
		p: p . "    e->next = m->head;\n";
		p: p . "    m->head = e;\n";
		p: p . "}\n\n";

		p: p . "const char* spec_map_getString(SpecMap* m, const char* key, const char* def) {\n";
		p: p . "    if (!m || !key) return def ? def : \"\";\n";
		p: p . "    SpecMapEntry* curr = m->head;\n";
		p: p . "    while (curr) {\n";
		p: p . "        if (strcmp(curr->key, key) == 0) return curr->value;\n";
		p: p . "        curr = curr->next;\n";
		p: p . "    }\n";
		p: p . "    return def ? def : \"\";\n";
		p: p . "}\n\n";

		return p;
	}

	## Resolves the C return type of a method signature descriptor.
	##
	## @param t: Declared [Type] descriptor.
	## @return: C return type string.
	replace local Function of String is resolveReturnType(Type is t){
		if (t:getName() == "Function") {
			if (t:getParams():length() > 0) {
				local Type is ret: t:getParams():get(index: 0);
				return self:cTypeFor(typeName: ret:getName());
			}
			return "void";
		}
		return self:cTypeFor(typeName: t:getName());
	}

	## Emits forward type and function declarations for all classes.
	##
	## @param classes: Array of [Class] definitions.
	## @return: C forward declarations text.
	replace local Function of String is generateForwardDeclarations(Array of Class is classes){
		local String is out: "/* Forward Declarations */\n";

		classes:each(action: local Function(Class is c){
			out: out . "typedef struct " . c:getName() . " " . c:getName() . ";\n";
			out: out . c:getName() . "* " . c:getName() . "_new(void);\n";
		});
		out: out . "\n";

		classes:each(action: local Function(Class is c){
			c:getMembers():each(action: local Function(Member is m){
				when (m:getMemberKind()) {
					is METHOD: {
						local String is retType: self:resolveReturnType(t: m:getType());

						out: out . retType . " " . c:getName() . "_" . m:getName() . "(" . c:getName() . "* self";
						m:getParameters():each(action: local Function(Parameter is p){
							out: out . ", " . self:cTypeFor(typeName: p:getType():getName()) . " " . p:getName();
						});
						out: out . ");\n";
					}
					else: {}
				}
			});
		});
		out: out . "\n";
		return out;
	}

	## Emits struct layout definitions for all classes.
	##
	## @param classes: Array of [Class] definitions.
	## @return: C struct definitions text.
	replace local Function of String is generateStructs(Array of Class is classes){
		local String is out: "/* Struct Layouts */\n";

		classes:each(action: local Function(Class is c){
			out: out . "struct " . c:getName() . " {\n";
			c:getMembers():each(action: local Function(Member is m){
				when (m:getMemberKind()) {
					is FIELD: {
						out: out . "    " . self:cTypeFor(typeName: m:getType():getName()) . " " . m:getName() . ";\n";
					}
					else: {}
				}
			});
			out: out . "};\n\n";
		});
		return out;
	}

	## Emits constructor factory functions for all classes.
	##
	## @param classes: Array of [Class] definitions.
	## @return: C constructor functions text.
	replace local Function of String is generateConstructors(Array of Class is classes){
		local String is out: "/* Constructor Implementations */\n";

		classes:each(action: local Function(Class is c){
			out: out . c:getName() . "* " . c:getName() . "_new(void) {\n";
			out: out . "    " . c:getName() . "* self = (" . c:getName() . "*)calloc(1, sizeof(" . c:getName() . "));\n";
			out: out . "    return self;\n";
			out: out . "}\n\n";
		});
		return out;
	}

	## Generates C code for an expression node.
	##
	## @param expr: [Expression] AST node.
	## @return: C expression code string.
	replace local Function of String is generateExpression(Expression is expr){
		local String is kind: expr:getKind();

		when (kind) {
			is "STRING": {
				return "\"" . self:escapeString(s: expr:stringValue) . "\"";
			}
			is "NUMBER": {
				return "" . expr:intValue;
			}
			is "FLOAT": {
				return "" . expr:floatValue;
			}
			is "BOOL": {
				return if (expr:boolValue) "true" else "false";
			}
			is "IDENT": {
				return expr:stringValue;
			}
			is "PATH": {
				local Array of String is segs: expr:pathSegments;
				if (segs:length() == 1) {
					return segs:get(index: 0);
				}
				return segs:get(index: 0) . "->" . segs:get(index: 1);
			}
			is "BINARY": {
				local String is op: expr:binaryOp;
				when (op) {
					is ".": {
						local String is leftC: self:generateExpression(expr: expr:leftExpr);
						local String is rightC: self:generateExpression(expr: expr:rightExpr);
						return "spec_str_concat(" . leftC . ", " . rightC . ")";
					}
					is "is", "==": {
						local String is leftC: self:generateExpression(expr: expr:leftExpr);
						local String is rightC: self:generateExpression(expr: expr:rightExpr);
						return "((" . leftC . ") == (" . rightC . "))";
					}
					is "!=": {
						local String is leftC: self:generateExpression(expr: expr:leftExpr);
						local String is rightC: self:generateExpression(expr: expr:rightExpr);
						return "((" . leftC . ") != (" . rightC . "))";
					}
					is "<", "<=", ">", ">=", "+", "-", "*", "/", "%", "&&", "||": {
						local String is leftC: self:generateExpression(expr: expr:leftExpr);
						local String is rightC: self:generateExpression(expr: expr:rightExpr);
						return "((" . leftC . ") " . op . " (" . rightC . "))";
					}
					else: {
						return "0";
					}
				}
			}
			is "UNARY": {
				local String is innerC: self:generateExpression(expr: expr:unaryExpr);
				return "(" . expr:unaryOp . "(" . innerC . "))";
			}
			is "CALL": {
				# output:line(...)
				if (expr:methodName == "line" && expr:methodArgs:length() > 0) {
					local NamedArg is firstArg: expr:methodArgs:get(index: 0);
					local String is valC: self:generateExpression(expr: firstArg:getValue());
					return "printf(\"%s\\n\", " . valC . ")";
				}

				# Method call on self: self:method(...)
				local String is targetC: self:generateExpression(expr: expr:methodTarget);
				local String is callStr: self:currentClassName . "_" . expr:methodName . "(" . targetC;
				expr:methodArgs:each(action: local Function(NamedArg is arg){
					callStr: callStr . ", " . self:generateExpression(expr: arg:getValue());
				});
				callStr: callStr . ")";
				return callStr;
			}
			else: {
				return "0";
			}
		}
	}

	## Generates C code for a statement node.
	##
	## @param stmt: [Statement] AST node.
	## @return: C statement code block.
	replace local Function of String is generateStatement(Statement is stmt){
		local String is kind: stmt:getKind();

		when (kind) {
			is "VAR_DECL": {
				local String is cType: self:cTypeFor(typeName: stmt:varType:getName());
				local String is varName: stmt:varName;
				if (stmt:hasInit) {
					local String is initC: self:generateExpression(expr: stmt:initExpr);
					return "    " . cType . " " . varName . " = " . initC . ";\n";
				}
				return "    " . cType . " " . varName . " = 0;\n";
			}
			is "ASSIGN": {
				local String is targetC: self:generateExpression(expr: stmt:assignTarget);
				local String is valC: self:generateExpression(expr: stmt:assignValue);
				return "    " . targetC . " = " . valC . ";\n";
			}
			is "IF": {
				local String is condC: self:generateExpression(expr: stmt:ifCondition);
				local String is out: "    if (" . condC . ") {\n";
				stmt:thenBranch:each(action: local Function(Statement is s){
					out: out . "    " . self:generateStatement(stmt: s);
				});
				if (stmt:hasElse) {
					out: out . "    } else {\n";
					stmt:elseBranch:each(action: local Function(Statement is s){
						out: out . "    " . self:generateStatement(stmt: s);
					});
				}
				out: out . "    }\n";
				return out;
			}
			is "RETURN": {
				if (stmt:hasReturnExpr) {
					local String is retC: self:generateExpression(expr: stmt:returnExpr);
					return "    return " . retC . ";\n";
				}
				return "    return;\n";
			}
			is "EXPR": {
				local String is exprC: self:generateExpression(expr: stmt:exprStmt);
				return "    " . exprC . ";\n";
			}
			else: {
				return "";
			}
		}
	}

	## Generates C code for a method definition.
	##
	## @param classDef: Enclosing [Class] definition.
	## @param method: Method [Member] descriptor.
	## @return: C method implementation string.
	replace local Function of String is generateMethod(Class is classDef, Member is method){
		local String is retType: self:resolveReturnType(t: method:getType());

		local String is out: retType . " " . classDef:getName() . "_" . method:getName() . "(" . classDef:getName() . "* self";
		method:getParameters():each(action: local Function(Parameter is p){
			out: out . ", " . self:cTypeFor(typeName: p:getType():getName()) . " " . p:getName();
		});
		out: out . ") {\n";

		method:getBody():each(action: local Function(Statement is stmt){
			out: out . self:generateStatement(stmt: stmt);
		});

		out: out . "}\n\n";
		return out;
	}

	## Generates the C `main` function entry point.
	##
	## @param entryClass: Application entry point class name.
	## @return: C main function text.
	replace local Function of String is generateMain(String is entryClass){
		local String is m: "/* Application Entry Point */\n";
		m: m . "int main(int argc, char** argv) {\n";
		m: m . "    srand((unsigned int)time(NULL));\n";
		m: m . "    SpecMap* args = spec_map_new();\n";
		m: m . "    for (int i = 1; i < argc; i++) {\n";
		m: m . "        if (strncmp(argv[i], \"--\", 2) == 0) {\n";
		m: m . "            const char* key = argv[i] + 2;\n";
		m: m . "            const char* val = \"true\";\n";
		m: m . "            if (i + 1 < argc && argv[i + 1][0] != '-') {\n";
		m: m . "                val = argv[++i];\n";
		m: m . "            }\n";
		m: m . "            spec_map_set(args, key, val);\n";
		m: m . "        } else if (argv[i][0] == '-' && argv[i][1] != '\\0') {\n";
		m: m . "            const char* key = argv[i] + 1;\n";
		m: m . "            const char* val = \"true\";\n";
		m: m . "            if (i + 1 < argc && argv[i + 1][0] != '-') {\n";
		m: m . "                val = argv[++i];\n";
		m: m . "            }\n";
		m: m . "            spec_map_set(args, key, val);\n";
		m: m . "        }\n";
		m: m . "    }\n";
		m: m . "    " . entryClass . "* app = " . entryClass . "_new();\n";
		m: m . "    " . entryClass . "_init(app, args);\n";
		m: m . "    return 0;\n";
		m: m . "}\n";
		return m;
	}

	## Translates a complete parsed program AST into a standalone C11 translation unit.
	##
	## @param program: Parsed [ProgramNode] AST.
	## @param entryClass: Application entry point class name.
	## @return: Complete C11 source code string.
	replace local Function of String is generateProgram(ProgramNode is program, String is entryClass){
		local String is cSource: "";
		cSource: cSource . self:generatePrelude();
		cSource: cSource . self:generateForwardDeclarations(classes: program:getClasses());
		cSource: cSource . self:generateStructs(classes: program:getClasses());
		cSource: cSource . self:generateConstructors(classes: program:getClasses());

		program:getClasses():each(action: local Function(Class is c){
			self:currentClassName: c:getName();
			c:getMembers():each(action: local Function(Member is m){
				when (m:getMemberKind()) {
					is METHOD: {
						cSource: cSource . self:generateMethod(classDef: c, method: m);
					}
					else: {}
				}
			});
		});

		cSource: cSource . self:generateMain(entryClass: entryClass);
		return cSource;
	}

}
