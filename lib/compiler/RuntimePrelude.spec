		p: p . "        v->items = (void**)realloc(v->items, sizeof(void*) * v->capacity);\n";
		p: p . "    }\n";
		p: p . "    if (v->elem_kind == 1 && item) spec_retain(item);\n";
		p: p . "    v->items[v->length++] = item;\n";
		p: p . "}\n\n";
		p: p . "void spec_vec_report(SpecClosure* error, const char* msg) {\n";
		p: p . "    spec_call_closure_str(error ? error : spec_noop_closure(), spec_string_from_bytes(msg, strlen(msg)));\n";
		p: p . "}\n\n";
		p: p . "void* spec_vec_get(SpecVec* v, long long idx, void* def, SpecClosure* error) {\n";
		p: p . "    if (!v) { spec_vec_report(error, \"vector is uninitialized\"); return def; }\n";
		p: p . "    if (idx < 0 || (size_t)idx >= v->length) {\n";
		p: p . "        char msg[96];\n";
		p: p . "        snprintf(msg, sizeof(msg), \"vector index out of bounds: index %lld for length %zu\", idx, v->length);\n";
		p: p . "        spec_vec_report(error, msg);\n";
		p: p . "        return def;\n";
		p: p . "    }\n";
		p: p . "    void* val = v->items[idx];\n";
		p: p . "    return val;\n";
		p: p . "}\n\n";
		p: p . "void spec_vec_set(SpecVec* v, long long idx, void* item, SpecClosure* error) {\n";
		p: p . "    if (!v) { spec_vec_report(error, \"vector is uninitialized\"); return; }\n";
		p: p . "    if (idx < 0 || (size_t)idx >= v->length) {\n";
		p: p . "        char msg[96];\n";
		p: p . "        snprintf(msg, sizeof(msg), \"vector assignment out of bounds: index %lld for length %zu\", idx, v->length);\n";
		p: p . "        spec_vec_report(error, msg);\n";
		p: p . "        return;\n";
		p: p . "    }\n";
		p: p . "    if (v->elem_kind == 1) {\n";
		p: p . "        if (item) spec_retain(item);\n";
		p: p . "        if (v->items[idx]) spec_release(v->items[idx]);\n";
		p: p . "    }\n";
		p: p . "    v->items[idx] = item;\n";
		p: p . "}\n\n";
		p: p . "void* spec_vec_pop(SpecVec* v, void* def, SpecClosure* error) {\n";
		p: p . "    if (!v) { spec_vec_report(error, \"vector is uninitialized\"); return def; }\n";
		p: p . "    if (v->length == 0) {\n";
		p: p . "        spec_vec_report(error, \"vector pop on empty vector\");\n";
		p: p . "        return def;\n";
		p: p . "    }\n";
		p: p . "    return v->items[--v->length];\n";
		p: p . "}\n\n";
		p: p . "long long spec_vec_length(SpecVec* v) {\n";
		p: p . "    return v ? (long long)v->length : 0;\n";
		p: p . "}\n\n";
		p: p . "void spec_vec_clear(SpecVec* v) {\n";
		p: p . "    if (!v) return;\n";
		p: p . "    for (size_t i = 0; i < v->length; i++) {\n";
		p: p . "        if (!v->items[i]) continue;\n";
		p: p . "        if (v->elem_kind == 1) spec_release(v->items[i]);\n";
		p: p . "    }\n";
		p: p . "    v->length = 0;\n";
		p: p . "}\n\n";
		p: p . "typedef struct {\n";
		p: p . "    String path;\n";
		p: p . "    String content;\n";
		p: p . "    String def;\n";
		p: p . "    SpecClosure* on_success_read;\n";
		p: p . "    SpecClosure* on_success_write;\n";
		p: p . "    SpecClosure* on_error;\n";
		p: p . "} SpecFileTask;\n\n";
		p: p . "String spec_file_read(String path, String def, SpecClosure* on_success, SpecClosure* on_error) {\n";
		p: p . "    if (!path || path->length == 0) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, spec_string_intern(\"File error: Empty or invalid file path provided\"));\n";
		p: p . "        return def ? def : spec_string_intern(\"\");\n";
		p: p . "    }\n";
		p: p . "    const char* pc = spec_buf_to_cstring((SpecBuf*)path);\n";
		p: p . "    FILE* f = fopen(pc, \"rb\");\n";
		p: p . "    if (!f) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));\n";
		p: p . "        return def ? def : spec_string_intern(\"\");\n";
		p: p . "    }\n";
		p: p . "    if (fseek(f, 0, SEEK_END) != 0) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));\n";
		p: p . "        return def ? def : spec_string_intern(\"\");\n";
		p: p . "    }\n";
		p: p . "    long size = ftell(f);\n";
		p: p . "    if (size < 0) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));\n";
		p: p . "        return def ? def : spec_string_intern(\"\");\n";
		p: p . "    }\n";
		p: p . "    fseek(f, 0, SEEK_SET);\n";
		p: p . "    char* buf = (char*)malloc((size_t)size + 1);\n";
		p: p . "    if (!buf) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, spec_string_intern(\"File error: Memory allocation failed during read\"));\n";
		p: p . "        return def ? def : spec_string_intern(\"\");\n";
		p: p . "    }\n";
		p: p . "    size_t read_bytes = fread(buf, 1, size, f);\n";
		p: p . "    fclose(f);\n";
		p: p . "    String out = spec_string_from_bytes(buf, read_bytes);\n";
		p: p . "    free(buf);\n";
		p: p . "    if (on_success) spec_call_closure_str(on_success, out);\n";
		p: p . "    return out;\n";
		p: p . "}\n";
		p: p . "bool spec_file_write(String path, String content, SpecClosure* on_success, SpecClosure* on_error) {\n";
		p: p . "    if (!path || path->length == 0) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, spec_string_intern(\"File error: Empty or invalid file path provided\"));\n";
		p: p . "        return false;\n";
		p: p . "    }\n";
		p: p . "    const char* pc = spec_buf_to_cstring((SpecBuf*)path);\n";
		p: p . "    const char* cc = content ? spec_buf_to_cstring((SpecBuf*)content) : \"\";\n";
		p: p . "    FILE* f = fopen(pc, \"wb\");\n";
		p: p . "    if (!f) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));\n";
		p: p . "        return false;\n";
		p: p . "    }\n";
		p: p . "    size_t len = strlen(cc);\n";
		p: p . "    size_t written = fwrite(cc, 1, len, f);\n";
		p: p . "    fclose(f);\n";
		p: p . "    if (written != len) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));\n";
		p: p . "        return false;\n";
		p: p . "    }\n";
		p: p . "    if (on_success) spec_call_closure_int(on_success, (long long)written);\n";
		p: p . "    return true;\n";
		p: p . "}\n";
		p: p . "static void* spec_file_read_worker(void* arg) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)arg;\n";
		p: p . "    spec_file_read(task->path, task->def, task->on_success_read, task->on_error);\n";
		p: p . "    if (task->path) spec_release(task->path);\n";
		p: p . "    if (task->def) spec_release(task->def);\n";
		p: p . "    if (task->on_success_read) spec_release(task->on_success_read);\n";
		p: p . "    if (task->on_error) spec_release(task->on_error);\n";
		p: p . "    free(task);\n";
		p: p . "    spec_async_task_finished();\n";
		p: p . "    return NULL;\n";
		p: p . "}\n\n";
		p: p . "void spec_file_read_async(String path, String def, SpecClosure* on_success, SpecClosure* on_error) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)calloc(1, sizeof(SpecFileTask));\n";
		p: p . "    task->path = path ? (String)spec_retain((void*)path) : NULL;\n";
		p: p . "    task->def = def ? (String)spec_retain((void*)def) : NULL;\n";
		p: p . "    task->on_success_read = (SpecClosure*)spec_retain(on_success);\n";
		p: p . "    task->on_error = (SpecClosure*)spec_retain(on_error);\n";
		p: p . "    spec_async_task_started();\n";
		p: p . "    pthread_t tid;\n";
		p: p . "    pthread_create(&tid, NULL, spec_file_read_worker, task);\n";
		p: p . "    pthread_detach(tid);\n";
		p: p . "}\n\n";
		p: p . "static void* spec_file_write_worker(void* arg) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)arg;\n";
		p: p . "    spec_file_write(task->path, task->content, task->on_success_write, task->on_error);\n";
		p: p . "    if (task->path) spec_release(task->path);\n";
		p: p . "    if (task->content) spec_release(task->content);\n";
		p: p . "    if (task->on_success_write) spec_release(task->on_success_write);\n";
		p: p . "    if (task->on_error) spec_release(task->on_error);\n";
		p: p . "    free(task);\n";
		p: p . "    spec_async_task_finished();\n";
		p: p . "    return NULL;\n";
		p: p . "}\n\n";
		p: p . "void spec_file_write_async(String path, String content, SpecClosure* on_success, SpecClosure* on_error) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)calloc(1, sizeof(SpecFileTask));\n";
		p: p . "    task->path = path ? (String)spec_retain((void*)path) : NULL;\n";
		p: p . "    task->content = content ? (String)spec_retain((void*)content) : NULL;\n";
		p: p . "    task->on_success_write = (SpecClosure*)spec_retain(on_success);\n";
		p: p . "    task->on_error = (SpecClosure*)spec_retain(on_error);\n";
		p: p . "    spec_async_task_started();\n";
		p: p . "    pthread_t tid;\n";
		p: p . "    pthread_create(&tid, NULL, spec_file_write_worker, task);\n";
		p: p . "    pthread_detach(tid);\n";
		p: p . "}\n\n";
		p: p . "bool spec_file_exists(String path) {\n";
		p: p . "    if (!path) return false;\n";
		p: p . "    FILE* f = fopen(spec_buf_to_cstring((SpecBuf*)path), \"r\");\n";
		p: p . "    if (f) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        return true;\n";
		p: p . "    }\n";
		p: p . "    return false;\n";
		p: p . "}\n";
		p: p . "bool spec_file_remove(String path) {\n";
		p: p . "    if (!path || path->length == 0) return false;\n";
		p: p . "    return remove(spec_buf_to_cstring((SpecBuf*)path)) == 0;\n";
		p: p . "}\n";
		p: p . "/* Process Package Primitives */\n";
		p: p . "long long spec_process_execute(String command, SpecArray* args) {\n";
		p: p . "    if (!command) return -1;\n";
		p: p . "    const char* cc = spec_buf_to_cstring((SpecBuf*)command);\n";
		p: p . "    size_t total_len = strlen(cc) + 1;\n";
		p: p . "    if (args) {\n";
		p: p . "        for (size_t i = 0; i < args->length; i++) {\n";
		p: p . "            if (args->items[i]) total_len += strlen(spec_buf_to_cstring((SpecBuf*)args->items[i])) + 4;\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "    char* cmd_line = (char*)malloc(total_len + 16);\n";
		p: p . "    strcpy(cmd_line, cc);\n";
		p: p . "    if (args) {\n";
		p: p . "        for (size_t i = 0; i < args->length; i++) {\n";
		p: p . "            if (!args->items[i]) continue;\n";
		p: p . "            strcat(cmd_line, \" \");\n";
		p: p . "            strcat(cmd_line, spec_buf_to_cstring((SpecBuf*)args->items[i]));\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "    int status = system(cmd_line);\n";
		p: p . "    free(cmd_line);\n";
		p: p . "    if (status == -1) return -1;\n";
		p: p . "    return (long long)WEXITSTATUS(status);\n";
		p: p . "}\n";
		p: p . "void spec_process_sleep(long long ms) {\n";
		p: p . "    if (ms <= 0) return;\n";
		p: p . "    struct timespec ts;\n";
		p: p . "    ts.tv_sec = ms / 1000;\n";
		p: p . "    ts.tv_nsec = (ms % 1000) * 1000000L;\n";
		p: p . "    nanosleep(&ts, NULL);\n";
		p: p . "}\n\n";
		p: p . "long long spec_process_get_pid(void) {\n";
		p: p . "    return (long long)getpid();\n";
		p: p . "}\n\n";
		p: p . "/* Math Package Primitives */\n";
		p: p . "double spec_math_round(double v) { return round(v); }\n";
		p: p . "double spec_math_floor(double v) { return floor(v); }\n";
		p: p . "double spec_math_ceil(double v) { return ceil(v); }\n";
		p: p . "double spec_math_abs(double v) { return fabs(v); }\n";
		p: p . "double spec_math_min(double a, double b) { return (a < b) ? a : b; }\n";
		p: p . "double spec_math_max(double a, double b) { return (a > b) ? a : b; }\n";
		p: p . "double spec_math_clamp(double v, double lo, double hi) {\n";
		p: p . "    if (hi < lo) return lo;\n";
		p: p . "    if (v < lo) return lo;\n";
		p: p . "    if (v > hi) return hi;\n";
		p: p . "    return v;\n";
		p: p . "}\n";
		p: p . "double spec_math_sqrt(double v) { return v < 0.0 ? 0.0 : sqrt(v); }\n";
		p: p . "double spec_math_sin(double v) { return sin(v); }\n";
		p: p . "double spec_math_cos(double v) { return cos(v); }\n";
		p: p . "double spec_math_tan(double v) { return tan(v); }\n";
		p: p . "double spec_math_atan2(double y, double x) { return atan2(y, x); }\n";
		p: p . "double spec_math_log(double v) { return v <= 0.0 ? 0.0 : log(v); }\n";
		p: p . "double spec_math_log2(double v) { return v <= 0.0 ? 0.0 : log2(v); }\n";
		p: p . "double spec_math_pow(double base, double exp) { return pow(base, exp); }\n";
		p: p . "long long spec_math_to_int(double v) { return (long long)v; }\n";
		p: p . "double spec_math_to_float(long long v) { return (double)v; }\n\n";
		p: p . "double spec_math_random(double min, double max) {\n";
		p: p . "    if (min >= max) return ((double)rand() / ((double)RAND_MAX + 1.0));\n";
		p: p . "    return min + ((double)rand() / ((double)RAND_MAX + 1.0)) * (max - min);\n";
		p: p . "}\n\n";
		p: p . "/* Integer Base Conversion */\n";
		p: p . "String spec_int_to_base(long long v, long long base, long long digits) {\n";
		p: p . "    if (base < 2 || base > 36) base = 10;\n";
		p: p . "    if (digits < 0) digits = 0;\n";
		p: p . "    const char* digs = \"0123456789abcdefghijklmnopqrstuvwxyz\";\n";
		p: p . "    char buf[80];\n";
		p: p . "    int idx = 79;\n";
		p: p . "    buf[idx] = '\\0';\n";
		p: p . "    int neg = v < 0;\n";
		p: p . "    unsigned long long u = neg ? (unsigned long long)(-(v + 1)) + 1ULL : (unsigned long long)v;\n";
		p: p . "    if (u == 0) buf[--idx] = '0';\n";
		p: p . "    while (u > 0) { buf[--idx] = digs[u % (unsigned long long)base]; u /= (unsigned long long)base; }\n";
		p: p . "    while ((79 - idx) < (int)digits && idx > 0) buf[--idx] = '0';\n";
		p: p . "    if (neg && idx > 0) buf[--idx] = '-';\n";
		p: p . "    return spec_string_from_chars(buf + idx);\n";
		p: p . "}\n\n";
		p: p . "long long spec_parse_base(String str, long long base, long long def) {\n";
		p: p . "    if (!str || str->length == 0) return def;\n";
		p: p . "    const char* s = spec_buf_to_cstring((SpecBuf*)str);\n";
		p: p . "    int b = (int)base;\n";
		p: p . "    if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) { b = 16; s += 2; }\n";
		p: p . "    else if (s[0] == '0' && (s[1] == 'b' || s[1] == 'B')) { b = 2; s += 2; }\n";
		p: p . "    else if (s[0] == '0' && (s[1] == 'o' || s[1] == 'O')) { b = 8; s += 2; }\n";
		p: p . "    if (b < 2 || b > 36) return def;\n";
		p: p . "    int neg = 0;\n";
		p: p . "    if (*s == '-') { neg = 1; s++; }\n";
		p: p . "    if (!*s) return def;\n";
		p: p . "    unsigned long long v = 0;\n";
		p: p . "    int any = 0;\n";
		p: p . "    for (; *s; s++) {\n";
		p: p . "        if (*s == '_') continue;\n";
		p: p . "        int d;\n";
		p: p . "        if (*s >= '0' && *s <= '9') d = *s - '0';\n";
		p: p . "        else if (*s >= 'a' && *s <= 'z') d = *s - 'a' + 10;\n";
		p: p . "        else if (*s >= 'A' && *s <= 'Z') d = *s - 'A' + 10;\n";
		p: p . "        else return def;\n";
		p: p . "        if (d >= b) return def;\n";
		p: p . "        v = v * (unsigned long long)b + (unsigned long long)d;\n";
		p: p . "        any = 1;\n";
		p: p . "    }\n";
		p: p . "    if (!any) return def;\n";
		p: p . "    return neg ? -(long long)v : (long long)v;\n";
		p: p . "}\n";
		p: p . "\n";
		p: p . "/* Terminal Metrics */\n";
		p: p . "long long spec_term_width(void) {\n";
		p: p . "    if (!isatty(1)) return 0;\n";
		p: p . "    struct winsize ws;\n";
		p: p . "    if (ioctl(1, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0) return (long long)ws.ws_col;\n";
		p: p . "    char* cols = getenv(\"COLUMNS\");\n";
		p: p . "    if (cols) return (long long)atoi(cols);\n";
		p: p . "    return 78;\n";
		p: p . "}\n\n";
		p: p . "long long spec_term_height(void) {\n";
		p: p . "    if (!isatty(1)) return 0;\n";
		p: p . "    struct winsize ws;\n";
		p: p . "    if (ioctl(1, TIOCGWINSZ, &ws) == 0 && ws.ws_row > 0) return (long long)ws.ws_row;\n";
		p: p . "    char* lines = getenv(\"LINES\");\n";
		p: p . "    if (lines) return (long long)atoi(lines);\n";
		p: p . "    return 24;\n";
		p: p . "}\n\n";
		p: p . "/* Atomic Slots */\n";
		p: p . "static atomic_llong _spec_atomic_slots[64];\n\n";
		p: p . "long long spec_atomic_add(long long slot, long long v) {\n";
		p: p . "    if (slot < 0 || slot >= 64) return 0;\n";
		p: p . "    return atomic_fetch_add(&_spec_atomic_slots[slot], v) + v;\n";
		p: p . "}\n\n";
		p: p . "long long spec_atomic_put(long long slot, long long v) {\n";
		p: p . "    if (slot < 0 || slot >= 64) return v;\n";
		p: p . "    atomic_store(&_spec_atomic_slots[slot], v);\n";
		p: p . "    return v;\n";
		p: p . "}\n\n";
		p: p . "long long spec_atomic_get(long long slot) {\n";
		p: p . "    if (slot < 0 || slot >= 64) return 0;\n";
		p: p . "    return atomic_load(&_spec_atomic_slots[slot]);\n";
		p: p . "}\n\n";
		p: p . "/* Per-Thread RNG (xorshift64*, lock-free, self-seeding) */\n";
		p: p . "static __thread unsigned long long _spec_rng_state = 0;\n\n";
		p: p . "static unsigned long long spec_rng_next(void) {\n";
		p: p . "    unsigned long long x = _spec_rng_state;\n";
		p: p . "    x ^= x >> 12;\n";
		p: p . "    x ^= x << 25;\n";
		p: p . "    x ^= x >> 27;\n";
		p: p . "    _spec_rng_state = x;\n";
		p: p . "    return x * 0x2545F4914F6CDD1DULL;\n";
		p: p . "}\n\n";
		p: p . "void spec_fast_random_seed(long long idx) {\n";
		p: p . "    _spec_rng_state = 0x9E3779B97F4A7C15ULL ^ ((unsigned long long)idx * 0xBF58476D1CE4E5B9ULL + 0x94D049BB133111EBULL);\n";
		p: p . "    if (_spec_rng_state == 0) _spec_rng_state = 1;\n";
		p: p . "    spec_rng_next();\n";
		p: p . "    spec_rng_next();\n";
		p: p . "    spec_rng_next();\n";
		p: p . "}\n\n";
		p: p . "double spec_fast_random(void) {\n";
		p: p . "    if (_spec_rng_state == 0) spec_fast_random_seed(0x5DEECE66DULL);\n";
		p: p . "    return (double)(spec_rng_next() >> 11) * (1.0 / 9007199254740992.0);\n";
		p: p . "}\n\n";
		p: p . "/* Parallel Fan-Out */\n";
		p: p . "typedef long long (*SpecWorkerFn)(void* env, long long idx, long long count);\n";
		p: p . "typedef struct { SpecWorkerFn fn; void* env; long long idx; long long count; } SpecParallelTask;\n\n";
		p: p . "static void* spec_parallel_worker(void* arg) {\n";
		p: p . "    SpecParallelTask* t = (SpecParallelTask*)arg;\n";
		p: p . "    spec_fast_random_seed(t->idx);\n";
		p: p . "    long long r = t->fn(t->env, t->idx, t->count);\n";
		p: p . "    free(t);\n";
		p: p . "    return (void*)(intptr_t)r;\n";
		p: p . "}\n\n";
		p: p . "long long spec_parallel_run(long long threads, long long iterations, void* worker_closure) {\n";
		p: p . "    if (threads < 1) threads = 1;\n";
		p: p . "    if (threads > 64) threads = 64;\n";
		p: p . "    SpecClosure* cls = (SpecClosure*)worker_closure;\n";
		p: p . "    if (!cls || !cls->fn) spec_panic(\"Parallel:run received null worker Function\");\n";
		p: p . "    pthread_t tids[64];\n";
		p: p . "    long long total = 0;\n";
		p: p . "    long long base = iterations / threads;\n";
		p: p . "    long long rem = iterations % threads;\n";
		p: p . "    for (long long i = 0; i < threads; i++) {\n";
		p: p . "        SpecParallelTask* t = (SpecParallelTask*)malloc(sizeof(SpecParallelTask));\n";
		p: p . "        t->fn = (SpecWorkerFn)cls->fn;\n";
		p: p . "        t->env = cls->env;\n";
		p: p . "        t->idx = i;\n";
		p: p . "        t->count = base + (i < rem ? 1 : 0);\n";
		p: p . "        if (pthread_create(&tids[i], NULL, spec_parallel_worker, t) != 0) {\n";
		p: p . "            free(t);\n";
		p: p . "            tids[i] = pthread_self();\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "    for (long long i = 0; i < threads; i++) {\n";
		p: p . "        void* ret = NULL;\n";
		p: p . "        pthread_join(tids[i], &ret);\n";
		p: p . "        total += (long long)(intptr_t)ret;\n";
		p: p . "    }\n";
		p: p . "    return total;\n";
		p: p . "}\n\n";
		p: p . "/* Type Name Introspection */\n";
		p: p . "String spec_type_name(const void* obj) {\n";
		p: p . "    if (!obj) return spec_string_intern(\"\");\n";
		p: p . "    return spec_string_intern(*((const char**)obj));\n";
		p: p . "}\n\n";
		p: p . "/* Clock & Memory Metrics */\n";
		p: p . "long long spec_clock_ms(void) {\n";
		p: p . "    struct timespec ts;\n";
		p: p . "    clock_gettime(CLOCK_MONOTONIC, &ts);\n";
		p: p . "    return ((long long)ts.tv_sec * 1000) + (ts.tv_nsec / 1000000);\n";
		p: p . "}\n\n";
		p: p . "long long spec_mem_peak_kb(void) {\n";
		p: p . "    struct rusage ru;\n";
		p: p . "    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0;\n";
		p: p . "    return (long long)ru.ru_maxrss;\n";
		p: p . "}\n\n";
		p: p . "long long spec_thread_count(void) {\n";
		p: p . "    FILE* f = fopen(\"/proc/self/status\", \"r\");\n";
		p: p . "    if (!f) return 1;\n";
		p: p . "    char line[256];\n";
		p: p . "    long long n = 1;\n";
		p: p . "    while (fgets(line, sizeof(line), f)) {\n";
		p: p . "        if (strncmp(line, \"Threads:\", 8) == 0) { n = atoll(line + 8); break; }\n";
		p: p . "    }\n";
		p: p . "    fclose(f);\n";
		p: p . "    return n;\n";
		p: p . "}\n\n";
		p: p . "/* Error Output Primitive */\n";
		p: p . "void spec_error_line(String s) {\n";
		p: p . "    const char* cs = s ? spec_buf_to_cstring((SpecBuf*)s) : \"\";\n";
		p: p . "    fprintf(stderr, \"%s\\n\", cs);\n";
		p: p . "}\n";
		return p;
	}

}
