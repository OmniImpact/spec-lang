#! Package compiler
#! C11 standard runtime prelude for Pure-Spec generated binaries.

## Emits standard C11 runtime definitions including string, array, map, file, and task primitives.
Class is RuntimePrelude{

	replace Array of String is using: [
		base:struct:Array,
		base:struct:Map,
		base:iterator:*
	];

	## Garbage collection mode: "" (default ARC) or "boehm"
	local String is gcMode: '';

	replace Function is init(){
		self:gcMode: '';
	}

	Function is setGcMode(String is mode){
		self:gcMode: mode;
	}

	## Emits the complete Spec C11 runtime prelude.
	##
	## @return: C source code string defining the Spec runtime library.
	Function of String is emitRuntime(){
		local String is p: '';
		p: p . "/* Generated by Pure-Spec Compiler */\n";
		p: p . "#define _POSIX_C_SOURCE 200809L\n";
		p: p . "#include <stdio.h>\n";
		p: p . "#include <stdlib.h>\n";
		p: p . "#include <string.h>\n";
		p: p . "#include <stdbool.h>\n";
		p: p . "#include <stdint.h>\n";
		p: p . "#include <ctype.h>\n";
		p: p . "#include <time.h>\n";
		p: p . "#include <errno.h>\n";
		p: p . "#include <math.h>\n";
		p: p . "#include <unistd.h>\n";
		p: p . "/* Forward declarations: SpecBuf-backed String layer (definitions below) */\n";
		p: p . "typedef struct SpecBuf SpecBuf;\n";
		p: p . "typedef SpecBuf* String;\n";
		p: p . "typedef struct SpecClosure SpecClosure;\n";
		p: p . "SpecBuf* spec_buf_new(size_t elem_size, int elem_kind);\n";
		p: p . "void spec_buf_append_bytes(SpecBuf* b, const char* s);\n";
		p: p . "void spec_buf_append_buf(SpecBuf* dst, SpecBuf* src);\n";
		p: p . "const char* spec_buf_to_cstring(SpecBuf* b);\n";
		p: p . "long long spec_buf_get_byte(SpecBuf* b, long long idx, long long def, SpecClosure* error);\n";
		p: p . "String spec_string_from_bytes(const char* data, size_t n);\n";
		p: p . "String spec_string_copy(String b);\n";
		p: p . "bool spec_string_bytes_equal(String b, const char* c, size_t n);\n";
		p: p . "long long spec_string_length(String b);\n";
		p: p . "bool spec_string_equals(String a, String b);\n";
		p: p . "String spec_string_concat(String a, String b);\n";
		p: p . "String spec_string_substring(String b, long long start, long long end);\n";
		p: p . "long long spec_string_index_of(String b, String needle, long long def);\n";
		p: p . "long long spec_string_index_of_from(String b, String needle, long long from, long long def);\n";
		p: p . "String spec_string_trim(String b);\n";
		p: p . "bool spec_string_has_prefix(String b, String prefix);\n";
		p: p . "bool spec_string_has_suffix(String b, String suffix);\n";
		p: p . "#include <pthread.h>\n";
		p: p . "#include <sys/wait.h>\n";
		p: p . "#include <sys/ioctl.h>\n";
		p: p . "#include <sys/resource.h>\n";
		p: p . "#include <stdatomic.h>\n\n";

		if (self:gcMode == 'boehm') {
			p: p . "/* Boehm GC Integration */\n";
			p: p . "#define SPEC_GC_BOEHM 1\n";
			p: p . "extern void GC_init(void);\n";
			p: p . "extern void* GC_malloc(size_t size);\n";
			p: p . "extern void* GC_malloc_atomic(size_t size);\n";
			p: p . "extern void* GC_realloc(void* ptr, size_t size);\n";
			p: p . "extern void GC_free(void* ptr);\n";
			p: p . "extern int GC_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*start_routine)(void*), void* arg);\n\n";
			p: p . "static inline char* spec_gc_strdup(const char* s) {\n";
			p: p . "    if (!s) return NULL;\n";
			p: p . "    size_t len = strlen(s);\n";
			p: p . "    char* copy = (char*)GC_malloc_atomic(len + 1);\n";
			p: p . "    if (copy) memcpy(copy, s, len + 1);\n";
			p: p . "    return copy;\n";
			p: p . "}\n\n";
			p: p . "#define malloc(sz) GC_malloc(sz)\n";
			p: p . "#define calloc(n, sz) GC_malloc((n) * (sz))\n";
			p: p . "#define realloc(ptr, sz) GC_realloc(ptr, sz)\n";
			p: p . "#define strdup(s) spec_gc_strdup(s)\n";
			p: p . "#define free(ptr) ((void)(ptr))\n";
			p: p . "#define pthread_create(t, a, fn, arg) GC_pthread_create(t, a, fn, arg)\n\n";
		}

		p: p . "/* Spec Runtime Panic & Safety Utilities */\n";
		p: p . "void spec_panic(const char* msg) {\n";
		p: p . "    fprintf(stderr, \"[Spec Runtime Panic] %s\\n\", msg ? msg : \"fatal error\");\n";
		p: p . "    exit(1);\n";
		p: p . "}\n\n";
		p: p . "void spec_panic_bounds(const char* coll, long long idx, size_t len) {\n";
		p: p . "    fprintf(stderr, \"[Spec Runtime Panic] %s index out of bounds: index %lld for length %zu\\n\", coll ? coll : \"Collection\", idx, len);\n";
		p: p . "    exit(1);\n";
		p: p . "}\n\n";
		p: p . "void spec_panic_cast(const char* actual, const char* target) {\n";
		p: p . "    fprintf(stderr, \"[Spec Runtime Panic] Invalid downcast: instance of '%s' cannot be cast to '%s'\\n\", actual ? actual : \"Unknown\", target ? target : \"Unknown\");\n";
		p: p . "    exit(1);\n";
		p: p . "}\n\n";
		p: p . "void spec_panic_byte_range(long long v) {\n";
		p: p . "    fprintf(stderr, \"[Spec Runtime Panic] Byte cast out of range: %lld (must be 0..255)\\n\", v);\n";
		p: p . "    exit(1);\n";
		p: p . "}\n\n";
		p: p . "static bool spec_is_subclass_of(const char* actual, const char* target);\n\n";
		p: p . "static inline void* spec_cast_check(const void* obj, const char* target) {\n";
		p: p . "    if (!obj) return NULL;\n";
		p: p . "    const char* actual = *((const char**)obj);\n";
		p: p . "    if (!spec_is_subclass_of(actual, target)) {\n";
		p: p . "        spec_panic_cast(actual, target);\n";
		p: p . "    }\n";
		p: p . "    return (void*)obj;\n";
		p: p . "}\n\n";

		p: p . "/* Spec Automated Reference Counting (ARC) Primitives */\n";
		p: p . "#define SPEC_S_IMMORTAL 1u\n";
		p: p . "#define SPEC_S_HASLEN 2u\n";
		p: p . "typedef struct {\n";
		p: p . "    _Atomic uint32_t ref_count;\n";
		p: p . "    void (*destroy)(void*);\n";
		p: p . "    _Atomic uint32_t sflags;\n";
		p: p . "    uint32_t slen;\n";
		p: p . "} SpecHeader;\n\n";
		p: p . "#define SPEC_HEADER(obj) (((SpecHeader*)(obj)) - 1)\n\n";

		p: p . "/* ============ RC DEBUG LEDGER (SPEC_RC_DEBUG=1) ============ */\n";
		p: p . "static int _spec_rc_debug = -1;\n";
		p: p . "static inline int spec_rc_debug_on(void) {\n";
		p: p . "    if (_spec_rc_debug < 0) { _spec_rc_debug = getenv(\"SPEC_RC_DEBUG\") ? 1 : 0; }\n";
		p: p . "    return _spec_rc_debug;\n";
		p: p . "}\n\n";
		p: p . "#define SPEC_RC_SLOTS (1 << 21)\n";
		p: p . "#define SPEC_RC_HIST 4\n";
		p: p . "typedef struct {\n";
		p: p . "    void* ptr;\n";
		p: p . "    long long count;\n";
		p: p . "    unsigned long sites[SPEC_RC_HIST];\n";
		p: p . "    int kinds[SPEC_RC_HIST];\n";
		p: p . "    int head;\n";
		p: p . "} SpecRcEntry;\n";
		p: p . "static SpecRcEntry _spec_rc_table[SPEC_RC_SLOTS];\n\n";
		p: p . "static SpecRcEntry* spec_rc_slot(void* p) {\n";
		p: p . "    size_t h = ((size_t)p >> 4) * 2654435761ULL;\n";
		p: p . "    size_t i = h & (SPEC_RC_SLOTS - 1);\n";
		p: p . "    for (;;) {\n";
		p: p . "        SpecRcEntry* e = &_spec_rc_table[i];\n";
		p: p . "        if (e->ptr == p || e->ptr == NULL) return e;\n";
		p: p . "        i = (i + 1) & (SPEC_RC_SLOTS - 1);\n";
		p: p . "    }\n";
		p: p . "}\n\n";
		p: p . "static void spec_rc_record(void* p, int kind, unsigned long ra) {\n";
		p: p . "    SpecRcEntry* e = spec_rc_slot(p);\n";
		p: p . "    if (e->ptr != p) { e->ptr = p; e->count = 0; e->head = 0; }\n";
		p: p . "    e->sites[e->head] = ra;\n";
		p: p . "    e->kinds[e->head] = kind;\n";
		p: p . "    e->head = (e->head + 1) % SPEC_RC_HIST;\n";
		p: p . "    return;\n";
		p: p . "}\n\n";
		p: p . "static void spec_rc_fail(void* p, const char* what, const char* op, unsigned long ra) {\n";
		p: p . "    SpecRcEntry* e = spec_rc_slot(p);\n";
		p: p . "    fprintf(stderr, \"[RC-DEBUG] %s: %s at 0x%lx (tracked count %lld) ra1=0x%lx ra2=0x%lx\\n\", what, op, (unsigned long)p, e->count, __builtin_return_address(1), __builtin_return_address(2));\n";
		p: p . "    for (int i = 0; i < SPEC_RC_HIST; i++) {\n";
		p: p . "        int idx = (e->head + i) % SPEC_RC_HIST;\n";
		p: p . "        if (e->sites[idx] == 0) continue;\n";
		p: p . "        const char* kname = e->kinds[idx] == 1 ? \"alloc\" : e->kinds[idx] == 2 ? \"retain\" : e->kinds[idx] == 3 ? \"release\" : \"realloc\";\n";
		p: p . "        fprintf(stderr, \"    %s 0x%lx\\n\", kname, e->sites[idx]);\n";
		p: p . "    }\n";
		p: p . "    unsigned char* hb = (unsigned char*)((char*)p - sizeof(SpecHeader));\n";
		p: p . "    fprintf(stderr, \"[RC-DEBUG] header bytes: \");\n";
		p: p . "    for (int i = 0; i < sizeof(SpecHeader) + 32; i++) fprintf(stderr, \"%02x\", hb[i]);\n";
		p: p . "    fprintf(stderr, \"\\n[RC-DEBUG] header text: '%s' | '%s'\\n\", (char*)p - sizeof(SpecHeader) + 8, (char*)p);\n";
		p: p . "    fprintf(stderr, \"[RC-DEBUG] map addresses with: addr2line -e <binary> <addresses>\\n\");\n";
		p: p . "    abort();\n";
		p: p . "}\n\n";
		p: p . "static void* spec_rc_alloc(void* p, unsigned long ra) {\n";
		p: p . "    SpecRcEntry* e = spec_rc_slot(p);\n";
		p: p . "    if (e->ptr == p && e->count > 0) { spec_rc_fail(p, \"alloc of live pointer\", \"alloc\", ra); }\n";
		p: p . "    spec_rc_record(p, 1, ra);\n";
		p: p . "    SpecRcEntry* e2 = spec_rc_slot(p);\n";
		p: p . "    e2->count = 1;\n";
		p: p . "    return p;\n";
		p: p . "}\n\n";
		p: p . "static void spec_rc_released_check(void* p, unsigned long ra) {\n";
		p: p . "    SpecRcEntry* e = spec_rc_slot(p);\n";
		p: p . "    SpecHeader* h = SPEC_HEADER(p);\n";
		p: p . "    long long real = (long long)atomic_load_explicit(&h->ref_count, memory_order_relaxed);\n";
		p: p . "    if (e->ptr != p) { spec_rc_fail(p, \"operation on never-tracked pointer\", \"release\", ra); }\n";
		p: p . "    if (e->count != real) { fprintf(stderr, \"[RC-DEBUG] ledger divergence: tracked %lld but ref_count %lld at %p\\n\", e->count, real, p); }\n";
		p: p . "    if (real <= 0) { spec_rc_fail(p, \"operation on freed pointer\", \"release\", ra); }\n";
		p: p . "    return;\n";
		p: p . "}\n\n";
		p: p . "static inline void* spec_alloc(size_t size, void (*destroy)(void*)) {\n";
		p: p . "    SpecHeader* h = (SpecHeader*)calloc(1, sizeof(SpecHeader) + size);\n";
		p: p . "    if (!h) { fprintf(stderr, \"[Spec Panic] Out of memory\\n\"); exit(1); }\n";
		p: p . "    h->ref_count = 1;\n";
		p: p . "    h->destroy = destroy;\n";
		p: p . "    if (spec_rc_debug_on()) spec_rc_alloc((void*)(h + 1), (unsigned long)__builtin_return_address(0));\n";
		p: p . "    return (void*)(h + 1);\n";
		p: p . "}\n\n";
		p: p . "static inline void* spec_retain(void* obj) {\n";
		p: p . "    if (!obj) return NULL;\n";
		p: p . "    if (spec_rc_debug_on()) { spec_rc_released_check(obj, (unsigned long)__builtin_return_address(0)); }\n";
		p: p . "    SpecHeader* h = SPEC_HEADER(obj);\n";
		p: p . "    if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_IMMORTAL) return obj;\n";
		p: p . "    atomic_fetch_add_explicit(&h->ref_count, 1, memory_order_relaxed);\n";
		p: p . "    return obj;\n";
		p: p . "}\n\n";
		p: p . "static inline void spec_release(void* obj) {\n";
		p: p . "    if (!obj) return;\n";
		p: p . "    if (spec_rc_debug_on()) { spec_rc_released_check(obj, (unsigned long)__builtin_return_address(0)); }\n";
		p: p . "    SpecHeader* h = SPEC_HEADER(obj);\n";
		p: p . "    if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_IMMORTAL) return;\n";
		p: p . "    if (spec_rc_debug_on()) {\n";
		p: p . "        SpecRcEntry* e = spec_rc_slot(obj);\n";
		p: p . "        spec_rc_record(obj, 3, (unsigned long)__builtin_return_address(0));\n";
		p: p . "        e->count--;\n";
		p: p . "        if (e->count == 0) { e->ptr = NULL; if (h->destroy) h->destroy(obj); return; }\n";
		p: p . "        if (e->count < 0) { spec_rc_fail(obj, \"over-release\", \"release\", (unsigned long)__builtin_return_address(0)); }\n";
		p: p . "        return;\n";
		p: p . "    }\n";
		p: p . "    if (atomic_fetch_sub_explicit(&h->ref_count, 1, memory_order_acq_rel) == 1) {\n";
		p: p . "        if (h->destroy) h->destroy(obj);\n";
		p: p . "        free(h);\n";
		p: p . "    }\n";
		p: p . "}\n\n";
		p: p . "static inline void* spec_assign(void** dest, void* src) {\n";
		p: p . "    if (src) spec_retain(src);\n";
		p: p . "    if (*dest) spec_release(*dest);\n";
		p: p . "    *dest = src;\n";
		p: p . "    return src;\n";
		p: p . "}\n\n";
		p: p . "static inline void* spec_assign_transfer(void** dest, void* src) {\n";
		p: p . "    if (*dest) spec_release(*dest);\n";
		p: p . "    *dest = src;\n";
		p: p . "    return src;\n";
		p: p . "}\n\n";
		p: p . "static inline void spec_scope_cleanup(void* pptr) {\n";
		p: p . "    void* obj = *(void**)pptr;\n";
		p: p . "    if (obj) spec_release(obj);\n";
		p: p . "}\n\n";
		p: p . "#define SPEC_AUTO __attribute__((cleanup(spec_scope_cleanup)))\n\n";
		p: p . "/* Spec String Core: refcounted, NUL-terminated, optionally interned.\n";
		p: p . "   A String value is a char* into a spec_alloc block whose header carries\n";
		p: p . "   a cached length and an immortal flag for interned literals. */\n";
		p: p . "String spec_string_from_chars(const char* c) {\n";
		p: p . "    if (!c) c = \"\";\n";
		p: p . "    return spec_string_from_bytes(c, strlen(c));\n";
		p: p . "}\n";
		p: p . "#define SPEC_INTERN_BUCKETS 256\n";
		p: p . "typedef struct SpecInternEntry {\n";
		p: p . "    String s;\n";
		p: p . "    struct SpecInternEntry* next;\n";
		p: p . "} SpecInternEntry;\n";
		p: p . "static SpecInternEntry* _spec_intern[SPEC_INTERN_BUCKETS];\n";
		p: p . "static pthread_mutex_t _spec_intern_lock = PTHREAD_MUTEX_INITIALIZER;\n\n";
		p: p . "static inline size_t spec_intern_bucket(const char* c) {\n";
		p: p . "    size_t h = 1469598103934665603ULL;\n";
		p: p . "    while (*c) { h ^= (unsigned char)(*c++); h *= 1099511628211ULL; }\n";
		p: p . "    return h & (SPEC_INTERN_BUCKETS - 1);\n";
		p: p . "}\n\n";
		p: p . "String spec_string_intern(const char* c) {\n";
		p: p . "    if (!c) c = \"\";\n";
		p: p . "    size_t b = spec_intern_bucket(c);\n";
		p: p . "    size_t n = strlen(c);\n";
		p: p . "    pthread_mutex_lock(&_spec_intern_lock);\n";
		p: p . "    SpecInternEntry* e = _spec_intern[b];\n";
		p: p . "    while (e) {\n";
		p: p . "        String es = (String)e->s;\n";
		p: p . "        if (spec_string_bytes_equal(es, c, n)) { pthread_mutex_unlock(&_spec_intern_lock); return es; }\n";
		p: p . "        e = e->next;\n";
		p: p . "    }\n";
		p: p . "    String s = spec_string_from_bytes(c, n);\n";
		p: p . "    atomic_fetch_or_explicit(&SPEC_HEADER(s)->sflags, SPEC_S_IMMORTAL, memory_order_relaxed);\n";
		p: p . "    e = (SpecInternEntry*)malloc(sizeof(SpecInternEntry));\n";
		p: p . "    e->s = s;\n";
		p: p . "    e->next = _spec_intern[b];\n";
		p: p . "    _spec_intern[b] = e;\n";
		p: p . "    pthread_mutex_unlock(&_spec_intern_lock);\n";
		p: p . "    return s;\n";
		p: p . "}\n";
		p: p . "/* Claim pool: adopts ownership claims in read positions (call arguments,\n";
		p: p . "   conditions, chain targets) and recycles them on eviction. A borrowed\n";
		p: p . "   pointer stays valid until 32 further pool claims are made, which is\n";
		p: p . "   far more than any single statement evaluates. */\n";
		p: p . "#define SPEC_POOL_SLOTS 32\n";
		p: p . "static void* _spec_pool[SPEC_POOL_SLOTS];\n";
		p: p . "static size_t _spec_pool_next = 0;\n";
		p: p . "static pthread_mutex_t _spec_pool_lock = PTHREAD_MUTEX_INITIALIZER;\n\n";
		p: p . "void* spec_claim_pool(void* obj) {\n";
		p: p . "    if (!obj) return NULL;\n";
		p: p . "    pthread_mutex_lock(&_spec_pool_lock);\n";
		p: p . "    size_t slot = _spec_pool_next;\n";
		p: p . "    _spec_pool_next = (slot + 1) % SPEC_POOL_SLOTS;\n";
		p: p . "    void* old = _spec_pool[slot];\n";
		p: p . "    _spec_pool[slot] = obj;\n";
		p: p . "    pthread_mutex_unlock(&_spec_pool_lock);\n";
		p: p . "    if (old) spec_release(old);\n";
		p: p . "    return obj;\n";
		p: p . "}\n\n";
		p: p . "/* Spec First-Class Closure Representation */\n";
		p: p . "typedef struct SpecClosure {\n";
		p: p . "    void* fn;\n";
		p: p . "    void* env;\n";
		p: p . "    void (*destroy_env)(void*);\n";
		p: p . "} SpecClosure;\n\n";
		p: p . "static inline void spec_closure_destroy(void* self) {\n";
		p: p . "    SpecClosure* c = (SpecClosure*)self;\n";
		p: p . "    if (c) {\n";
		p: p . "        if (c->env && c->destroy_env) {\n";
		p: p . "            c->destroy_env(c->env);\n";
		p: p . "            c->env = NULL;\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "}\n\n";
		p: p . "static inline SpecClosure* spec_closure_new(void* fn, void* env, void (*destroy_env)(void*)) {\n";
		p: p . "    SpecClosure* c = (SpecClosure*)spec_alloc(sizeof(SpecClosure), spec_closure_destroy);\n";
		p: p . "    c->fn = fn;\n";
		p: p . "    c->env = env;\n";
		p: p . "    c->destroy_env = destroy_env;\n";
		p: p . "    return c;\n";
		p: p . "}\n\n";

		p: p . "/* Spec Runtime String Utilities */\n";
p: p . "/* Spec Runtime String Utilities */\n";
		p: p . "static char _spec_small_ints[258][8];\n";
		p: p . "static bool _spec_small_ints_init = false;\n";
		p: p . "String spec_to_string_int(long long v) {\n";
		p: p . "    char buf[64];\n";
		p: p . "    snprintf(buf, sizeof(buf), \"%lld\", v);\n";
		p: p . "    return spec_string_intern(buf);\n";
		p: p . "}\n\n";
		p: p . "String spec_to_string_float(double v) {\n";
		p: p . "    char buf[64];\n";
		p: p . "    snprintf(buf, sizeof(buf), \"%g\", v);\n";
		p: p . "    return spec_string_intern(buf);\n";
		p: p . "}\n\n";
		p: p . "String spec_to_string_bool(bool v) {\n";
		p: p . "    return spec_string_intern(v ? \"true\" : \"false\");\n";
		p: p . "}\n\n";
		p: p . "String spec_string_char_at(String s, long long idx, String def) {\n";
		p: p . "    if (!s || idx < 0) return def ? spec_string_copy(def) : spec_string_intern(\"\");\n";
		p: p . "    if ((size_t)idx >= (size_t)spec_string_length(s)) return def ? spec_string_copy(def) : spec_string_intern(\"\");\n";
		p: p . "    char one[2] = { (char)spec_buf_get_byte(s, idx, -1, (SpecClosure*)NULL), '\\0' };\n";
		p: p . "    return spec_string_intern(one);\n";
		p: p . "}\n";
		p: p . "String spec_string_from_char_code(long long code) {\n";
