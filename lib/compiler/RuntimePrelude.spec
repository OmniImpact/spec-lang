		p: p . "    if (cls && cls->fn) { ((void (*)(void*, void*))cls->fn)(cls->env, arg1); }\n";
		p: p . "}\n\n";
		p: p . "/* No-op callback singleton: the default for optional error callbacks */\n";
		p: p . "static void _spec_noop_cb(void* env, const char* msg) { (void)env; (void)msg; }\n";
		p: p . "static SpecClosure* _spec_noop_closure = NULL;\n";
