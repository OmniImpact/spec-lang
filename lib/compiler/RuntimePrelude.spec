		p: p . "    pthread_mutex_lock(&m->lock);\n";
		p: p . "    long long cnt = 0;\n";
		p: p . "    SpecMapEntry* curr = m->head;\n";
		p: p . "    while (curr) { cnt++; curr = curr->next; }\n";
		p: p . "    pthread_mutex_unlock(&m->lock);\n";
		p: p . "    return cnt;\n";
		p: p . "}\n\n";
		p: p . "SpecArray* spec_map_keys(SpecMap* m) {\n";
		p: p . "    SpecArray* a = spec_array_new();\n";
		p: p . "    if (!m) return a;\n";
		p: p . "    pthread_mutex_lock(&m->lock);\n";
		p: p . "    SpecMapEntry* curr = m->head;\n";
		p: p . "    while (curr) {\n";
		p: p . "        spec_array_add(a, (void*)strdup(curr->key));\n";
		p: p . "        curr = curr->next;\n";
		p: p . "    }\n";
		p: p . "    pthread_mutex_unlock(&m->lock);\n";
		p: p . "    return a;\n";
		p: p . "}\n\n";
		p: p . "/* Spec Loop Control Intrinsic */\n";
		p: p . "typedef struct SpecLoopControl {\n";
		p: p . "    bool stopped;\n";
		p: p . "    void* callback;\n";
		p: p . "    void (*on_complete)(void* callback, struct SpecLoopControl* control);\n";
		p: p . "} SpecLoopControl;\n\n";
		p: p . "typedef struct SpecLoopControl LoopControl;\n\n";
		p: p . "SpecLoopControl* LoopControl_new(void) {\n";
		p: p . "    SpecLoopControl* c = (SpecLoopControl*)malloc(sizeof(SpecLoopControl));\n";
		p: p . "    if (c) {\n";
		p: p . "        c->stopped = false;\n";
		p: p . "        c->callback = NULL;\n";
		p: p . "        c->on_complete = NULL;\n";
		p: p . "    }\n";
		p: p . "    return c;\n";
		p: p . "}\n\n";
		p: p . "void LoopControl_stop(SpecLoopControl* c) {\n";
		p: p . "    if (c) c->stopped = true;\n";
		p: p . "}\n\n";
		p: p . "/* Spec Async Task Manager */\n";
		p: p . "static int spec_in_flight_tasks = 0;\n";
		p: p . "static pthread_mutex_t spec_task_mutex = PTHREAD_MUTEX_INITIALIZER;\n";
		p: p . "static pthread_cond_t spec_task_cond = PTHREAD_COND_INITIALIZER;\n\n";

		p: p . "void spec_async_task_started(void) {\n";
		p: p . "    pthread_mutex_lock(&spec_task_mutex);\n";
		p: p . "    spec_in_flight_tasks++;\n";
		p: p . "    pthread_mutex_unlock(&spec_task_mutex);\n";
		p: p . "}\n\n";
		p: p . "void spec_async_task_finished(void) {\n";
		p: p . "    pthread_mutex_lock(&spec_task_mutex);\n";
		p: p . "    spec_in_flight_tasks--;\n";
		p: p . "    if (spec_in_flight_tasks <= 0) {\n";
		p: p . "        spec_in_flight_tasks = 0;\n";
		p: p . "        pthread_cond_broadcast(&spec_task_cond);\n";
		p: p . "    }\n";
		p: p . "    pthread_mutex_unlock(&spec_task_mutex);\n";
		p: p . "}\n\n";
		p: p . "void spec_drain_async_tasks(void) {\n";
		p: p . "    pthread_mutex_lock(&spec_task_mutex);\n";
		p: p . "    while (spec_in_flight_tasks > 0) {\n";
		p: p . "        pthread_cond_wait(&spec_task_cond, &spec_task_mutex);\n";
		p: p . "    }\n";
		p: p . "    pthread_mutex_unlock(&spec_task_mutex);\n";
		p: p . "}\n\n";
		p: p . "/* File Package Primitives with Callbacks and Async Worker Support */\n";
		p: p . "typedef struct {\n";
		p: p . "    char* path;\n";
		p: p . "    char* content;\n";
		p: p . "    char* def;\n";
		p: p . "    void (*on_success_read)(const char*);\n";
		p: p . "    void (*on_success_write)(long long);\n";
		p: p . "    void (*on_error)(const char*);\n";
		p: p . "} SpecFileTask;\n\n";

		p: p . "const char* spec_file_read(const char* path, const char* def, void (*on_success)(const char*), void (*on_error)(const char*)) {\n";
		p: p . "    if (!path || strlen(path) == 0) {\n";
		p: p . "        if (on_error) on_error(\"File error: Empty or invalid file path provided\");\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    FILE* f = fopen(path, \"rb\");\n";
		p: p . "    if (!f) {\n";
		p: p . "        if (on_error) on_error(strerror(errno));\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    if (fseek(f, 0, SEEK_END) != 0) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        if (on_error) on_error(strerror(errno));\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    long size = ftell(f);\n";
		p: p . "    if (size < 0) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        if (on_error) on_error(strerror(errno));\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    fseek(f, 0, SEEK_SET);\n";
		p: p . "    char* buf = (char*)malloc(size + 1);\n";
		p: p . "    if (!buf) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        if (on_error) on_error(\"File error: Memory allocation failed during read\");\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    size_t read_bytes = fread(buf, 1, size, f);\n";
		p: p . "    buf[read_bytes] = '\\0';\n";
		p: p . "    fclose(f);\n";
		p: p . "    if (on_success) on_success(buf);\n";
		p: p . "    return buf;\n";
		p: p . "}\n\n";
		p: p . "bool spec_file_write(const char* path, const char* content, void (*on_success)(long long), void (*on_error)(const char*)) {\n";
		p: p . "    if (!path || strlen(path) == 0) {\n";
		p: p . "        if (on_error) on_error(\"File error: Empty or invalid file path provided\");\n";
		p: p . "        return false;\n";
		p: p . "    }\n";
		p: p . "    if (!content) content = \"\";\n";
		p: p . "    FILE* f = fopen(path, \"wb\");\n";
		p: p . "    if (!f) {\n";
		p: p . "        if (on_error) on_error(strerror(errno));\n";
		p: p . "        return false;\n";
		p: p . "    }\n";
		p: p . "    size_t len = strlen(content);\n";
		p: p . "    size_t written = fwrite(content, 1, len, f);\n";
		p: p . "    fclose(f);\n";
		p: p . "    if (written != len) {\n";
		p: p . "        if (on_error) on_error(strerror(errno));\n";
		p: p . "        return false;\n";
		p: p . "    }\n";
		p: p . "    if (on_success) on_success((long long)written);\n";
		p: p . "    return true;\n";
		p: p . "}\n\n";
		p: p . "static void* spec_file_read_worker(void* arg) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)arg;\n";
		p: p . "    spec_file_read(task->path, task->def, task->on_success_read, task->on_error);\n";
		p: p . "    if (task->path) free(task->path);\n";
		p: p . "    if (task->def) free(task->def);\n";
		p: p . "    free(task);\n";
		p: p . "    spec_async_task_finished();\n";
		p: p . "    return NULL;\n";
		p: p . "}\n\n";
		p: p . "void spec_file_read_async(const char* path, const char* def, void (*on_success)(const char*), void (*on_error)(const char*)) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)calloc(1, sizeof(SpecFileTask));\n";
		p: p . "    task->path = path ? strdup(path) : NULL;\n";
		p: p . "    task->def = def ? strdup(def) : NULL;\n";
		p: p . "    task->on_success_read = on_success;\n";
		p: p . "    task->on_error = on_error;\n";
		p: p . "    spec_async_task_started();\n";
		p: p . "    pthread_t tid;\n";
		p: p . "    pthread_create(&tid, NULL, spec_file_read_worker, task);\n";
		p: p . "    pthread_detach(tid);\n";
		p: p . "}\n\n";
		p: p . "static void* spec_file_write_worker(void* arg) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)arg;\n";
		p: p . "    spec_file_write(task->path, task->content, task->on_success_write, task->on_error);\n";
		p: p . "    if (task->path) free(task->path);\n";
		p: p . "    if (task->content) free(task->content);\n";
		p: p . "    free(task);\n";
		p: p . "    spec_async_task_finished();\n";
		p: p . "    return NULL;\n";
		p: p . "}\n\n";
		p: p . "void spec_file_write_async(const char* path, const char* content, void (*on_success)(long long), void (*on_error)(const char*)) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)calloc(1, sizeof(SpecFileTask));\n";
		p: p . "    task->path = path ? strdup(path) : NULL;\n";
		p: p . "    task->content = content ? strdup(content) : NULL;\n";
		p: p . "    task->on_success_write = on_success;\n";
		p: p . "    task->on_error = on_error;\n";
		p: p . "    spec_async_task_started();\n";
		p: p . "    pthread_t tid;\n";
		p: p . "    pthread_create(&tid, NULL, spec_file_write_worker, task);\n";
		p: p . "    pthread_detach(tid);\n";
		p: p . "}\n\n";
		p: p . "bool spec_file_exists(const char* path) {\n";
		p: p . "    if (!path) return false;\n";
		p: p . "    FILE* f = fopen(path, \"r\");\n";
		p: p . "    if (f) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        return true;\n";
		p: p . "    }\n";
		p: p . "    return false;\n";
		p: p . "}\n\n";
		p: p . "/* Process Package Primitives */\n";
		p: p . "long long spec_process_execute(const char* command, SpecArray* args) {\n";
		p: p . "    if (!command) return -1;\n";
		p: p . "    size_t total_len = strlen(command) + 1;\n";
		p: p . "    if (args) {\n";
		p: p . "        for (size_t i = 0; i < args->length; i++) {\n";
		p: p . "            total_len += strlen((const char*)args->items[i]) + 4;\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "    char* cmd_line = (char*)malloc(total_len + 16);\n";
		p: p . "    strcpy(cmd_line, command);\n";
		p: p . "    if (args) {\n";
		p: p . "        for (size_t i = 0; i < args->length; i++) {\n";
		p: p . "            strcat(cmd_line, \" \");\n";
		p: p . "            strcat(cmd_line, (const char*)args->items[i]);\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "    int status = system(cmd_line);\n";
		p: p . "    free(cmd_line);\n";
		p: p . "    return (long long)status;\n";
		p: p . "}\n\n";
		p: p . "void spec_process_sleep(long long ms) {\n";
		p: p . "    if (ms <= 0) return;\n";
		p: p . "    struct timespec ts;\n";
		p: p . "    ts.tv_sec = ms / 1000;\n";
		p: p . "    ts.tv_nsec = (ms % 1000) * 1000000L;\n";
		p: p . "    nanosleep(&ts, NULL);\n";
		p: p . "}\n\n";
		p: p . "/* Math Package Primitives */\n";
		p: p . "double spec_math_round(double v) { return round(v); }\n";
		p: p . "double spec_math_floor(double v) { return floor(v); }\n";
		p: p . "double spec_math_ceil(double v) { return ceil(v); }\n";
		p: p . "double spec_math_random(double min, double max) {\n";
		p: p . "    if (min >= max) return ((double)rand() / ((double)RAND_MAX + 1.0));\n";
		p: p . "    return min + ((double)rand() / ((double)RAND_MAX + 1.0)) * (max - min);\n";
		p: p . "}\n\n";
		return p;
	}

