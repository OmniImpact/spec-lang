#! Package compiler
#! C11 standard runtime prelude for Pure-Spec generated binaries.

## Emits standard C11 runtime definitions including string, array, map, file, and task primitives.
Class is RuntimePrelude{

	replace Array of String is using: [
		base:struct:Array,
		base:struct:Map,
		base:iterator:*
	];

	## Garbage collection mode: "" (default ARC) or "boehm"
	local String is gcMode: "";

	replace Function is init(){
		self:gcMode: "";
	}

	Function is setGcMode(String is mode){
		self:gcMode: mode;
	}

	## Emits the complete Spec C11 runtime prelude.
	##
	## @return: C source code string defining the Spec runtime library.
	Function of String is emitRuntime(){
		local String is p: "";
		p: p . "/* Generated by Pure-Spec Compiler */\n";
		p: p . "#define _POSIX_C_SOURCE 200809L\n";
		p: p . "#include <stdio.h>\n";
		p: p . "#include <stdlib.h>\n";
		p: p . "#include <string.h>\n";
		p: p . "#include <stdbool.h>\n";
		p: p . "#include <stdint.h>\n";
		p: p . "#include <ctype.h>\n";
		p: p . "#include <time.h>\n";
		p: p . "#include <errno.h>\n";
		p: p . "#include <math.h>\n";
		p: p . "#include <unistd.h>\n";
		p: p . "#include <pthread.h>\n";
		p: p . "#include <sys/wait.h>\n";
		p: p . "#include <sys/ioctl.h>\n";
		p: p . "#include <sys/resource.h>\n";
		p: p . "#include <stdatomic.h>\n\n";

		if (self:gcMode == "boehm") {
			p: p . "/* Boehm GC Integration */\n";
			p: p . "#define SPEC_GC_BOEHM 1\n";
			p: p . "extern void GC_init(void);\n";
			p: p . "extern void* GC_malloc(size_t size);\n";
			p: p . "extern void* GC_malloc_atomic(size_t size);\n";
			p: p . "extern void* GC_realloc(void* ptr, size_t size);\n";
			p: p . "extern void GC_free(void* ptr);\n";
			p: p . "extern int GC_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*start_routine)(void*), void* arg);\n\n";
			p: p . "static inline char* spec_gc_strdup(const char* s) {\n";
			p: p . "    if (!s) return NULL;\n";
			p: p . "    size_t len = strlen(s);\n";
			p: p . "    char* copy = (char*)GC_malloc_atomic(len + 1);\n";
			p: p . "    if (copy) memcpy(copy, s, len + 1);\n";
			p: p . "    return copy;\n";
			p: p . "}\n\n";
			p: p . "#define malloc(sz) GC_malloc(sz)\n";
			p: p . "#define calloc(n, sz) GC_malloc((n) * (sz))\n";
			p: p . "#define realloc(ptr, sz) GC_realloc(ptr, sz)\n";
			p: p . "#define strdup(s) spec_gc_strdup(s)\n";
			p: p . "#define free(ptr) ((void)(ptr))\n";
			p: p . "#define pthread_create(t, a, fn, arg) GC_pthread_create(t, a, fn, arg)\n\n";
		}

		p: p . "/* Spec Runtime Panic & Safety Utilities */\n";
		p: p . "void spec_panic(const char* msg) {\n";
		p: p . "    fprintf(stderr, \"[Spec Runtime Panic] %s\\n\", msg ? msg : \"fatal error\");\n";
		p: p . "    exit(1);\n";
		p: p . "}\n\n";
		p: p . "void spec_panic_bounds(const char* coll, long long idx, size_t len) {\n";
		p: p . "    fprintf(stderr, \"[Spec Runtime Panic] %s index out of bounds: index %lld for length %zu\\n\", coll ? coll : \"Collection\", idx, len);\n";
		p: p . "    exit(1);\n";
		p: p . "}\n\n";
		p: p . "void spec_panic_cast(const char* actual, const char* target) {\n";
		p: p . "    fprintf(stderr, \"[Spec Runtime Panic] Invalid downcast: instance of '%s' cannot be cast to '%s'\\n\", actual ? actual : \"Unknown\", target ? target : \"Unknown\");\n";
		p: p . "    exit(1);\n";
		p: p . "}\n\n";
		p: p . "static bool spec_is_subclass_of(const char* actual, const char* target);\n\n";
		p: p . "static inline void* spec_cast_check(const void* obj, const char* target) {\n";
		p: p . "    if (!obj) return NULL;\n";
		p: p . "    const char* actual = *((const char**)obj);\n";
		p: p . "    if (!spec_is_subclass_of(actual, target)) {\n";
		p: p . "        spec_panic_cast(actual, target);\n";
		p: p . "    }\n";
		p: p . "    return (void*)obj;\n";
		p: p . "}\n\n";

		p: p . "/* Spec Automated Reference Counting (ARC) Primitives */\n";
		p: p . "typedef struct {\n";
		p: p . "    _Atomic uint32_t ref_count;\n";
		p: p . "    void (*destroy)(void*);\n";
		p: p . "} SpecHeader;\n\n";
		p: p . "#define SPEC_HEADER(obj) (((SpecHeader*)(obj)) - 1)\n\n";
		p: p . "static inline void* spec_alloc(size_t size, void (*destroy)(void*)) {\n";
		p: p . "    SpecHeader* h = (SpecHeader*)calloc(1, sizeof(SpecHeader) + size);\n";
		p: p . "    if (!h) { fprintf(stderr, \"[Spec Panic] Out of memory\\n\"); exit(1); }\n";
		p: p . "    h->ref_count = 1;\n";
		p: p . "    h->destroy = destroy;\n";
		p: p . "    return (void*)(h + 1);\n";
		p: p . "}\n\n";
		p: p . "static inline void* spec_retain(void* obj) {\n";
		p: p . "    if (!obj) return NULL;\n";
		p: p . "    SpecHeader* h = SPEC_HEADER(obj);\n";
		p: p . "    atomic_fetch_add_explicit(&h->ref_count, 1, memory_order_relaxed);\n";
		p: p . "    return obj;\n";
		p: p . "}\n\n";
		p: p . "static inline void spec_release(void* obj) {\n";
		p: p . "    if (!obj) return;\n";
		p: p . "    SpecHeader* h = SPEC_HEADER(obj);\n";
		p: p . "    if (atomic_fetch_sub_explicit(&h->ref_count, 1, memory_order_acq_rel) == 1) {\n";
		p: p . "        if (h->destroy) h->destroy(obj);\n";
		p: p . "        free(h);\n";
		p: p . "    }\n";
		p: p . "}\n\n";
		p: p . "static inline void* spec_assign(void** dest, void* src) {\n";
		p: p . "    if (src) spec_retain(src);\n";
		p: p . "    if (*dest) spec_release(*dest);\n";
		p: p . "    *dest = src;\n";
		p: p . "    return src;\n";
		p: p . "}\n\n";
		p: p . "static inline void* spec_assign_transfer(void** dest, void* src) {\n";
		p: p . "    if (*dest) spec_release(*dest);\n";
		p: p . "    *dest = src;\n";
		p: p . "    return src;\n";
		p: p . "}\n\n";
		p: p . "static inline void spec_scope_cleanup(void* pptr) {\n";
		p: p . "    void* obj = *(void**)pptr;\n";
		p: p . "    if (obj) spec_release(obj);\n";
		p: p . "}\n\n";
		p: p . "#define SPEC_AUTO __attribute__((cleanup(spec_scope_cleanup)))\n\n";
		p: p . "/* Spec First-Class Closure Representation */\n";
		p: p . "typedef struct {\n";
		p: p . "    void* fn;\n";
		p: p . "    void* env;\n";
		p: p . "    void (*destroy_env)(void*);\n";
		p: p . "} SpecClosure;\n\n";
		p: p . "static inline void spec_closure_destroy(void* self) {\n";
		p: p . "    SpecClosure* c = (SpecClosure*)self;\n";
		p: p . "    if (c) {\n";
		p: p . "        if (c->env && c->destroy_env) {\n";
		p: p . "            c->destroy_env(c->env);\n";
		p: p . "            c->env = NULL;\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "}\n\n";
		p: p . "static inline SpecClosure* spec_closure_new(void* fn, void* env, void (*destroy_env)(void*)) {\n";
		p: p . "    SpecClosure* c = (SpecClosure*)spec_alloc(sizeof(SpecClosure), spec_closure_destroy);\n";
		p: p . "    c->fn = fn;\n";
		p: p . "    c->env = env;\n";
		p: p . "    c->destroy_env = destroy_env;\n";
		p: p . "    return c;\n";
		p: p . "}\n\n";

		p: p . "/* Spec Runtime String Utilities */\n";
		p: p . "static const char* _spec_last_str = NULL;\n";
		p: p . "static size_t _spec_last_len = 0;\n\n";
		p: p . "long long spec_str_length(const char* s) {\n";
		p: p . "    if (!s) return 0;\n";
		p: p . "    if (s == _spec_last_str) return (long long)_spec_last_len;\n";
		p: p . "    size_t len = strlen(s);\n";
		p: p . "    _spec_last_str = s;\n";
		p: p . "    _spec_last_len = len;\n";
		p: p . "    return (long long)len;\n";
		p: p . "}\n\n";
		p: p . "typedef struct {\n";
		p: p . "    char* ptr;\n";
		p: p . "    size_t len;\n";
		p: p . "    size_t cap;\n";
		p: p . "} SpecStrBuf;\n";
		p: p . "static SpecStrBuf _spec_str_bufs[512];\n";
		p: p . "static size_t _spec_str_buf_next = 0;\n";
		p: p . "static pthread_mutex_t _spec_str_buf_lock = PTHREAD_MUTEX_INITIALIZER;\n\n";
		p: p . "bool spec_str_is_buffered(const char* s) {\n";
		p: p . "    if (!s || *s == '\\0') return false;\n";
		p: p . "    for (size_t i = 0; i < 512; i++) {\n";
		p: p . "        if (_spec_str_bufs[i].ptr == s) return true;\n";
		p: p . "    }\n";
		p: p . "    return false;\n";
		p: p . "}\n\n";
		p: p . "char* spec_str_clone_if_buffered(const char* s) {\n";
		p: p . "    if (!s) return NULL;\n";
		p: p . "    pthread_mutex_lock(&_spec_str_buf_lock);\n";
		p: p . "    bool buffered = spec_str_is_buffered(s);\n";
		p: p . "    pthread_mutex_unlock(&_spec_str_buf_lock);\n";
		p: p . "    if (buffered) return strdup(s);\n";
		p: p . "    return (char*)s;\n";
		p: p . "}\n\n";
		p: p . "char* spec_str_append(const char* a, const char* b) {\n";
		p: p . "    if (!a) a = \"\";\n";
		p: p . "    if (!b || !*b) return (char*)a;\n";
		p: p . "    size_t lb = strlen(b);\n";
		p: p . "    pthread_mutex_lock(&_spec_str_buf_lock);\n";
		p: p . "    for (size_t i = 0; i < 512; i++) {\n";
		p: p . "        if (_spec_str_bufs[i].ptr == a && a != NULL && *a != '\\0') {\n";
		p: p . "            size_t la = _spec_str_bufs[i].len;\n";
		p: p . "            if (la + lb + 1 > _spec_str_bufs[i].cap) {\n";
		p: p . "                size_t new_cap = _spec_str_bufs[i].cap * 2;\n";
		p: p . "                if (new_cap < la + lb + 1) new_cap = (la + lb + 1) * 2;\n";
		p: p . "                char* new_ptr = (char*)realloc(_spec_str_bufs[i].ptr, new_cap);\n";
		p: p . "                _spec_str_bufs[i].ptr = new_ptr;\n";
		p: p . "                _spec_str_bufs[i].cap = new_cap;\n";
		p: p . "            }\n";
		p: p . "            memcpy(_spec_str_bufs[i].ptr + la, b, lb);\n";
		p: p . "            _spec_str_bufs[i].ptr[la + lb] = '\\0';\n";
		p: p . "            _spec_str_bufs[i].len = la + lb;\n";
		p: p . "            _spec_last_str = _spec_str_bufs[i].ptr;\n";
		p: p . "            _spec_last_len = la + lb;\n";
		p: p . "            pthread_mutex_unlock(&_spec_str_buf_lock);\n";
		p: p . "            return _spec_str_bufs[i].ptr;\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "    size_t la = strlen(a);\n";
		p: p . "    size_t cap = (la + lb + 1) * 2;\n";
		p: p . "    if (cap < 64) cap = 64;\n";
		p: p . "    char* res = (char*)malloc(cap);\n";
		p: p . "    memcpy(res, a, la);\n";
		p: p . "    memcpy(res + la, b, lb);\n";
		p: p . "    res[la + lb] = '\\0';\n";
		p: p . "    size_t slot = _spec_str_buf_next;\n";
		p: p . "    _spec_str_buf_next = (slot + 1) & 511;\n";
		p: p . "    _spec_str_bufs[slot].ptr = res;\n";
		p: p . "    _spec_str_bufs[slot].len = la + lb;\n";
		p: p . "    _spec_str_bufs[slot].cap = cap;\n";
		p: p . "    _spec_last_str = res;\n";
		p: p . "    _spec_last_len = la + lb;\n";
		p: p . "    pthread_mutex_unlock(&_spec_str_buf_lock);\n";
		p: p . "    return res;\n";
		p: p . "}\n\n";
		p: p . "bool spec_str_equals(const char* a, const char* b) {\n";
		p: p . "    if (a == b) return true;\n";
		p: p . "    if (!a || !b) return false;\n";
		p: p . "    return strcmp(a, b) == 0;\n";
		p: p . "}\n\n";
		p: p . "char* spec_str_concat(const char* a, const char* b) {\n";
		p: p . "    if (!a) a = \"\";\n";
		p: p . "    if (!b) b = \"\";\n";
		p: p . "    size_t la = strlen(a);\n";
		p: p . "    size_t lb = strlen(b);\n";
		p: p . "    char* res = (char*)malloc(la + lb + 1);\n";
		p: p . "    memcpy(res, a, la);\n";
		p: p . "    memcpy(res + la, b, lb);\n";
		p: p . "    res[la + lb] = '\\0';\n";
		p: p . "    return res;\n";
		p: p . "}\n\n";
		p: p . "static char _spec_small_ints[258][8];\n";
		p: p . "static bool _spec_small_ints_init = false;\n";
		p: p . "char* spec_to_string_int(long long v) {\n";
		p: p . "    if (v >= -1 && v <= 256) {\n";
		p: p . "        if (!_spec_small_ints_init) {\n";
		p: p . "            for (int i = -1; i <= 256; i++) snprintf(_spec_small_ints[i + 1], 8, \"%d\", i);\n";
		p: p . "            _spec_small_ints_init = true;\n";
		p: p . "        }\n";
		p: p . "        return _spec_small_ints[v + 1];\n";
		p: p . "    }\n";
		p: p . "    char buf[64];\n";
		p: p . "    snprintf(buf, sizeof(buf), \"%lld\", v);\n";
		p: p . "    return strdup(buf);\n";
		p: p . "}\n\n";
		p: p . "char* spec_to_string_float(double v) {\n";
		p: p . "    char buf[64];\n";
		p: p . "    snprintf(buf, sizeof(buf), \"%g\", v);\n";
		p: p . "    return strdup(buf);\n";
		p: p . "}\n\n";
		p: p . "char* spec_to_string_bool(bool v) {\n";
		p: p . "    return v ? \"true\" : \"false\";\n";
		p: p . "}\n\n";
		p: p . "static char _spec_char_table[256][2];\n";
		p: p . "static bool _spec_char_table_init = false;\n";
		p: p . "const char* spec_str_char_at(const char* s, long long idx, const char* def) {\n";
		p: p . "    if (!s || idx < 0) return def ? def : \"\";\n";
		p: p . "    size_t len = (s == _spec_last_str) ? _spec_last_len : strlen(s);\n";
		p: p . "    _spec_last_str = s;\n";
		p: p . "    _spec_last_len = len;\n";
		p: p . "    if ((size_t)idx >= len) return def ? def : \"\";\n";
		p: p . "    if (!_spec_char_table_init) {\n";
		p: p . "        for (int i = 0; i < 256; i++) { _spec_char_table[i][0] = (char)i; _spec_char_table[i][1] = '\\0'; }\n";
		p: p . "        _spec_char_table_init = true;\n";
		p: p . "    }\n";
		p: p . "    return _spec_char_table[(unsigned char)s[idx]];\n";
		p: p . "}\n\n";
		p: p . "const char* spec_str_from_char_code(long long code) {\n";
		p: p . "    if (code < 0 || code > 255) return \"\";\n";
		p: p . "    if (!_spec_char_table_init) {\n";
		p: p . "        for (int i = 0; i < 256; i++) { _spec_char_table[i][0] = (char)i; _spec_char_table[i][1] = '\\0'; }\n";
		p: p . "        _spec_char_table_init = true;\n";
		p: p . "    }\n";
		p: p . "    return _spec_char_table[(unsigned char)code];\n";
		p: p . "}\n\n";
		p: p . "const char* spec_str_substring(const char* s, long long start, long long end) {\n";
		p: p . "    if (!s) return \"\";\n";
		p: p . "    size_t len = strlen(s);\n";
		p: p . "    if (start < 0) start = 0;\n";
		p: p . "    if (end > (long long)len) end = (long long)len;\n";
		p: p . "    if (start >= end) return \"\";\n";
		p: p . "    size_t sub_len = (size_t)(end - start);\n";
		p: p . "    char* buf = (char*)malloc(sub_len + 1);\n";
		p: p . "    memcpy(buf, s + start, sub_len);\n";
		p: p . "    buf[sub_len] = '\\0';\n";
		p: p . "    return buf;\n";
		p: p . "}\n\n";
		p: p . "bool spec_str_starts_with(const char* s, const char* prefix) {\n";
		p: p . "    if (!s || !prefix) return false;\n";
		p: p . "    size_t slen = strlen(s);\n";
		p: p . "    size_t plen = strlen(prefix);\n";
		p: p . "    if (plen > slen) return false;\n";
		p: p . "    return strncmp(s, prefix, plen) == 0;\n";
		p: p . "}\n\n";
		p: p . "bool spec_str_ends_with(const char* s, const char* suffix) {\n";
		p: p . "    if (!s || !suffix) return false;\n";
		p: p . "    size_t slen = strlen(s);\n";
		p: p . "    size_t xlen = strlen(suffix);\n";
		p: p . "    if (xlen > slen) return false;\n";
		p: p . "    return strcmp(s + slen - xlen, suffix) == 0;\n";
		p: p . "}\n\n";
		p: p . "bool spec_str_contains(const char* s, const char* needle) {\n";
		p: p . "    if (!s || !needle) return false;\n";
		p: p . "    return strstr(s, needle) != NULL;\n";
		p: p . "}\n\n";
		p: p . "const char* spec_str_replace_all(const char* s, const char* search, const char* replacement) {\n";
		p: p . "    if (!s) return \"\";\n";
		p: p . "    if (!search || !*search) return strdup(s);\n";
		p: p . "    if (!replacement) replacement = \"\";\n";
		p: p . "    size_t slen = strlen(search);\n";
		p: p . "    size_t rlen = strlen(replacement);\n";
		p: p . "    size_t count = 0;\n";
		p: p . "    const char* p = s;\n";
		p: p . "    while ((p = strstr(p, search)) != NULL) { count++; p += slen; }\n";
		p: p . "    if (count == 0) return strdup(s);\n";
		p: p . "    size_t out_len = strlen(s) + count * rlen - count * slen;\n";
		p: p . "    char* out = (char*)malloc(out_len + 1);\n";
		p: p . "    char* dst = out;\n";
		p: p . "    p = s;\n";
		p: p . "    const char* match;\n";
		p: p . "    while ((match = strstr(p, search)) != NULL) {\n";
		p: p . "        size_t chunk = (size_t)(match - p);\n";
		p: p . "        memcpy(dst, p, chunk);\n";
		p: p . "        dst += chunk;\n";
		p: p . "        memcpy(dst, replacement, rlen);\n";
		p: p . "        dst += rlen;\n";
		p: p . "        p = match + slen;\n";
		p: p . "    }\n";
		p: p . "    strcpy(dst, p);\n";
		p: p . "    return out;\n";
		p: p . "}\n\n";
		p: p . "const char* spec_str_trim(const char* s) {\n";
		p: p . "    if (!s) return \"\";\n";
		p: p . "    while (*s == ' ' || *s == '\\t' || *s == '\\n' || *s == '\\r') s++;\n";
		p: p . "    if (*s == 0) return \"\";\n";
		p: p . "    const char* end = s + strlen(s) - 1;\n";
		p: p . "    while (end > s && (*end == ' ' || *end == '\\t' || *end == '\\n' || *end == '\\r')) end--;\n";
		p: p . "    size_t len = (size_t)(end - s + 1);\n";
		p: p . "    char* buf = (char*)malloc(len + 1);\n";
		p: p . "    memcpy(buf, s, len);\n";
		p: p . "    buf[len] = '\\0';\n";
		p: p . "    return buf;\n";
		p: p . "}\n\n";
		p: p . "bool spec_str_is_digit(const char* s) {\n";
		p: p . "    if (!s || !*s) return false;\n";
		p: p . "    for (const char* p = s; *p; p++) { if (!isdigit((unsigned char)*p)) return false; }\n";
		p: p . "    return true;\n";
		p: p . "}\n\n";
		p: p . "bool spec_str_is_alpha(const char* s) {\n";
		p: p . "    if (!s || !*s) return false;\n";
		p: p . "    for (const char* p = s; *p; p++) { if (!isalpha((unsigned char)*p)) return false; }\n";
		p: p . "    return true;\n";
		p: p . "}\n\n";
		p: p . "bool spec_str_is_whitespace(const char* s) {\n";
		p: p . "    if (!s || !*s) return false;\n";
