		p: p . "}\n\n";
		p: p . "/* Process Package Primitives */\n";
		p: p . "long long spec_process_execute(const char* command, SpecArray* args) {\n";
		p: p . "    if (!command) return -1;\n";
		p: p . "    size_t total_len = strlen(command) + 1;\n";
		p: p . "    if (args) {\n";
		p: p . "        for (size_t i = 0; i < args->length; i++) {\n";
		p: p . "            total_len += strlen((const char*)args->items[i]) + 4;\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "    char* cmd_line = (char*)malloc(total_len + 16);\n";
		p: p . "    strcpy(cmd_line, command);\n";
		p: p . "    if (args) {\n";
		p: p . "        for (size_t i = 0; i < args->length; i++) {\n";
		p: p . "            strcat(cmd_line, \" \");\n";
		p: p . "            strcat(cmd_line, (const char*)args->items[i]);\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "    int status = system(cmd_line);\n";
		p: p . "    free(cmd_line);\n";
		p: p . "    if (status == -1) return -1;\n";
		p: p . "    return (long long)WEXITSTATUS(status);\n";
		p: p . "}\n\n";
		p: p . "void spec_process_sleep(long long ms) {\n";
		p: p . "    if (ms <= 0) return;\n";
		p: p . "    struct timespec ts;\n";
		p: p . "    ts.tv_sec = ms / 1000;\n";
		p: p . "    ts.tv_nsec = (ms % 1000) * 1000000L;\n";
		p: p . "    nanosleep(&ts, NULL);\n";
		p: p . "}\n\n";
		p: p . "long long spec_process_get_pid(void) {\n";
		p: p . "    return (long long)getpid();\n";
		p: p . "}\n\n";
		p: p . "/* Math Package Primitives */\n";
		p: p . "double spec_math_round(double v) { return round(v); }\n";
		p: p . "double spec_math_floor(double v) { return floor(v); }\n";
		p: p . "double spec_math_ceil(double v) { return ceil(v); }\n";
		p: p . "double spec_math_abs(double v) { return fabs(v); }\n";
		p: p . "double spec_math_min(double a, double b) { return (a < b) ? a : b; }\n";
		p: p . "double spec_math_max(double a, double b) { return (a > b) ? a : b; }\n";
		p: p . "double spec_math_clamp(double v, double lo, double hi) {\n";
		p: p . "    if (hi < lo) return lo;\n";
		p: p . "    if (v < lo) return lo;\n";
		p: p . "    if (v > hi) return hi;\n";
		p: p . "    return v;\n";
		p: p . "}\n";
		p: p . "double spec_math_sqrt(double v) { return v < 0.0 ? 0.0 : sqrt(v); }\n";
		p: p . "double spec_math_sin(double v) { return sin(v); }\n";
		p: p . "double spec_math_cos(double v) { return cos(v); }\n";
		p: p . "double spec_math_tan(double v) { return tan(v); }\n";
		p: p . "double spec_math_atan2(double y, double x) { return atan2(y, x); }\n";
		p: p . "double spec_math_log(double v) { return v <= 0.0 ? 0.0 : log(v); }\n";
		p: p . "double spec_math_log2(double v) { return v <= 0.0 ? 0.0 : log2(v); }\n";
		p: p . "double spec_math_pow(double base, double exp) { return pow(base, exp); }\n";
		p: p . "long long spec_math_to_int(double v) { return (long long)v; }\n";
		p: p . "double spec_math_to_float(long long v) { return (double)v; }\n\n";
		p: p . "double spec_math_random(double min, double max) {\n";
		p: p . "    if (min >= max) return ((double)rand() / ((double)RAND_MAX + 1.0));\n";
		p: p . "    return min + ((double)rand() / ((double)RAND_MAX + 1.0)) * (max - min);\n";
		p: p . "}\n\n";
		p: p . "/* Integer Base Conversion */\n";
		p: p . "char* spec_int_to_base(long long v, long long base, long long digits) {\n";
		p: p . "    if (base < 2 || base > 36) base = 10;\n";
		p: p . "    if (digits < 0) digits = 0;\n";
		p: p . "    const char* digs = \"0123456789abcdefghijklmnopqrstuvwxyz\";\n";
		p: p . "    char buf[80];\n";
		p: p . "    int idx = 79;\n";
		p: p . "    buf[idx] = '\\0';\n";
		p: p . "    int neg = v < 0;\n";
		p: p . "    unsigned long long u = neg ? (unsigned long long)(-(v + 1)) + 1ULL : (unsigned long long)v;\n";
		p: p . "    if (u == 0) buf[--idx] = '0';\n";
		p: p . "    while (u > 0) { buf[--idx] = digs[u % (unsigned long long)base]; u /= (unsigned long long)base; }\n";
		p: p . "    while ((79 - idx) < (int)digits && idx > 0) buf[--idx] = '0';\n";
		p: p . "    if (neg && idx > 0) buf[--idx] = '-';\n";
		p: p . "    return strdup(buf + idx);\n";
		p: p . "}\n\n";
		p: p . "long long spec_parse_base(const char* s, long long base, long long def) {\n";
		p: p . "    if (!s || !*s) return def;\n";
		p: p . "    int b = (int)base;\n";
		p: p . "    if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) { b = 16; s += 2; }\n";
		p: p . "    else if (s[0] == '0' && (s[1] == 'b' || s[1] == 'B')) { b = 2; s += 2; }\n";
		p: p . "    else if (s[0] == '0' && (s[1] == 'o' || s[1] == 'O')) { b = 8; s += 2; }\n";
		p: p . "    if (b < 2 || b > 36) return def;\n";
		p: p . "    int neg = 0;\n";
		p: p . "    if (*s == '-') { neg = 1; s++; }\n";
		p: p . "    if (!*s) return def;\n";
		p: p . "    unsigned long long v = 0;\n";
		p: p . "    int any = 0;\n";
		p: p . "    for (; *s; s++) {\n";
		p: p . "        if (*s == '_') continue;\n";
		p: p . "        int d;\n";
		p: p . "        if (*s >= '0' && *s <= '9') d = *s - '0';\n";
		p: p . "        else if (*s >= 'a' && *s <= 'z') d = *s - 'a' + 10;\n";
		p: p . "        else if (*s >= 'A' && *s <= 'Z') d = *s - 'A' + 10;\n";
		p: p . "        else return def;\n";
		p: p . "        if (d >= b) return def;\n";
		p: p . "        v = v * (unsigned long long)b + (unsigned long long)d;\n";
		p: p . "        any = 1;\n";
		p: p . "    }\n";
		p: p . "    if (!any) return def;\n";
		p: p . "    return neg ? -(long long)v : (long long)v;\n";
		p: p . "}\n\n";
		p: p . "/* Terminal Metrics */\n";
		p: p . "long long spec_term_width(void) {\n";
		p: p . "    if (!isatty(1)) return 0;\n";
		p: p . "    struct winsize ws;\n";
		p: p . "    if (ioctl(1, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0) return (long long)ws.ws_col;\n";
		p: p . "    char* cols = getenv(\"COLUMNS\");\n";
		p: p . "    if (cols) return (long long)atoi(cols);\n";
		p: p . "    return 78;\n";
		p: p . "}\n\n";
		p: p . "long long spec_term_height(void) {\n";
		p: p . "    if (!isatty(1)) return 0;\n";
		p: p . "    struct winsize ws;\n";
		p: p . "    if (ioctl(1, TIOCGWINSZ, &ws) == 0 && ws.ws_row > 0) return (long long)ws.ws_row;\n";
		p: p . "    char* lines = getenv(\"LINES\");\n";
		p: p . "    if (lines) return (long long)atoi(lines);\n";
		p: p . "    return 24;\n";
		p: p . "}\n\n";
		p: p . "/* Atomic Slots */\n";
		p: p . "static atomic_llong _spec_atomic_slots[64];\n\n";
		p: p . "long long spec_atomic_add(long long slot, long long v) {\n";
		p: p . "    if (slot < 0 || slot >= 64) return 0;\n";
		p: p . "    return atomic_fetch_add(&_spec_atomic_slots[slot], v) + v;\n";
		p: p . "}\n\n";
		p: p . "long long spec_atomic_put(long long slot, long long v) {\n";
		p: p . "    if (slot < 0 || slot >= 64) return v;\n";
		p: p . "    atomic_store(&_spec_atomic_slots[slot], v);\n";
		p: p . "    return v;\n";
		p: p . "}\n\n";
		p: p . "long long spec_atomic_get(long long slot) {\n";
		p: p . "    if (slot < 0 || slot >= 64) return 0;\n";
		p: p . "    return atomic_load(&_spec_atomic_slots[slot]);\n";
		p: p . "}\n\n";
		p: p . "/* Per-Thread RNG (xorshift64*, lock-free, self-seeding) */\n";
		p: p . "static __thread unsigned long long _spec_rng_state = 0;\n\n";
		p: p . "static unsigned long long spec_rng_next(void) {\n";
		p: p . "    unsigned long long x = _spec_rng_state;\n";
		p: p . "    x ^= x >> 12;\n";
		p: p . "    x ^= x << 25;\n";
		p: p . "    x ^= x >> 27;\n";
		p: p . "    _spec_rng_state = x;\n";
		p: p . "    return x * 0x2545F4914F6CDD1DULL;\n";
		p: p . "}\n\n";
		p: p . "void spec_fast_random_seed(long long idx) {\n";
		p: p . "    _spec_rng_state = 0x9E3779B97F4A7C15ULL ^ ((unsigned long long)idx * 0xBF58476D1CE4E5B9ULL + 0x94D049BB133111EBULL);\n";
		p: p . "    if (_spec_rng_state == 0) _spec_rng_state = 1;\n";
		p: p . "    spec_rng_next();\n";
		p: p . "    spec_rng_next();\n";
		p: p . "    spec_rng_next();\n";
		p: p . "}\n\n";
		p: p . "double spec_fast_random(void) {\n";
		p: p . "    if (_spec_rng_state == 0) spec_fast_random_seed(0x5DEECE66DULL);\n";
		p: p . "    return (double)(spec_rng_next() >> 11) * (1.0 / 9007199254740992.0);\n";
		p: p . "}\n\n";
		p: p . "/* Parallel Fan-Out */\n";
		p: p . "typedef long long (*SpecWorkerFn)(void* env, long long idx, long long count);\n";
		p: p . "typedef struct { SpecWorkerFn fn; void* env; long long idx; long long count; } SpecParallelTask;\n\n";
		p: p . "static void* spec_parallel_worker(void* arg) {\n";
		p: p . "    SpecParallelTask* t = (SpecParallelTask*)arg;\n";
		p: p . "    spec_fast_random_seed(t->idx);\n";
		p: p . "    long long r = t->fn(t->env, t->idx, t->count);\n";
		p: p . "    free(t);\n";
		p: p . "    return (void*)(intptr_t)r;\n";
		p: p . "}\n\n";
		p: p . "long long spec_parallel_run(long long threads, long long iterations, void* worker_closure) {\n";
		p: p . "    if (threads < 1) threads = 1;\n";
		p: p . "    if (threads > 64) threads = 64;\n";
		p: p . "    SpecClosure* cls = (SpecClosure*)worker_closure;\n";
		p: p . "    if (!cls || !cls->fn) spec_panic(\"Parallel:run received null worker Function\");\n";
		p: p . "    pthread_t tids[64];\n";
		p: p . "    long long total = 0;\n";
		p: p . "    long long base = iterations / threads;\n";
		p: p . "    long long rem = iterations % threads;\n";
		p: p . "    for (long long i = 0; i < threads; i++) {\n";
		p: p . "        SpecParallelTask* t = (SpecParallelTask*)malloc(sizeof(SpecParallelTask));\n";
		p: p . "        t->fn = (SpecWorkerFn)cls->fn;\n";
		p: p . "        t->env = cls->env;\n";
		p: p . "        t->idx = i;\n";
		p: p . "        t->count = base + (i < rem ? 1 : 0);\n";
		p: p . "        if (pthread_create(&tids[i], NULL, spec_parallel_worker, t) != 0) {\n";
		p: p . "            free(t);\n";
		p: p . "            tids[i] = pthread_self();\n";
		p: p . "        }\n";
		p: p . "    }\n";
		p: p . "    for (long long i = 0; i < threads; i++) {\n";
		p: p . "        void* ret = NULL;\n";
		p: p . "        pthread_join(tids[i], &ret);\n";
		p: p . "        total += (long long)(intptr_t)ret;\n";
		p: p . "    }\n";
		p: p . "    return total;\n";
		p: p . "}\n\n";
		p: p . "/* Type Name Introspection */\n";
		p: p . "const char* spec_type_name(const void* obj) {\n";
		p: p . "    if (!obj) return \"\";\n";
		p: p . "    return *((const char**)obj);\n";
		p: p . "}\n\n";
		p: p . "/* Clock & Memory Metrics */\n";
		p: p . "long long spec_clock_ms(void) {\n";
		p: p . "    struct timespec ts;\n";
		p: p . "    clock_gettime(CLOCK_MONOTONIC, &ts);\n";
		p: p . "    return ((long long)ts.tv_sec * 1000) + (ts.tv_nsec / 1000000);\n";
		p: p . "}\n\n";
		p: p . "long long spec_mem_peak_kb(void) {\n";
		p: p . "    struct rusage ru;\n";
		p: p . "    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0;\n";
		p: p . "    return (long long)ru.ru_maxrss;\n";
		p: p . "}\n\n";
		p: p . "long long spec_thread_count(void) {\n";
		p: p . "    FILE* f = fopen(\"/proc/self/status\", \"r\");\n";
		p: p . "    if (!f) return 1;\n";
		p: p . "    char line[256];\n";
		p: p . "    long long n = 1;\n";
		p: p . "    while (fgets(line, sizeof(line), f)) {\n";
		p: p . "        if (strncmp(line, \"Threads:\", 8) == 0) { n = atoll(line + 8); break; }\n";
		p: p . "    }\n";
		p: p . "    fclose(f);\n";
		p: p . "    return n;\n";
		p: p . "}\n\n";
		p: p . "/* Error Output Primitive */\n";
		p: p . "void spec_error_line(const char* s) {\n";
		p: p . "    if (!s) s = \"\";\n";
		p: p . "    fprintf(stderr, \"%s\\n\", s);\n";
		p: p . "}\n\n";
		return p;
	}

