		p: p . "    }\n";
		p: p . "    pthread_mutex_unlock(&spec_task_mutex);\n";
		p: p . "}\n\n";
		p: p . "/* File Package Primitives with Callbacks and Async Worker Support */\n";
		p: p . "static inline void spec_call_closure_int(SpecClosure* cls, long long arg1) {\n";
		p: p . "    if (cls && cls->fn) { ((void (*)(void*, long long))cls->fn)(cls->env, arg1); }\n";
		p: p . "}\n";
		p: p . "static inline void spec_call_closure_str(SpecClosure* cls, const char* arg1) {\n";
		p: p . "    if (cls && cls->fn) { ((void (*)(void*, const char*))cls->fn)(cls->env, arg1); }\n";
		p: p . "}\n\n";
		p: p . "typedef struct {\n";
		p: p . "    char* path;\n";
		p: p . "    char* content;\n";
		p: p . "    char* def;\n";
		p: p . "    SpecClosure* on_success_read;\n";
		p: p . "    SpecClosure* on_success_write;\n";
		p: p . "    SpecClosure* on_error;\n";
		p: p . "} SpecFileTask;\n\n";
		p: p . "const char* spec_file_read(const char* path, const char* def, SpecClosure* on_success, SpecClosure* on_error) {\n";
		p: p . "    if (!path || strlen(path) == 0) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, \"File error: Empty or invalid file path provided\");\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    FILE* f = fopen(path, \"rb\");\n";
		p: p . "    if (!f) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, strerror(errno));\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    if (fseek(f, 0, SEEK_END) != 0) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, strerror(errno));\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    long size = ftell(f);\n";
		p: p . "    if (size < 0) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, strerror(errno));\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    fseek(f, 0, SEEK_SET);\n";
		p: p . "    char* buf = (char*)malloc(size + 1);\n";
		p: p . "    if (!buf) {\n";
		p: p . "        fclose(f);\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, \"File error: Memory allocation failed during read\");\n";
		p: p . "        return def ? def : \"\";\n";
		p: p . "    }\n";
		p: p . "    size_t read_bytes = fread(buf, 1, size, f);\n";
		p: p . "    buf[read_bytes] = '\\0';\n";
		p: p . "    fclose(f);\n";
		p: p . "    if (on_success) spec_call_closure_str(on_success, buf);\n";
		p: p . "    return buf;\n";
		p: p . "}\n\n";
		p: p . "bool spec_file_write(const char* path, const char* content, SpecClosure* on_success, SpecClosure* on_error) {\n";
		p: p . "    if (!path || strlen(path) == 0) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, \"File error: Empty or invalid file path provided\");\n";
		p: p . "        return false;\n";
		p: p . "    }\n";
		p: p . "    if (!content) content = \"\";\n";
		p: p . "    FILE* f = fopen(path, \"wb\");\n";
		p: p . "    if (!f) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, strerror(errno));\n";
		p: p . "        return false;\n";
		p: p . "    }\n";
		p: p . "    size_t len = strlen(content);\n";
		p: p . "    size_t written = fwrite(content, 1, len, f);\n";
		p: p . "    fclose(f);\n";
		p: p . "    if (written != len) {\n";
		p: p . "        if (on_error) spec_call_closure_str(on_error, strerror(errno));\n";
		p: p . "        return false;\n";
		p: p . "    }\n";
		p: p . "    if (on_success) spec_call_closure_int(on_success, (long long)written);\n";
		p: p . "    return true;\n";
		p: p . "}\n\n";
		p: p . "static void* spec_file_read_worker(void* arg) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)arg;\n";
		p: p . "    spec_file_read(task->path, task->def, task->on_success_read, task->on_error);\n";
		p: p . "    if (task->path) free(task->path);\n";
		p: p . "    if (task->def) free(task->def);\n";
		p: p . "    if (task->on_success_read) spec_release(task->on_success_read);\n";
		p: p . "    if (task->on_error) spec_release(task->on_error);\n";
		p: p . "    free(task);\n";
		p: p . "    spec_async_task_finished();\n";
		p: p . "    return NULL;\n";
		p: p . "}\n\n";
		p: p . "void spec_file_read_async(const char* path, const char* def, SpecClosure* on_success, SpecClosure* on_error) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)calloc(1, sizeof(SpecFileTask));\n";
		p: p . "    task->path = path ? strdup(path) : NULL;\n";
		p: p . "    task->def = def ? strdup(def) : NULL;\n";
		p: p . "    task->on_success_read = (SpecClosure*)spec_retain(on_success);\n";
		p: p . "    task->on_error = (SpecClosure*)spec_retain(on_error);\n";
		p: p . "    spec_async_task_started();\n";
		p: p . "    pthread_t tid;\n";
		p: p . "    pthread_create(&tid, NULL, spec_file_read_worker, task);\n";
		p: p . "    pthread_detach(tid);\n";
		p: p . "}\n\n";
		p: p . "static void* spec_file_write_worker(void* arg) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)arg;\n";
		p: p . "    spec_file_write(task->path, task->content, task->on_success_write, task->on_error);\n";
		p: p . "    if (task->path) free(task->path);\n";
		p: p . "    if (task->content) free(task->content);\n";
		p: p . "    if (task->on_success_write) spec_release(task->on_success_write);\n";
		p: p . "    if (task->on_error) spec_release(task->on_error);\n";
		p: p . "    free(task);\n";
		p: p . "    spec_async_task_finished();\n";
		p: p . "    return NULL;\n";
		p: p . "}\n\n";
		p: p . "void spec_file_write_async(const char* path, const char* content, SpecClosure* on_success, SpecClosure* on_error) {\n";
		p: p . "    SpecFileTask* task = (SpecFileTask*)calloc(1, sizeof(SpecFileTask));\n";
		p: p . "    task->path = path ? strdup(path) : NULL;\n";
		p: p . "    task->content = content ? strdup(content) : NULL;\n";
		p: p . "    task->on_success_write = (SpecClosure*)spec_retain(on_success);\n";
		p: p . "    task->on_error = (SpecClosure*)spec_retain(on_error);\n";
		p: p . "    spec_async_task_started();\n";
		p: p . "    pthread_t tid;\n";
		p: p . "    pthread_create(&tid, NULL, spec_file_write_worker, task);\n";
		p: p . "    pthread_detach(tid);\n";
		p: p . "}\n\n";
		p: p . "bool spec_file_exists(const char* path) {\n";
