		p: p . "}\n";
		p: p . "/* Thread-Safe Spec Dynamic Array */\n";
		p: p . "#define SPEC_ELEM_NONE 0\n";
		p: p . "#define SPEC_ELEM_OBJECT 1\n";
		p: p . "typedef struct {\n";
