		p: p . "/* String: the managed string type (initially char*, transitions to SpecBuf) */\n";
		p: p . "typedef SpecBuf* String;\n\n";
		p: p . "/* Unified Growable Buffer: elem_size=1 for bytes, 8 for pointers */\n";
		p: p . "typedef struct SpecBuf {\n";
