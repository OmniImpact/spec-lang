		p: p . "}\n";
		p: p . "/* Thread-Safe Spec Hash Map (64-Bucket FNV-1a Hash Table) */\n";
		p: p . "#define SPEC_MAP_BUCKETS 64\n";
		p: p . "typedef struct SpecMapEntry {\n";
		p: p . "    char* key;\n";
		p: p . "    void* value;\n";
		p: p . "    bool is_str;\n";
		p: p . "    struct SpecMapEntry* next;\n";
		p: p . "} SpecMapEntry;\n\n";
		p: p . "typedef struct {\n";
		p: p . "    SpecMapEntry* buckets[SPEC_MAP_BUCKETS];\n";
		p: p . "    size_t length;\n";
		p: p . "    int val_kind;\n";
		p: p . "    pthread_mutex_t lock;\n";
		p: p . "} SpecMap;\n\n";
		p: p . "static inline size_t spec_hash_key(const char* key) {\n";
		p: p . "    size_t h = 1469598103934665603ULL;\n";
		p: p . "    while (*key) {\n";
		p: p . "        h ^= (unsigned char)(*key++);\n";
		p: p . "        h *= 1099511628211ULL;\n";
		p: p . "    }\n";
		p: p . "    return h & (SPEC_MAP_BUCKETS - 1);\n";
		p: p . "}\n\n";
		p: p . "void spec_map_destroy(void* self) {\n";
		p: p . "    SpecMap* m = (SpecMap*)self;\n";
		p: p . "    if (m) {\n";
		p: p . "        pthread_mutex_destroy(&m->lock);\n";
		p: p . "        for (size_t i = 0; i < SPEC_MAP_BUCKETS; i++) {\n";
		p: p . "            SpecMapEntry* curr = m->buckets[i];\n";
		p: p . "            while (curr) {\n";
		p: p . "                SpecMapEntry* next = curr->next;\n";
		p: p . "                if (curr->key) free(curr->key);\n";
		p: p . "                if (curr->is_str && curr->value) free(curr->value);\n";
		p: p . "                else if (m->val_kind == SPEC_ELEM_OBJECT && curr->value) spec_release(curr->value);\n";
		p: p . "                free(curr);\n";
		p: p . "                curr = next;\n";
		p: p . "            }\n";
		p: p . "        }\n";
		p: p . "    }\n";
