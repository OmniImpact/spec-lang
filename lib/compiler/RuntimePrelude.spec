		p: p . "    }\n";
		p: p . "    pthread_mutex_unlock(&a->lock);\n";
		p: p . "    return removed;\n";
		p: p . "}\n\n";
		p: p . "SpecArray* spec_array_slice(SpecArray* a, long long start, long long end) {\n";
		p: p . "    SpecArray* res = spec_array_new_kind(a ? a->elem_kind : SPEC_ELEM_NONE);\n";
