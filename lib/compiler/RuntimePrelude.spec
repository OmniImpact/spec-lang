		p: p . "}\n\n";
		p: p . "/* Spec Async Task Manager */\n";
		p: p . "static int spec_in_flight_tasks = 0;\n";
		p: p . "static pthread_mutex_t spec_task_mutex = PTHREAD_MUTEX_INITIALIZER;\n";
		p: p . "static pthread_cond_t spec_task_cond = PTHREAD_COND_INITIALIZER;\n\n";

		p: p . "void spec_async_task_started(void) {\n";
		p: p . "    pthread_mutex_lock(&spec_task_mutex);\n";
		p: p . "    spec_in_flight_tasks++;\n";
		p: p . "    pthread_mutex_unlock(&spec_task_mutex);\n";
		p: p . "}\n\n";
		p: p . "void spec_async_task_finished(void) {\n";
		p: p . "    pthread_mutex_lock(&spec_task_mutex);\n";
		p: p . "    spec_in_flight_tasks--;\n";
		p: p . "    if (spec_in_flight_tasks <= 0) {\n";
		p: p . "        spec_in_flight_tasks = 0;\n";
		p: p . "        pthread_cond_broadcast(&spec_task_cond);\n";
		p: p . "    }\n";
		p: p . "    pthread_mutex_unlock(&spec_task_mutex);\n";
		p: p . "}\n\n";
		p: p . "void spec_drain_async_tasks(void) {\n";
