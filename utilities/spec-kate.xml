<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">
<!-- Syntax highlighting definition for the Spec Programming Language (*.spec) -->
<!-- v3: the post-flip language — if/else are methods (removed as keywords); -->
<!-- the Loops control-flow constructs highlight as builtins; triple-quoted -->
<!-- raw strings and backtick templates with ${...} interpolation. -->
<language name="Spec" version="3" kateversion="5.0" section="Sources" extensions="*.spec;*.SPEC" mimetype="text/x-spec" priority="10" author="Spec Language Team" license="MIT">
  <highlighting>
    <list name="keywords">
      <item>local</item>
      <item>contained</item>
      <item>replace</item>
      <item>merge</item>
      <item>held</item>
      <item>is</item>
      <item>as</item>
      <item>of</item>
      <item>to</item>
      <item>return</item>
      <item>when</item>
      <item>self</item>
    </list>
    <list name="types">
      <item>String</item>
      <item>Int</item>
      <item>Byte</item>
      <item>Float</item>
      <item>Boolean</item>
      <item>Array</item>
      <item>List</item>
      <item>Map</item>
      <item>Any</item>
      <item>Function</item>
      <item>Enum</item>
      <item>Class</item>
    </list>
    <list name="constants">
      <item>true</item>
      <item>false</item>
    </list>
    <!-- The Loops provider's constructs and the container callbacks: bare
         calls, highlighted as builtins (they are methods, not keywords). -->
    <list name="control">
      <item>while</item>
      <item>until</item>
      <item>repeat</item>
      <item>loop</item>
      <item>run</item>
      <item>each</item>
      <item>map</item>
      <item>fold</item>
      <item>filter</item>
    </list>
    <list name="std">
      <item>base</item>
      <item>io</item>
      <item>core</item>
      <item>struct</item>
      <item>math</item>
      <item>iterator</item>
      <item>sys</item>
      <item>Conditional</item>
      <item>Loops</item>
      <item>Output</item>
      <item>Input</item>
      <item>Stderr</item>
      <item>File</item>
      <item>Process</item>
      <item>Math</item>
      <item>Buf</item>
      <item>Dir</item>
      <item>Ansi</item>
      <item>Parallel</item>
      <item>Error</item>
      <item>Reflection</item>
      <item>Loop</item>
      <item>LoopControl</item>
      <item>LoopCallback</item>
      <item>InputHandler</item>
    </list>

    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>

        <!-- Comments: ## doc, #! shebang/package/doc, # line -->
        <Detect2Chars attribute="SpecDoc" context="SpecDocComment" char="#" char1="#"/>
        <Detect2Chars attribute="SpecDoc" context="SpecDocComment" char="#" char1="!"/>
        <DetectChar attribute="Comment" context="Comment" char="#"/>

        <!-- Strings: "text", 'raw', '''heredoc''', `template` -->
        <!-- The ''' heredoc must match BEFORE the plain quote: '' is the
             valid empty-string literal, not a heredoc opener. -->
        <Detect3Chars attribute="String" context="HeredocString" char="&apos;" char1="&apos;" char2="&apos;"/>
        <DetectChar attribute="String" context="DoubleQuoteString" char="&quot;"/>
        <DetectChar attribute="String" context="TemplateString" char="`"/>
        <DetectChar attribute="String" context="SingleQuoteString" char="'"/>

        <!-- Numbers -->
        <Float attribute="Float" context="#stay"/>
        <Int attribute="Decimal" context="#stay"/>

        <!-- Keywords & Types -->
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Data Type" context="#stay" String="types"/>
        <keyword attribute="Constant" context="#stay" String="constants"/>
        <keyword attribute="Control" context="#stay" String="control"/>
        <keyword attribute="Standard Package" context="#stay" String="std"/>

        <!-- Operators and Delimiters -->
        <AnyChar attribute="Operator" context="#stay" String=":=+*/%&lt;&gt;!-."/>
        <AnyChar attribute="Delimiter" context="#stay" String="{}()[],;"/>
      </context>

      <!-- SpecDoc comment -->
      <context name="SpecDocComment" attribute="SpecDoc" lineEndContext="#pop">
        <DetectSpaces/>
        <IncludeRules context="##Comments"/>
      </context>

      <!-- Single line comment -->
      <context name="Comment" attribute="Comment" lineEndContext="#pop">
        <DetectSpaces/>
        <IncludeRules context="##Comments"/>
      </context>

      <!-- Double-quoted string with whitespace escapes -->
      <context name="DoubleQuoteString" attribute="String" lineEndContext="#pop">
        <LineContinue attribute="String" context="#stay"/>
        <HlCStringChar attribute="String Char" context="#stay"/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>

      <!-- Triple-quoted raw heredoc: no escapes, ends at ''' -->
      <context name="HeredocString" attribute="String" lineEndContext="#stay">
        <Detect3Chars attribute="String" context="#pop" char="&apos;" char1="&apos;" char2="&apos;"/>
        <DetectChar attribute="String Char" context="#stay" char="\"/>
      </context>

      <!-- Backtick template with ${expr} interpolation -->
      <context name="TemplateString" attribute="String" lineEndContext="#pop">
        <LineContinue attribute="String" context="#stay"/>
        <Detect2Chars attribute="String Char" context="TemplateInterp" char="$" char1="{"/>
        <DetectChar attribute="String" context="#pop" char="`"/>
      </context>
      <context name="TemplateInterp" attribute="Operator" lineEndContext="#pop">
        <IncludeRules context="Normal"/>
        <DetectChar attribute="Operator" context="#pop" char="}"/>
      </context>

      <!-- Single-quoted raw string -->
      <context name="SingleQuoteString" attribute="String" lineEndContext="#pop">
        <LineContinue attribute="String" context="#stay"/>
        <Detect2Chars attribute="String Char" context="#stay" char="\" char1="'"/>
        <Detect2Chars attribute="String Char" context="#stay" char="\" char1="\"/>
        <DetectChar attribute="String" context="#pop" char="'"/>
      </context>
    </contexts>

    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword" bold="1"/>
      <itemData name="Data Type" defStyleNum="dsDataType"/>
      <itemData name="Constant" defStyleNum="dsConstant"/>
      <itemData name="Control" defStyleNum="dsFunction"/>
      <itemData name="Standard Package" defStyleNum="dsBuiltIn"/>
      <itemData name="Decimal" defStyleNum="dsDecVal"/>
      <itemData name="Float" defStyleNum="dsFloat"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="String Char" defStyleNum="dsSpecialChar"/>
      <itemData name="Comment" defStyleNum="dsComment" italic="1"/>
      <itemData name="SpecDoc" defStyleNum="dsDocumentation" italic="1"/>
      <itemData name="Operator" defStyleNum="dsOperator"/>
      <itemData name="Delimiter" defStyleNum="dsDelimiter"/>
    </itemDatas>
  </highlighting>
  <general>
    <comments>
      <comment name="singleLine" value="#"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>
</language>
