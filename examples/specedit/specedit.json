{
  "name": "specedit",
  "version": "0.1.0",
  "description": "Resolution-independent text editor built on Suit, Sew, Fabric, and Scrap (MVVM)",
  "icon": "resources/icons/app-icon.svg",
  "category": "Utility",
  "file_extensions": [
    { "ext": ".spec", "mime": "text/x-spec", "default": true },
    ".txt",
    ".md",
    ".json",
    ".c",
    ".h",
    ".cpp",
    ".hpp",
    ".py",
    ".java",
    ".rs",
    ".rb",
    ".js",
    ".mjs",
    ".cjs",
    ".jsx",
    ".kt",
    ".kts",
    ".css",
    ".cs",
    ".php",
    ".sql",
    ".html",
    ".htm",
    ".xml",
    ".svg"
  ],
  "source": "src/SpecEdit.spec",
  "source_dirs": [
    "src",
    "../../spec"
  ],
  "output": "../../bin/specedit",
  "bundled": [
    { "src": "resources", "dest": "resources" }
  ]
}
