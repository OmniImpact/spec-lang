{
  "usage": "specserv [options]",
  "options": [
    {
      "short": "c",
      "long": "config",
      "type": "string",
      "default": "specserv.json",
      "arg": "path",
      "description": "Path to specserv JSON config file"
    },
    {
      "long": "control-port",
      "type": "int",
      "default": "47320",
      "arg": "port",
      "description": "Local TCP control socket port"
    },
    {
      "long": "log-file",
      "type": "string",
      "arg": "path",
      "description": "Optional file path to append request logs"
    },
    {
      "short": "h",
      "long": "help",
      "type": "bool",
      "description": "Show this help message"
    }
  ]
}
