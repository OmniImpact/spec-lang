)spec_alloc(sizeof(SpecArray), spec_array_destroy);\0A    a->items = NULL;\0A    a->length = 0;\0A    a->capacity = 0;\0A    a->elem_kind = kind;\0A    a->frozen = false;\0A    pthread_mutexattr_t attr;\0A    pthread_mutexattr_init(&attr);\0A    pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);\0A    pthread_mutex_init(&a->lock, &attr);\0A    pthread_mutexattr_destroy(&attr);\0A    return a;\0A}\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A/* Thread-Safe Spec Hash Map (FNV-1a / splitmix64, chained, growing power-of-two table) */\0A#define SPEC_MAP_INITIAL_BUCKETS 8\0A#define SPEC_KEY_STRING 0\0A#define SPEC_KEY_INT    1\0A#define SPEC_KEY_FLOAT  2\0A#define SPEC_KEY_OBJECT 3\0A\0Astatic inline uint64_t spec_double_to_u64(double d) {\0A    if (d == 0.0) d = 0.0;\0A    uint64_t u = 0;\0A    memcpy(&u, &d, sizeof(u));\0A    return u;\0A}\0A\0Astatic inline double spec_u64_to_double(uint64_t u) {\0A    double d = 0.0;\0A    memcpy(&d, &u, sizeof(d));\0A    return d;\0A}\0A\0Atypedef struct SpecMapEntry {\0A    union {\0A        char* key;\0A        uint64_t key_bits;\0A    };\0A    void* value;\0A    bool is_str;\0A    struct SpecMapEntry* next;\0A} SpecMapEntry;\0A\0Atypedef struct SpecMap {\0A    SpecMapEntry** buckets;\0A    size_t nbuckets;\0A    size_t length;\0A    int key_kind;\0A    int val_kind;\0A    bool frozen;\0A    pthread_mutex_t lock;\0A} SpecMap;\0A\0Astatic inline size_t spec_hash_key(const char* key, size_t nbuckets) {\0A    size_t h = 1469598103934665603ULL;\0A    while (*key) {\0A        h ^= (unsigned char)(*key++);\0A        h *= 1099511628211ULL;\0A    }\0A    return h & (nbuckets - 1);\0A}\0A\0Astatic inline size_t spec_hash_u64(uint64_t k, size_t nbuckets) {\0A    k = (k ^ (k >> 30)) * 0xbf58476d1ce4e5b9ULL;\0A    k = (k ^ (k >> 27)) * 0x94d049bb133111ebULL;\0A    k = k ^ (k >> 31);\0A    return (size_t)k & (nbuckets - 1);\0A}\0A\0A/* Doubles the table once the load factor reaches 1, so chains stay short\0A   however large the map grows