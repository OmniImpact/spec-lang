s the opaque handle the runner signatures\0A   reference. */\0Atypedef struct Loop Loop;\0A\0A\0A\0A/* Spec Async Task Manager */\0Astatic int spec_in_flight_tasks = 0;\0Astatic pthread_mutex_t spec_task_mutex = PTHREAD_MUTEX_INITIALIZER;\0Astatic pthread_cond_t spec_task_cond = PTHREAD_COND_INITIALIZER;\0A\0A\0A\0A\0A/* File Package Primitives with Callbacks and Async Worker Support */\0Astatic inline void spec_call_closure_0(SpecClosure* cls) {\0A    if (cls && cls->fn) { ((void (*)(void*))cls->fn)(cls->env); }\0A}\0A\0Astatic inline void spec_call_closure_int(SpecClosure* cls, long long arg1) {\0A    if (cls && cls->fn) { ((void (*)(void*, long long))cls->fn)(cls->env, arg1); }\0A}\0A\0Astatic inline void spec_call_closure_str(SpecClosure* cls, void* arg1) {\0A    if (cls && cls->fn) { ((void (*)(void*, void*))cls->fn)(cls->env, arg1); }\0A}\0A\0Astatic inline void _spec_emit_str_error(SpecClosure* on_error, const char* msg) {\0A    if (on_error && on_error->fn) {\0A        const char* m = msg ? msg : \22Unknown error\22;\0A        String s = spec_string_from_bytes(m, strlen(m));\0A        spec_call_closure_str(on_error, s);\0A        spec_release(s);\0A    }\0A}\0A\0A/* String: the managed string type (initially char*, transitions to SpecBuf) */\0Atypedef SpecBuf* String;\0A\0A/* Unified Growable Buffer: elem_size=1 for bytes, 8 for pointers */\0Atypedef struct SpecBuf {\0A    void* data;\0A    size_t length;\0A    size_t capacity;\0A    size_t elem_size;\0A    int elem_kind;\0A} SpecBuf;\0A\0A\0A/* The compilation arena: bump allocation over growing blocks. */\0Atypedef struct ArenaBlock {\0A    struct ArenaBlock* next;\0A    size_t used;\0A    size_t cap;\0A    char* data;\0A} ArenaBlock;\0A\0Atypedef struct SpecArena {\0A    ArenaBlock* head;\0A    size_t used;\0A} SpecArena;\0A\0A#define ARENA_BLOCK_SIZE (2 * 1024 * 1024)\0A\0Astatic ArenaBlock* arena_block_new(size_t cap) {\0A    ArenaBlock* b = (ArenaBlock*)malloc(sizeof(ArenaBlock) + cap);\0A    if (!b) { fprintf(stderr, \22[Spec Panic] Out of memory\5Cn\22); exit(1); }\0A    b->data = (char*)(b + 1);\0A    b->cap = cap;\0A    b->used = 0;\0A    b->next = NULL;\0A    return b;\0A}\0A\0Astatic void* spec_arena_alloc(SpecArena* a, size_t size) {\0A    size = (size + 15) & ~(size_t)15;\0A    if (!a->head || a->head->used + size > a->head->cap) {\0A        size_t cap = ARENA_BLOCK_SIZE;\0A        if (size > cap) cap = size;\0A        ArenaBlock* nb = arena_block_new(cap);\0A        nb->next = a->head;\0A        a->head = nb;\0A    }\0A    void* p = a->head->data + a->head->used;\0A    a->head->used += size;\0A    a->used += size;\0A    memset(p, 0, size);\0A    return p;\0A}\0A\0A\0A\0A/* Object arena: header-carrying allocations from arena memory. Refcounts\0A   guard aliasing during compilation; the pending finalizers (field\0A   releases) run at drain, then the blocks free wholesale. */\0Atypedef struct ArenaFinalizer {\0A    struct ArenaFinalizer* next;\0A    SpecHeader* header;\0A} ArenaFinalizer;\0A\0Astatic pthread_mutex_t _spec_arena_mutex = PTHREAD_MUTEX_INITIALIZER;\0Astatic ArenaFinalizer* _spec_object_arena_finalizers = NULL;\0Astatic SpecArena _spec_object_arena = { NULL, 0 };\0A\0Avoid spec_arena_drain_objects(void);\0A\0A\0A\0A\0A\0Astatic void spec_buf_grow(SpecBuf* b, size_t needed) {\0A    size_t need = needed + ((b->elem_size == 1) ? 1 : 0);\0A    if (b->length + need <= b->capacity) return;\0A    size_t cap = (b->capacity == 0) ? 16 : b->capacity * 2;\0A    while (cap < b->length + need) cap *= 2;\0A    if (cap > SIZE_MAX / b->elem_size) spec_panic(\22Buffer capacity overflow\22);\0A    b->data = spec_xrealloc(b->data, cap * b->elem_size);\0A    b->capacity = cap;\0A}\0A\0A\0A\0A\0A\0A\0A\0A/* String: managed string backed by SpecBuf (elem_size=1) */\0Atypedef SpecBuf* String;\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A/* Spec Byte Buffer: compact [Byte] storage (the string builder floor) */\0Atypedef struct SpecByteBuffer {\0A    unsigned char* data;\0A    size_t length;\0A    size_t capacity;\0A} SpecByteBuffer;\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A/* Spec Vec: lean pointer-vector skeleton for non-byte [T] (methods in a later phase) */\0Atypedef struct SpecVec {\0A    void** items;\0A    size_t length;\0A    size_t capacity;\0A    int elem_kind;\0A} SpecVec;\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0A\0Atypedef struct {\0A    String path;\0A    String content;\0A    String def;\0A    SpecClosure* on_success_read;\0A    SpecClosure* on_success_write;\0A    SpecClosure* on_error;\0A} SpecFileTask;\0A\0Astatic void* spec_file_read_worker(void* arg) {\0A    SpecFileTask* task = (SpecFileTask*)arg;\0A    String res = spec_file_read(task->path, task->def, task->on_success_read, task->on_error);\0A    if (res) spec_release(res);\0A    if (task->path) spec_release(task->path);\0A    if (task->def) spec_release(task->def);\0A    if (task->on_success_read) spec_release(task->on_success_read);\0A    if (task->on_error) spec_release(task->on_error);\0A    free(task);\0A    spec_pool_thread_cleanup();\0A    spec_async_task_finished();\0A    return NULL;\0A}\0A\0A\0Astatic void* spec_file_write_worker(void* arg) {\0A    SpecFileTask* task = (SpecFileTask*)arg;\0A    spec_file_write(task->path, task->content, task->on_success_write, task->on_error);\0A    if (task->path) spec_release(task->path);\0A    if (task->content) spec_release(task->content);\0A    if (task->on_success_write) spec_release(task->on_success_write);\0A    if (task->on_error) spec_release(task->on_error);\0A    free(task);\0A    spec_pool_thread_cleanup();\0A    spec_async_task_finished();\0A    return NULL;\0A}\0A\0A\0A/* Process Package Primitives */\0A\0A\0A\0A\0A/* Math Package Primitives */\0Astatic inline long long spec_math_abs_int(long long v) { return v < 0 ? -v : v; }\0A\0A\0A/* Integer Base Conversion */\0A\0A/* Terminal Metrics */\0A\0A\0A/* Atomic Slots: dynamically growing chunked table.\0A   Starts low (0 chunks allocated) and allocates chunks on demand.\0A   Level 0 holds 16 slots; level k (k >= 1) holds 2^(k+3) slots.\0A   Total addressable capacity exceeds 2^60 slots with zero reallocations,\0A   so slot pointers are permanent and all reads/writes are lock-free. */\0Astatic _Atomic(atomic_llong*) _spec_atomic_levels[64];\0Astatic pthread_mutex_t _spec_atomic_mutex = PTHREAD_MUTEX_INITIALIZER;\0A\0Astatic atomic_llong* spec_atomic_slot_ptr(long long slot) {\0A    if (slot < 0) {\0A        spec_panic_bounds(\22Atomic slot\22, slot, 0);\0A    }\0A    size_t level = 0;\0A    size_t offset = 0;\0A    size_t chunk_size = 16;\0A    if (slot < 16) {\0A        level = 0;\0A        offset = (size_t)slot;\0A        chunk_size = 16;\0A    } else {\0A        int highest_bit = 63 - __builtin_clzll((unsigned long long)slot);\0A        level = (size_t)(highest_bit - 3);\0A        if (level >= 64) {\0A            spec_panic_bounds(\22Atomic slot index too large\22, slot, 0);\0A        }\0A        chunk_size = (size_t)1ULL << highest_bit;\0A        offset = (size_t)slot - chunk_size;\0A    }\0A\0A    atomic_llong* chunk = atomic_load_explicit(&_spec_atomic_levels[level], memory_order_acquire);\0A    if (!chunk) {\0A        pthread_mutex_lock(&_spec_atomic_mutex);\0A        chunk = atomic_load_explicit(&_spec_atomic_levels[level], memory_order_relaxed);\0A        if (!chunk) {\0A            chunk = (atomic_llong*)calloc(chunk_size, sizeof(atomic_llong));\0A            if (!chunk) { spec_panic(\22Out of memory allocating atomic slots\22); }\0A            atomic_store_explicit(&_spec_atomic_levels[level], chunk, memory_order_release);\0A        }\0A        pthread_mutex_unlock(&_spec_atomic_mutex);\0A    }\0A    return &chunk[offset];\0A}\0A\0A\0A\0A\0A\0A/* Parallel Fan-Out */\0Atypedef long long (*SpecWorkerFn)(void* env, long long idx, long long count);\0Atypedef struct { SpecWorkerFn fn; void* env; long long idx; long long count; } SpecParallelTask;\0A\0Astatic void* spec_parallel_worker(void* arg) {\0A    SpecParallelTask* t = (SpecParallelTask*)arg;\0A    spec_fast_random_seed(t->idx);\0A    long long r = t->fn(t->env, t->idx, t->count);\0A    free(t);\0A    spec_pool_thread_cleanup();\0A    return (void*)(intptr_t)r;\0A}\0A\0A\0A/* Type Name Introspection */\0A\0A/* Identity hash: a stable per-object value derived from the address\0A   (mixed so neighboring allocations differ). The default toString's\0A   hash component. */\0A\0A/* Held-member metadata: per-class held-member name\0A   tables, registered by the emitted Held Metadata section (the tables\0A   preserve declaration order \E2\80\94 the ordinal index). Field slots carry\0A   the once-guard accessor's address; function slots are NULL. The\0A   tentative array definition is completed by the generated registry,\0A   which always carries the {0,0,0,0} terminator. */\0Atypedef struct SpecHeldEntry {\0A    const char* type_name;\0A    const char* const* names;\0A    int count;\0A    void* (*const* getters)(void);\0A} SpecHeldEntry;\0Aextern const SpecHeldEntry spec_held_registry[];\0A\0Astatic const SpecHeldEntry* spec_held_entry_of(const void* obj) {\0A    if (!obj) return 0;\0A    const char* tn = *((const char**)obj);\0A    if (!tn) return 0;\0A    for (int i = 0; spec_held_registry[i].type_name; i++) {\0A        if (strcmp(spec_held_registry[i].type_name, tn) == 0) return &spec_held_registry[i];\0A    }\0A    return 0;\0A}\0A\0A\0A\0A\0A/* The ordinal scan : the first held-FIELD index whose\0A   lazily-constructed instance is the object itself. The desugared\0A   enum variants are held singletons in declaration order, so this is\0A   the variant's ordinal. Calling it initializes the class's held\0A   singletons (the once-guards are idempotent). -1 when the class\0A   holds no fields or the object is not one of them. */\0A\0A/* Class Registry Introspection : the runtime reflection floor. The\0A   generator emits one SpecClassMeta per class (class order) into\0A   spec_class_registry; these helpers query that registry. Declared\0A   `static inline` and consumed by nobody until the wrapper methods\0A   land (the two-part landing): unused static inlines are never\0A   emitted, so the not-yet-defined registry extern cannot break a\0A   link in the interim. The floor is domain-neutral \E2\80\94 it describes\0A   classes and methods; conventions live in consumers. */\0Atypedef struct SpecMethodMeta {\0A    const char* name;\0A    void* fn;\0A    int flags;          /* bit 0: void return; bit 1: zero params */\0A    int line;\0A} SpecMethodMeta;\0A\0Atypedef struct SpecClassMeta {\0A    const char* name;\0A    const char* source_file;\0A    /* The pointee is const too: the emitted base arrays are\0A       `const char* const X_spec_bases[]`, so a plain `char**` here\0A       would discard a qualifier on every registry initializer. */\0A    const char* const* base_names;\0A    int base_count;\0A    void* (*construct)(void);\0A    const SpecMethodMeta* methods;\0A    int method_count;\0A} SpecClassMeta;\0A\0Aextern const SpecClassMeta* const spec_class_registry[];\0A/* Defined by the emitted registry (Land B). Declared here so the\0A   helpers compile; the inline bodies are never emitted while unconsumed,\0A   so no reference materializes until the definition exists. */\0Aint spec_class_registry_count(void);\0A\0Astatic inline const SpecClassMeta* spec_class_meta(int index) {\0A    if (index < 0 || index >= spec_class_registry_count()) return NULL;\0A    return spec_class_registry[index];\0A}\0A\0Astatic inline const SpecClassMeta* spec_class_find(const char* name) {\0A    if (!name) return NULL;\0A    for (int i = 0; i < spec_class_registry_count(); i++) {\0A        const SpecClassMeta* m = spec_class_registry[i];\0A        if (m && m->name && strcmp(m->name, name) == 0) return m;\0A    }\0A    return NULL;\0A}\0A\0A/* Own methods first, then up the base lattice \E2\80\94 inherited methods\0A   resolve through base_names, so invocation works on derived\0A   instances (prefix struct layout). */\0Astatic