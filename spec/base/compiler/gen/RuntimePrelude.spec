static inline SpecClosure* spec_closure_new(void* fn, void* env, void (*destroy_env)(void*)) {
    SpecClosure* c = (SpecClosure*)spec_alloc(sizeof(SpecClosure), spec_closure_destroy);
    c->fn = fn;
    c->env = env;
    c->destroy_env = destroy_env;
    return c;
}

