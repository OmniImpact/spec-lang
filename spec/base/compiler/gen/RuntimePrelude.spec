/* Spec Automated Reference Counting (ARC) Primitives */
#define SPEC_S_IMMORTAL 1u
#define SPEC_S_HASLEN 2u
typedef struct {
    _Atomic uint32_t ref_count;
    void (*destroy)(void*);
    _Atomic uint32_t sflags;
    uint32_t slen;
} SpecHeader;

#define SPEC_HEADER(obj) (((SpecHeader*)(obj)) - 1)

static inline void* spec_alloc(size_t size, void (*destroy)(void*)) {
    SpecHeader* h = (SpecHeader*)calloc(1, sizeof(SpecHeader) + size);
    if (!h) { fprintf(stderr, "[Spec Panic] Out of memory\n"); exit(1); }
    h->ref_count = 1;
    h->destroy = destroy;
    return (void*)(h + 1);
}

static inline void* spec_retain(void* obj) {
    if (!obj) return NULL;
    SpecHeader* h = SPEC_HEADER(obj);
    if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_IMMORTAL) return obj;
    atomic_fetch_add_explicit(&h->ref_count, 1, memory_order_relaxed);
    return obj;
}

static inline void spec_release(void* obj) {
    if (!obj) return;
    SpecHeader* h = SPEC_HEADER(obj);
    if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_IMMORTAL) return;
    if (atomic_load_explicit(&h->ref_count, memory_order_relaxed) == 0) { if (h->destroy) h->destroy(obj); return; }
    if (atomic_fetch_sub_explicit(&h->ref_count, 1, memory_order_acq_rel) == 1) {
        if (h->destroy) h->destroy(obj);
        free(h);
    }
}

static inline void* spec_assign(void** dest, void* src) {
    if (src) spec_retain(src);
    if (*dest) spec_release(*dest);
    *dest = src;
    return src;
}

static inline void* spec_assign_transfer(void** dest, void* src) {
    if (*dest) spec_release(*dest);
    *dest = src;
    return src;
}

static inline void spec_scope_cleanup(void* pptr) {
    void* obj = *(void**)pptr;
    if (obj) spec_release(obj);
}

#define SPEC_AUTO __attribute__((cleanup(spec_scope_cleanup)))

/* Spec String Core: refcounted, NUL-terminated, optionally interned.
   A String value is a char* into a spec_alloc block whose header carries
   a cached length and an immortal flag for interned literals. */
String spec_string_from_chars(const char* c) {
    if (!c) c = "";
    return spec_string_from_bytes(c, strlen(c));
}
#define SPEC_INTERN_BUCKETS 256
typedef struct SpecInternEntry {
    String s;
    struct SpecInternEntry* next;
} SpecInternEntry;
static SpecInternEntry* _spec_intern[SPEC_INTERN_BUCKETS];
static pthread_mutex_t _spec_intern_lock = PTHREAD_MUTEX_INITIALIZER;

static inline size_t spec_intern_bucket(const char* c) {
    size_t h = 1469598103934665603ULL;
    while (*c) { h ^= (unsigned char)(*c++); h *= 1099511628211ULL; }
    return h & (SPEC_INTERN_BUCKETS - 1);
}

String spec_string_intern(const char* c) {
    if (!c) c = "";
    size_t b = spec_intern_bucket(c);
    size_t n = strlen(c);
    pthread_mutex_lock(&_spec_intern_lock);
    SpecInternEntry* e = _spec_intern[b];
    while (e) {
        String es = (String)e->s;
        if (spec_string_bytes_equal(es, c, n)) { pthread_mutex_unlock(&_spec_intern_lock); return es; }
        e = e->next;
    }
    String s = spec_string_from_bytes(c, n);
    atomic_fetch_or_explicit(&SPEC_HEADER(s)->sflags, SPEC_S_IMMORTAL, memory_order_relaxed);
    e = (SpecInternEntry*)malloc(sizeof(SpecInternEntry));
    e->s = s;
    e->next = _spec_intern[b];
    _spec_intern[b] = e;
    pthread_mutex_unlock(&_spec_intern_lock);
    return s;
}
/* Claim pool: adopts ownership claims in read positions (call arguments,
   conditions, chain targets) and recycles them on eviction. A borrowed
   pointer stays valid until 32 further pool claims are made, which is
   far more than any single statement evaluates. */
#define SPEC_POOL_SLOTS 32
static void* _spec_pool[SPEC_POOL_SLOTS];
static size_t _spec_pool_next = 0;
static pthread_mutex_t _spec_pool_lock = PTHREAD_MUTEX_INITIALIZER;

void* spec_claim_pool(void* obj) {
    if (!obj) return NULL;
    pthread_mutex_lock(&_spec_pool_lock);
    size_t slot = _spec_pool_next;
    _spec_pool_next = (slot + 1) % SPEC_POOL_SLOTS;
    void* old = _spec_pool[slot];
    _spec_pool[slot] = obj;
    pthread_mutex_unlock(&_spec_pool_lock);
    if (old) spec_release(old);
    return obj;
}

