/* Atomic Slots: dynamically growing chunked table.
   Starts low (0 chunks allocated) and allocates chunks on demand.
   Level 0 holds 16 slots; level k (k >= 1) holds 2^(k+3) slots.
   Total addressable capacity exceeds 2^60 slots with zero reallocations,
   so slot pointers are permanent and all reads/writes are lock-free. */
static _Atomic(atomic_llong*) _spec_atomic_levels[64];
static pthread_mutex_t _spec_atomic_mutex = PTHREAD_MUTEX_INITIALIZER;

static atomic_llong* spec_atomic_slot_ptr(long long slot) {
    if (slot < 0) {
        spec_panic_bounds("Atomic slot", slot, 0);
    }
    size_t level = 0;
    size_t offset = 0;
    size_t chunk_size = 16;
    if (slot < 16) {
        level = 0;
        offset = (size_t)slot;
        chunk_size = 16;
    } else {
        int highest_bit = 63 - __builtin_clzll((unsigned long long)slot);
        level = (size_t)(highest_bit - 3);
        if (level >= 64) {
            spec_panic_bounds("Atomic slot index too large", slot, 0);
        }
        chunk_size = (size_t)1ULL << highest_bit;
        offset = (size_t)slot - chunk_size;
    }

    atomic_llong* chunk = atomic_load_explicit(&_spec_atomic_levels[level], memory_order_acquire);
    if (!chunk) {
        pthread_mutex_lock(&_spec_atomic_mutex);
        chunk = atomic_load_explicit(&_spec_atomic_levels[level], memory_order_relaxed);
        if (!chunk) {
            chunk = (atomic_llong*)calloc(chunk_size, sizeof(atomic_llong));
            if (!chunk) { spec_panic("Out of memory allocating atomic slots"); }
            atomic_store_explicit(&_spec_atomic_levels[level], chunk, memory_order_release);
        }
        pthread_mutex_unlock(&_spec_atomic_mutex);
    }
    return &chunk[offset];
}

long long spec_atomic_add(long long slot, long long v) {
    atomic_llong* p = spec_atomic_slot_ptr(slot);
    return atomic_fetch_add(p, v) + v;
}

long long spec_atomic_put(long long slot, long long v) {
    atomic_llong* p = spec_atomic_slot_ptr(slot);
    atomic_store(p, v);
    return v;
}

long long spec_atomic_get(long long slot) {
    atomic_llong* p = spec_atomic_slot_ptr(slot);
    return atomic_load(p);
}

/* Per-Thread RNG (xorshift64*, lock-free, self-seeding) */
static __thread unsigned long long _spec_rng_state = 0;

static unsigned long long spec_rng_next(void) {
    unsigned long long x = _spec_rng_state;
    x ^= x >> 12;
    x ^= x << 25;
    x ^= x >> 27;
    _spec_rng_state = x;
    return x * 0x2545F4914F6CDD1DULL;
}

void spec_fast_random_seed(long long idx) {
    _spec_rng_state = 0x9E3779B97F4A7C15ULL ^ ((unsigned long long)idx * 0xBF58476D1CE4E5B9ULL + 0x94D049BB133111EBULL);
    if (_spec_rng_state == 0) _spec_rng_state = 1;
    spec_rng_next();
    spec_rng_next();
    spec_rng_next();
}

double spec_fast_random(void) {
    if (_spec_rng_state == 0) spec_fast_random_seed(0x5DEECE66DULL);
    return (double)(spec_rng_next() >> 11) * (1.0 / 9007199254740992.0);
}

/* Parallel Fan-Out */
typedef long long (*SpecWorkerFn)(void* env, long long idx, long long count);
typedef struct { SpecWorkerFn fn; void* env; long long idx; long long count; } SpecParallelTask;

static void* spec_parallel_worker(void* arg) {
    SpecParallelTask* t = (SpecParallelTask*)arg;
    spec_fast_random_seed(t->idx);
    long long r = t->fn(t->env, t->idx, t->count);
    free(t);
    spec_pool_thread_cleanup();
    return (void*)(intptr_t)r;
}

long long spec_parallel_run(long long threads, long long iterations, void* worker_closure) {
    if (threads < 1) threads = 1;
    SpecClosure* cls = (SpecClosure*)worker_closure;
    if (!cls || !cls->fn) spec_panic("Parallel:run received null worker Function");
    pthread_t* tids = (pthread_t*)spec_xmalloc(sizeof(pthread_t) * (size_t)threads);
    bool* spawned = (bool*)spec_xmalloc(sizeof(bool) * (size_t)threads);
    long long total = 0;
    long long base = iterations / threads;
    long long rem = iterations % threads;
    for (long long i = 0; i < threads; i++) {
        SpecParallelTask* t = (SpecParallelTask*)spec_xmalloc(sizeof(SpecParallelTask));
        t->fn = (SpecWorkerFn)cls->fn;
        t->env = cls->env;
        t->idx = i;
        t->count = base + (i < rem ? 1 : 0);
        spawned[i] = (pthread_create(&tids[i], NULL, spec_parallel_worker, t) == 0);
        if (!spawned[i]) {
            total += (long long)(intptr_t)spec_parallel_worker(t);
        }
    }
    for (long long i = 0; i < threads; i++) {
        if (!spawned[i]) continue;
        void* ret = NULL;
        pthread_join(tids[i], &ret);
        total += (long long)(intptr_t)ret;
    }
    free(tids);
    free(spawned);
    return total;
}

/* Type Name Introspection */
String spec_type_name(const void* obj) {
    if (!obj) return spec_string_intern("");
    return spec_string_intern(*((const char**)obj));
}

/* Identity hash: a stable per-object value derived from the address
   (mixed so neighboring allocations differ). The default toString's
   hash component. */
long long spec_object_hash(const void* obj) {
    if (!obj) return 0;
    unsigned long long h = (unsigned long long)(intptr_t)obj;
    h ^= h >> 33;
    h *= 0xff51afd7ed558ccdULL;
    h ^= h >> 33;
    return (long long)h;
}

/* Reference identity (the Introspection floor): pointer equality —
   the runtime's identity notion (held singletons and enum variants
   are distinct live instances, so address equality is the test). */
static inline bool spec_same_ref(const void* a, const void* b) {
    return a == b;
}

/* Held-member metadata: per-class held-member name
   tables, registered by the emitted Held Metadata section (the tables
   preserve declaration order — the ordinal index). Field slots carry
   the once-guard accessor's address; function slots are NULL. The
   tentative array definition is completed by the generated registry,
   which always carries the {0,0,0,0} terminator. */
typedef struct SpecHeldEntry {
    const char* type_name;
    const char* const* names;
    int count;
    void* (*const* getters)(void);
} SpecHeldEntry;
static const SpecHeldEntry spec_held_registry[];

static const SpecHeldEntry* spec_held_entry_of(const void* obj) {
    if (!obj) return 0;
    const char* tn = *((const char**)obj);
    if (!tn) return 0;
    for (int i = 0; spec_held_registry[i].type_name; i++) {
        if (strcmp(spec_held_registry[i].type_name, tn) == 0) return &spec_held_registry[i];
    }
    return 0;
}

long long spec_held_count(const void* obj) {
    const SpecHeldEntry* e = spec_held_entry_of(obj);
    return e ? (long long)e->count : 0;
}

String spec_held_name(const void* obj, long long index) {
    const SpecHeldEntry* e = spec_held_entry_of(obj);
    if (!e || index < 0 || index >= (long long)e->count) return spec_string_intern("");
    return spec_string_intern(e->names[index]);
}

bool spec_has_held(const void* obj, String name) {
    const SpecHeldEntry* e = spec_held_entry_of(obj);
    if (!e) return false;
    for (int i = 0; i < e->count; i++) {
        if (spec_string_equals(spec_string_intern(e->names[i]), name)) return true;
    }
    return false;
}

/* The ordinal scan : the first held-FIELD index whose
   lazily-constructed instance is the object itself. The desugared
   enum variants are held singletons in declaration order, so this is
   the variant's ordinal. Calling it initializes the class's held
   singletons (the once-guards are idempotent). -1 when the class
   holds no fields or the object is not one of them. */
long long spec_held_index_of(const void* obj) {
    const SpecHeldEntry* e = spec_held_entry_of(obj);
    if (!e || !e->getters) return -1;
    for (int i = 0; i < e->count; i++) {
        if (e->getters[i]) {
            void* inst = e->getters[i]();
            bool hit = (inst == (void*)obj);
            spec_release(inst);
            if (hit) return (long long)i;
        }
    }
    return -1;
}

/* Class Registry Introspection : the runtime reflection floor. The
   generator emits one SpecClassMeta per class (class order) into
   spec_class_registry; these helpers query that registry. Declared
   `static inline` and consumed by nobody until the wrapper methods
   land (the two-part landing): unused static inlines are never
   emitted, so the not-yet-defined registry extern cannot break a
   link in the interim. The floor is domain-neutral — it describes
   classes and methods; conventions live in consumers. */
typedef struct SpecMethodMeta {
    const char* name;
    void* fn;
    int flags;          /* bit 0: void return; bit 1: zero params */
    int line;
} SpecMethodMeta;

typedef struct SpecClassMeta {
    const char* name;
    const char* source_file;
    /* The pointee is const too: the emitted base arrays are
       `const char* const X_spec_bases[]`, so a plain `char**` here
       would discard a qualifier on every registry initializer. */
    const char* const* base_names;
    int base_count;
    void* (*construct)(void);
    const SpecMethodMeta* methods;
    int method_count;
} SpecClassMeta;

extern const SpecClassMeta* const spec_class_registry[];
/* Defined by the emitted registry (Land B). Declared here so the
   helpers compile; the inline bodies are never emitted while unconsumed,
   so no reference materializes until the definition exists. */
int spec_class_registry_count(void);

static inline const SpecClassMeta* spec_class_meta(int index) {
    if (index < 0 || index >= spec_class_registry_count()) return NULL;
    return spec_class_registry[index];
}

static inline const SpecClassMeta* spec_class_find(const char* name) {
    if (!name) return NULL;
    for (int i = 0; i < spec_class_registry_count(); i++) {
        const SpecClassMeta* m = spec_class_registry[i];
        if (m && m->name && strcmp(m->name, name) == 0) return m;
    }
    return NULL;
}

/* Own methods first, then up the base lattice — inherited methods
   resolve through base_names, so invocation works on derived
   instances (prefix struct layout). */
static inline const SpecMethodMeta* spec_class_find_method(
        const SpecClassMeta* cls, const char* name) {
    if (!cls || !name) return NULL;
    for (int i = 0; i < cls->method_count; i++) {
        if (strcmp(cls->methods[i].name, name) == 0) return &cls->methods[i];
    }
    for (int b = 0; b < cls->base_count; b++) {
        const SpecClassMeta* base = spec_class_find(cls->base_names[b]);
        const SpecMethodMeta* m = spec_class_find_method(base, name);
        if (m) return m;
    }
    return NULL;
}

static inline void* spec_class_construct_by_meta(const SpecClassMeta* cls) {
    if (!cls || !cls->construct) return NULL;
    return cls->construct();
}

/* The v1 invoke contract: void, zero parameters. Anything else is a
   loud panic — the bounds-check philosophy, never a silent miss. */
static inline void spec_invoke_void_by_meta(void* instance,
        const SpecMethodMeta* m) {
    /* The invoke contract: zero parameters, and a method whose C
       emission is void — declared Void (flag 1) or the paramless
       Function type (flag 4, the empty function: a distinct non-void
       type whose C resolution is void). Anything else is a loud
       panic — never a silent miss. */
    if (!m || !m->fn || !(m->flags & 2) || !(m->flags & 5)) {
        spec_panic("Introspection:invoke supports void zero-parameter methods only");
    }
    ((void (*)(void*))m->fn)(instance);
}

/* Lattice membership: whether [cls] inherits [base] anywhere up its
   base_names lattice. The class lattice is a DAG (diamonds are legal
   with the override discipline), so branches re-converge — the walk is
   depth-capped at 64, the documented exception to terminate-on-revisit:
   a depth hit means a loop in the base lattice, not a language limit. */
static int spec_class_extends_walk(const SpecClassMeta* m, const char* base, int depth) {
    if (!m || depth > 64) return 0;
    for (int b = 0; b < m->base_count; b++) {
        if (strcmp(m->base_names[b], base) == 0) return 1;
        const SpecClassMeta* bm = spec_class_find(m->base_names[b]);
        if (bm && spec_class_extends_walk(bm, base, depth + 1)) return 1;
    }
    return 0;
}

int spec_class_extends(String cls, String base) {
    /* Sysinternal bindings pass String objects as-is — convert to the
       C strings the registry lookup needs (the stringCopy pattern). */
    const SpecClassMeta* m = spec_class_find(spec_buf_to_cstring(cls));
    return spec_class_extends_walk(m, spec_buf_to_cstring(base), 0);
}

String spec_type_identity(const void* obj) {
    return spec_type_name(obj);
}

/* Name-level registry queries: real functions — the registry definition
   is emitted by the generator in the same translation unit, so these
   link. base:sys:Introspection wrapper methods bind here by the naming
   convention (classNames -> spec_class_names). String values are
   interned; object-kind arrays retain them harmlessly. */
SpecArray* spec_class_names(void) {
    SpecArray* out = spec_array_new_object();
    for (int i = 0; i < spec_class_registry_count(); i++) {
        const SpecClassMeta* m = spec_class_registry[i];
        if (m && m->name) spec_array_add(out, (void*)spec_string_intern(m->name));
    }
    return out;
}

/* Bases first so a child's override supersedes the parent's name in the
   collected list; duplicates collapse by content compare. */
static void spec_method_names_collect(SpecArray* out, const SpecClassMeta* cls) {
    if (!cls) return;
    for (int b = cls->base_count - 1; b >= 0; b--) {
        spec_method_names_collect(out, spec_class_find(cls->base_names[b]));
    }
    for (int i = 0; i < cls->method_count; i++) {
        String nm = spec_string_intern(cls->methods[i].name);
        bool dup = false;
        for (long long j = 0; j < spec_array_length(out); j++) {
            String seen = (String)(intptr_t)spec_array_get(out, j);
            if (seen && spec_string_equals(seen, nm)) { dup = true; break; }
        }
        if (!dup) spec_array_add(out, (void*)nm);
    }
}

SpecArray* spec_method_names(String cls) {
    /* Sysinternal bindings pass String objects as-is — convert to the
       C string the registry lookup needs (the stringCopy pattern). */
    SpecArray* out = spec_array_new_object();
    spec_method_names_collect(out, spec_class_find(spec_buf_to_cstring(cls)));
    return out;
}

const char* spec_class_source_file_raw(const char* cls) {
    const SpecClassMeta* m = spec_class_find(cls);
    return (m && m->source_file) ? m->source_file : "";
}

/* The wrapper's declared return is String (SpecBuf*) — return an
   interned copy, never the raw literal: the binding retains its
   return, and a retain on a non-object header corrupts the pool. */
String spec_class_source_file(String cls) {
    const SpecClassMeta* m = spec_class_find(spec_buf_to_cstring(cls));
    return spec_string_intern((m && m->source_file) ? m->source_file : "");
}

int spec_has_method(String cls, String method) {
    const SpecClassMeta* m = spec_class_find(spec_buf_to_cstring(cls));
    return spec_class_find_method(m, spec_buf_to_cstring(method)) ? 1 : 0;
}

void* spec_instantiate(String cls) {
    const SpecClassMeta* m = spec_class_find(spec_buf_to_cstring(cls));
    if (!m) spec_panic("Introspection:instantiate — unknown class");
    if (!m->construct) spec_panic("Introspection:instantiate — class init requires arguments");
    return m->construct();
}

void spec_invoke_void_by_name(void* instance, String method) {
    if (!instance) spec_panic("Introspection:invoke on a null instance");
    const char* tn = *((const char**)instance);
    const SpecClassMeta* m = spec_class_find(tn);
    if (!m) spec_panic("Introspection:invoke — instance of an unregistered class");
    const SpecMethodMeta* mm = spec_class_find_method(m, spec_buf_to_cstring(method));
    if (!mm) spec_panic("Introspection:invoke — no such method");
    spec_invoke_void_by_meta(instance, mm);
}

/* Clock & Memory Metrics */
long long spec_clock_ms(void) {
    return spec_pal_get_wall_time_us() / 1000;
}

long long spec_mem_peak_kb(void) {
    return spec_pal_get_peak_rss_kb();
}

long long spec_thread_count(void) {
    return spec_pal_get_cpu_count();
}

/* Process Resource Monitoring (instantaneous RSS and CPU sampling) */
static pthread_t _spec_mon_thread;
static _Atomic bool _spec_mon_active = false;
static _Atomic long long _spec_mon_sample_count = 0;
static _Atomic long long _spec_mon_mem_sum_kb = 0;
static _Atomic long long _spec_mon_peak_mem_kb = 0;
static _Atomic long long _spec_mon_peak_cpu_pct = 0;
static long long _spec_mon_start_wall_us = 0;
static long long _spec_mon_start_cpu_us = 0;
static long long _spec_mon_total_wall_us = 0;
static long long _spec_mon_total_cpu_us = 0;

long long spec_monitor_avg_cpu_pct(void) {
    if (_spec_mon_total_wall_us <= 0) return 0;
    return (_spec_mon_total_cpu_us * 100) / _spec_mon_total_wall_us;
}

long long spec_monitor_peak_cpu_pct(void) {
    return _spec_mon_peak_cpu_pct;
}

long long spec_monitor_avg_mem_kb(void) {
    long long count = _spec_mon_sample_count;
    if (count <= 0) return _spec_mon_peak_mem_kb;
    return _spec_mon_mem_sum_kb / count;
}

long long spec_monitor_peak_mem_kb(void) {
    return _spec_mon_peak_mem_kb;
}

static void* _spec_monitor_worker(void* arg) {
    (void)arg;
    long long page_size = spec_pal_get_page_size();

    long long last_wall_us = spec_pal_get_wall_time_us();
    long long last_cpu_us = spec_pal_get_cpu_time_us();

    while (_spec_mon_active) {
        spec_pal_sleep_ms(20);
        if (!_spec_mon_active) break;

        long long cur_rss_kb = spec_pal_get_current_rss_kb(page_size);
        if (cur_rss_kb > 0) {
            _spec_mon_mem_sum_kb += cur_rss_kb;
            _spec_mon_sample_count++;
            if (cur_rss_kb > _spec_mon_peak_mem_kb) {
                _spec_mon_peak_mem_kb = cur_rss_kb;
            }
        }

        long long now_wall_us = spec_pal_get_wall_time_us();
        long long now_cpu_us = spec_pal_get_cpu_time_us();

        long long d_wall = now_wall_us - last_wall_us;
        long long d_cpu = now_cpu_us - last_cpu_us;
        if (d_wall >= 15000) {
            long long cpu_pct = (d_cpu * 100) / d_wall;
            if (cpu_pct > _spec_mon_peak_cpu_pct) {
                _spec_mon_peak_cpu_pct = cpu_pct;
            }
            last_wall_us = now_wall_us;
            last_cpu_us = now_cpu_us;
        }
    }
    return NULL;
}

void spec_monitor_start(void) {
    if (_spec_mon_active) return;
    _spec_mon_sample_count = 0;
    _spec_mon_mem_sum_kb = 0;
    _spec_mon_peak_mem_kb = 0;
    _spec_mon_peak_cpu_pct = 0;

    _spec_mon_start_wall_us = spec_pal_get_wall_time_us();
    _spec_mon_start_cpu_us = spec_pal_get_cpu_time_us();

    _spec_mon_active = true;
    pthread_create(&_spec_mon_thread, NULL, _spec_monitor_worker, NULL);
}

void spec_monitor_stop(void) {
    if (!_spec_mon_active) return;
    _spec_mon_active = false;
    pthread_join(_spec_mon_thread, NULL);

    long long end_wall_us = spec_pal_get_wall_time_us();
    long long end_cpu_us = spec_pal_get_cpu_time_us();

    _spec_mon_total_wall_us = end_wall_us - _spec_mon_start_wall_us;
    _spec_mon_total_cpu_us = end_cpu_us - _spec_mon_start_cpu_us;

    long long peak_ru = spec_pal_get_peak_rss_kb();
    if (peak_ru > _spec_mon_peak_mem_kb) {
        _spec_mon_peak_mem_kb = peak_ru;
    }
    long long avg_cpu = spec_monitor_avg_cpu_pct();
    if (avg_cpu > _spec_mon_peak_cpu_pct) {
        _spec_mon_peak_cpu_pct = avg_cpu;
    }
}

/* Error Output Primitive */
void spec_error_line(String s) {
    const char* cs = s ? spec_buf_to_cstring((SpecBuf*)s) : "";
    fprintf(stderr, "%s\n", cs);
}

/* The console floor (the sysinternal binding targets): the wrappers
   name these consOut/consIn/line on the Spec side; the C names are
   the internal provenance. */
void spec_print_line(String s) {
    printf("%s\n", s ? spec_buf_to_cstring((SpecBuf*)s) : "");
}

void spec_print(String s) {
    printf("%s", s ? spec_buf_to_cstring((SpecBuf*)s) : "");
    fflush(stdout);
}

/* Reads one line from stdin (the trailing newline stripped) and hands
   it to the on-line closure; at end of input nothing is handed over. */
void spec_read_line(SpecClosure* on_line) {
#if defined(_WIN32)
    char buf[4096];
    if (fgets(buf, sizeof(buf), stdin)) {
        size_t len = strlen(buf);
        while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r')) {
            buf[len - 1] = '\0';
            len--;
        }
        String text = spec_string_from_chars(buf);
        spec_call_closure_str(on_line, text);
        spec_release(text);
    }
#else
    char* _line = NULL;
    size_t _cap = 0;
    ssize_t _n = getline(&_line, &_cap, stdin);
    if (_n >= 0) {
        if (_n > 0 && _line[_n - 1] == '\n') _line[_n - 1] = '\0';
        String text = spec_string_from_chars(_line);
        spec_call_closure_str(on_line, text);
        spec_release(text);
    }
    free(_line);
#endif
}

/* Networking & Sockets Floor */
#if defined(_WIN32)
static void _spec_ensure_winsock(void) {
    static bool init = false;
    if (!init) {
        WSADATA wsa;
        WSAStartup(MAKEWORD(2, 2), &wsa);
        init = true;
    }
}
#endif

long long spec_tcp_connect(String host, long long port, long long timeout_ms) {
    if (!host || port <= 0 || port > 65535) return -1;
#if defined(_WIN32)
    _spec_ensure_winsock();
#endif
    char port_str[16];
    snprintf(port_str, sizeof(port_str), "%lld", port);
    const char* h = spec_buf_to_cstring((SpecBuf*)host);

    struct addrinfo hints, *res = NULL, *rp = NULL;
    memset(&hints, 0, sizeof(hints));
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = SOCK_STREAM;

    if (getaddrinfo(h, port_str, &hints, &res) != 0 || !res) {
        return -1;
    }

    long long sock_fd = -1;
    for (rp = res; rp != NULL; rp = rp->ai_next) {
#if defined(_WIN32)
        SOCKET s = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
        if (s == INVALID_SOCKET) continue;
        if (timeout_ms > 0) {
            DWORD tv = (DWORD)timeout_ms;
            setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, (const char*)&tv, sizeof(tv));
            setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, (const char*)&tv, sizeof(tv));
        }
        if (connect(s, rp->ai_addr, (int)rp->ai_addrlen) == 0) {
            sock_fd = (long long)s;
            break;
        }
        closesocket(s);
#else
        int s = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
        if (s < 0) continue;
        if (timeout_ms > 0) {
            struct timeval tv;
            tv.tv_sec = timeout_ms / 1000;
            tv.tv_usec = (timeout_ms % 1000) * 1000;
            setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, (const void*)&tv, sizeof(tv));
            setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, (const void*)&tv, sizeof(tv));
        }
        if (connect(s, rp->ai_addr, rp->ai_addrlen) == 0) {
            sock_fd = (long long)s;
            break;
        }
        close(s);
#endif
    }
    freeaddrinfo(res);
    return sock_fd;
}

long long spec_tcp_listen(String host, long long port, long long backlog) {
    if (port <= 0 || port > 65535) return -1;
#if defined(_WIN32)
    _spec_ensure_winsock();
#endif
    char port_str[16];
    snprintf(port_str, sizeof(port_str), "%lld", port);
    const char* h = (host && host->length > 0) ? spec_buf_to_cstring((SpecBuf*)host) : NULL;

    struct addrinfo hints, *res = NULL;
    memset(&hints, 0, sizeof(hints));
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = SOCK_STREAM;
    hints.ai_flags = AI_PASSIVE;

    if (getaddrinfo(h, port_str, &hints, &res) != 0 || !res) {
        return -1;
    }

#if defined(_WIN32)
    SOCKET s = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
    if (s == INVALID_SOCKET) { freeaddrinfo(res); return -1; }
    BOOL opt = TRUE;
    setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (const char*)&opt, sizeof(opt));
    if (bind(s, res->ai_addr, (int)res->ai_addrlen) != 0 || listen(s, backlog > 0 ? (int)backlog : 128) != 0) {
        closesocket(s);
        freeaddrinfo(res);
        return -1;
    }
    freeaddrinfo(res);
    return (long long)s;
#else
    int s = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
    if (s < 0) { freeaddrinfo(res); return -1; }
    int opt = 1;
    setsockopt(s, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
    if (bind(s, res->ai_addr, res->ai_addrlen) != 0 || listen(s, backlog > 0 ? (int)backlog : 128) != 0) {
        close(s);
        freeaddrinfo(res);
        return -1;
    }
    freeaddrinfo(res);
    return (long long)s;
#endif
}

long long spec_socket_accept(long long fd) {
    if (fd < 0) return -1;
#if defined(_WIN32)
    SOCKET s = accept((SOCKET)fd, NULL, NULL);
    if (s == INVALID_SOCKET) return -1;
    return (long long)s;
#else
    int s = accept((int)fd, NULL, NULL);
    return (long long)s;
#endif
}

long long spec_socket_send(long long fd, SpecByteBuffer* buf) {
    if (fd < 0 || !buf || buf->length == 0) return 0;
#if defined(_WIN32)
    int n = send((SOCKET)fd, (const char*)buf->data, (int)buf->length, 0);
    return (n == SOCKET_ERROR) ? -1 : (long long)n;
#else
    ssize_t n = send((int)fd, buf->data, buf->length, 0);
    return (n < 0) ? -1 : (long long)n;
#endif
}

long long spec_socket_send_str(long long fd, String str) {
    if (fd < 0 || !str || str->length == 0) return 0;
    const char* cs = spec_buf_to_cstring((SpecBuf*)str);
    size_t len = strlen(cs);
#if defined(_WIN32)
    int n = send((SOCKET)fd, cs, (int)len, 0);
    return (n == SOCKET_ERROR) ? -1 : (long long)n;
#else
    ssize_t n = send((int)fd, cs, len, 0);
    return (n < 0) ? -1 : (long long)n;
#endif
}

SpecByteBuffer* spec_socket_recv(long long fd, long long max_bytes) {
    if (fd < 0) return NULL;
    if (max_bytes <= 0) max_bytes = 4096;
    if (max_bytes > 1048576) max_bytes = 1048576;

    SpecByteBuffer* b = spec_bytebuffer_new();
    b->data = (unsigned char*)spec_xmalloc((size_t)max_bytes);
    b->capacity = (size_t)max_bytes;

#if defined(_WIN32)
    int n = recv((SOCKET)fd, (char*)b->data, (int)max_bytes, 0);
    if (n <= 0) {
        if (n == 0) { b->length = 0; return b; }
        spec_release(b);
        return NULL;
    }
    b->length = (size_t)n;
    return b;
#else
    ssize_t n = recv((int)fd, b->data, (size_t)max_bytes, 0);
    if (n <= 0) {
        if (n == 0) { b->length = 0; return b; }
        spec_release(b);
        return NULL;
    }
    b->length = (size_t)n;
    return b;
#endif
}

String spec_socket_recv_str(long long fd, long long max_bytes) {
    SpecByteBuffer* b = spec_socket_recv(fd, max_bytes);
    if (!b) return spec_string_intern("");
    String s = spec_bytebuffer_to_string(b);
    spec_release(b);
    return s;
}

long long spec_socket_close(long long fd) {
    if (fd < 0) return 0;
#if defined(_WIN32)
    closesocket((SOCKET)fd);
#else
    close((int)fd);
#endif
    return 0;
}

long long spec_socket_poll(long long fd, long long mode, long long timeout_ms) {
    if (fd < 0) return -1;
#if defined(_WIN32)
    WSAPOLLFD pfd;
    pfd.fd = (SOCKET)fd;
    pfd.events = 0;
    if (mode & 1) pfd.events |= POLLIN;
    if (mode & 2) pfd.events |= POLLOUT;
    pfd.revents = 0;
    int ret = WSAPoll(&pfd, 1, (INT)timeout_ms);
    if (ret > 0) return (pfd.revents & (POLLIN | POLLOUT)) ? 1 : 0;
    return (ret == 0) ? 0 : -1;
#else
    struct pollfd pfd;
    pfd.fd = (int)fd;
    pfd.events = 0;
    if (mode & 1) pfd.events |= POLLIN;
    if (mode & 2) pfd.events |= POLLOUT;
    pfd.revents = 0;
    int ret = poll(&pfd, 1, (int)timeout_ms);
    if (ret > 0) return (pfd.revents & (POLLIN | POLLOUT)) ? 1 : 0;
    return (ret == 0) ? 0 : -1;
#endif
}

long long spec_socket_set_timeout(long long fd, long long timeout_ms) {
    if (fd < 0) return -1;
#if defined(_WIN32)
    DWORD tv = (timeout_ms > 0) ? (DWORD)timeout_ms : 0;
    setsockopt((SOCKET)fd, SOL_SOCKET, SO_RCVTIMEO, (const char*)&tv, sizeof(tv));
    setsockopt((SOCKET)fd, SOL_SOCKET, SO_SNDTIMEO, (const char*)&tv, sizeof(tv));
#else
    struct timeval tv;
    tv.tv_sec = timeout_ms / 1000;
    tv.tv_usec = (timeout_ms % 1000) * 1000;
    setsockopt((int)fd, SOL_SOCKET, SO_RCVTIMEO, (const void*)&tv, sizeof(tv));
    setsockopt((int)fd, SOL_SOCKET, SO_SNDTIMEO, (const void*)&tv, sizeof(tv));
#endif
    return 0;
}

/* PCM Audio Output Floor */
typedef struct {
    bool active;
    long long sample_rate;
    long long channels;
    long long format;
#if defined(__linux__)
    void* alsa_handle;
#elif defined(__APPLE__) && defined(__MACH__)
    AudioQueueRef aq_queue;
#elif defined(_WIN32)
    HWAVEOUT h_wave_out;
#endif
} SpecAudioStream;

static SpecAudioStream _spec_audio_streams[8] = {0};

#if defined(__linux__)
typedef void* spec_snd_pcm_t;
typedef int (*spec_pfn_snd_pcm_open)(spec_snd_pcm_t**, const char*, int, int);
typedef int (*spec_pfn_snd_pcm_set_params)(spec_snd_pcm_t*, int, int, unsigned int, unsigned int, int, unsigned int);
typedef long (*spec_pfn_snd_pcm_writei)(spec_snd_pcm_t*, const void*, unsigned long);
typedef int (*spec_pfn_snd_pcm_drain)(spec_snd_pcm_t*);
typedef int (*spec_pfn_snd_pcm_close)(spec_snd_pcm_t*);
typedef int (*spec_pfn_snd_pcm_recover)(spec_snd_pcm_t*, int, int);

static void* _spec_alsa_lib = NULL;
static spec_pfn_snd_pcm_open _spec_snd_pcm_open = NULL;
static spec_pfn_snd_pcm_set_params _spec_snd_pcm_set_params = NULL;
static spec_pfn_snd_pcm_writei _spec_snd_pcm_writei = NULL;
static spec_pfn_snd_pcm_drain _spec_snd_pcm_drain = NULL;
static spec_pfn_snd_pcm_close _spec_snd_pcm_close = NULL;
static spec_pfn_snd_pcm_recover _spec_snd_pcm_recover = NULL;

static bool _spec_init_alsa(void) {
    if (_spec_alsa_lib) return true;
    _spec_alsa_lib = dlopen("libasound.so.2", RTLD_LAZY);
    if (!_spec_alsa_lib) _spec_alsa_lib = dlopen("libasound.so", RTLD_LAZY);
    if (!_spec_alsa_lib) {
        fprintf(stderr, "[Spec Audio] ALSA library (libasound.so.2) not found.\n"
                        "Please install the ALSA development package:\n"
                        "  Debian/Ubuntu: sudo apt-get install libasound2-dev\n"
                        "  Fedora/RHEL:   sudo dnf install alsa-lib-devel\n"
                        "  Arch:          sudo pacman -S alsa-lib\n");
        return false;
    }
    _spec_snd_pcm_open = (spec_pfn_snd_pcm_open)dlsym(_spec_alsa_lib, "snd_pcm_open");
    _spec_snd_pcm_set_params = (spec_pfn_snd_pcm_set_params)dlsym(_spec_alsa_lib, "snd_pcm_set_params");
    _spec_snd_pcm_writei = (spec_pfn_snd_pcm_writei)dlsym(_spec_alsa_lib, "snd_pcm_writei");
    _spec_snd_pcm_drain = (spec_pfn_snd_pcm_drain)dlsym(_spec_alsa_lib, "snd_pcm_drain");
    _spec_snd_pcm_close = (spec_pfn_snd_pcm_close)dlsym(_spec_alsa_lib, "snd_pcm_close");
    _spec_snd_pcm_recover = (spec_pfn_snd_pcm_recover)dlsym(_spec_alsa_lib, "snd_pcm_recover");
    return _spec_snd_pcm_open && _spec_snd_pcm_set_params && _spec_snd_pcm_writei;
}
#elif defined(__APPLE__) && defined(__MACH__)
static void _spec_audio_queue_cb(void* custom_data, AudioQueueRef queue, AudioQueueBufferRef buffer) {
    (void)custom_data;
    AudioQueueFreeBuffer(queue, buffer);
}
#endif

long long spec_audio_open(long long sample_rate, long long channels, long long format) {
    if (sample_rate <= 0) sample_rate = 44100;
    if (channels <= 0) channels = 2;
    if (format <= 0) format = 1;

    int slot = -1;
    for (int i = 0; i < 8; i++) {
        if (!_spec_audio_streams[i].active) {
            slot = i;
            break;
        }
    }
    if (slot < 0) return -1;

#if defined(__linux__)
    if (!_spec_init_alsa()) return -1;
    spec_snd_pcm_t* pcm = NULL;
    if (_spec_snd_pcm_open(&pcm, "default", 0, 0) != 0) {
