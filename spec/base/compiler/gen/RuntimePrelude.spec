/* Thread-Safe Spec Dynamic Array */
#define SPEC_ELEM_NONE 0
#define SPEC_ELEM_OBJECT 1
typedef struct {
    void** items;
    size_t length;
    size_t capacity;
    int elem_kind;
    bool frozen;
    pthread_mutex_t lock;
} SpecArray;

void spec_array_destroy(void* self) {
    SpecArray* a = (SpecArray*)self;
    if (a) {
        if (a->items) {
            for (size_t i = 0; i < a->length; i++) {
                if (!a->items[i]) continue;
                if (a->elem_kind == SPEC_ELEM_OBJECT) spec_release(a->items[i]);
            }
        }
        pthread_mutex_destroy(&a->lock);
        if (a->items) free(a->items);
    }
}

static SpecArray* spec_array_new_kind(int kind) {
    SpecArray* a = (SpecArray*)spec_alloc(sizeof(SpecArray), spec_array_destroy);
    a->items = NULL;
    a->length = 0;
    a->capacity = 0;
    a->elem_kind = kind;
    a->frozen = false;
    pthread_mutexattr_t attr;
    pthread_mutexattr_init(&attr);
    pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
    pthread_mutex_init(&a->lock, &attr);
    pthread_mutexattr_destroy(&attr);
    return a;
}

SpecArray* spec_array_new(void) {
    return spec_array_new_kind(SPEC_ELEM_NONE);
}

SpecArray* spec_array_new_object(void) {
    return spec_array_new_kind(SPEC_ELEM_OBJECT);
}

void spec_array_add(SpecArray* a, void* item) {
    if (!a) return;
    if (a->frozen) { spec_panic("Mutation attempted on frozen Array"); return; }
    pthread_mutex_lock(&a->lock);
    if (a->length >= a->capacity) {
        size_t ncap = (a->capacity == 0) ? 8 : a->capacity * 2;
        a->items = (void**)spec_xrealloc(a->items, sizeof(void*) * ncap);
        a->capacity = ncap;
    }
    if (a->elem_kind == SPEC_ELEM_OBJECT && item) spec_retain(item);
    a->items[a->length++] = item;
    pthread_mutex_unlock(&a->lock);
}

void spec_array_add_object(SpecArray* a, void* item) {
    if (a && a->elem_kind == SPEC_ELEM_NONE) a->elem_kind = SPEC_ELEM_OBJECT;
    spec_array_add(a, item);
}

void spec_array_add_owned(SpecArray* a, void* item) {
    if (!a) return;
    if (a->frozen) { spec_panic("Mutation attempted on frozen Array"); return; }
    pthread_mutex_lock(&a->lock);
    if (a->elem_kind == SPEC_ELEM_NONE) a->elem_kind = SPEC_ELEM_OBJECT;
    if (a->length >= a->capacity) {
        size_t ncap = (a->capacity == 0) ? 8 : a->capacity * 2;
        a->items = (void**)spec_xrealloc(a->items, sizeof(void*) * ncap);
        a->capacity = ncap;
    }
    a->items[a->length++] = item;
    pthread_mutex_unlock(&a->lock);
}

void spec_array_add_array(SpecArray* a, SpecArray* other) {
    if (!a || !other) return;
    if (a->frozen) { spec_panic("Mutation attempted on frozen Array"); return; }
    if (a == other) {
        pthread_mutex_lock(&a->lock);
        size_t n = a->length;
        if (a->length + n > a->capacity) {
            size_t ncap = a->capacity ? a->capacity * 2 : 8;
            while (ncap < a->length + n) ncap *= 2;
            a->items = (void**)spec_xrealloc(a->items, sizeof(void*) * ncap);
            a->capacity = ncap;
        }
        for (size_t i = 0; i < n; i++) {
            void* item = a->items[i];
            if (a->elem_kind == SPEC_ELEM_OBJECT && item) spec_retain(item);
            a->items[a->length++] = item;
        }
        pthread_mutex_unlock(&a->lock);
        return;
    }
    if ((uintptr_t)a < (uintptr_t)other) {
        pthread_mutex_lock(&a->lock);
        pthread_mutex_lock(&other->lock);
    } else {
        pthread_mutex_lock(&other->lock);
        pthread_mutex_lock(&a->lock);
    }
    size_t n = other->length;
    if (a->length + n > a->capacity) {
        size_t ncap = a->capacity ? a->capacity * 2 : 8;
        while (ncap < a->length + n) ncap *= 2;
        a->items = (void**)spec_xrealloc(a->items, sizeof(void*) * ncap);
        a->capacity = ncap;
    }
    for (size_t i = 0; i < n; i++) {
        void* item = other->items[i];
        if (a->elem_kind == SPEC_ELEM_OBJECT && item) spec_retain(item);
        a->items[a->length++] = item;
    }
    pthread_mutex_unlock(&a->lock);
    pthread_mutex_unlock(&other->lock);
}

long long spec_array_length(SpecArray* a) {
    if (!a) return 0;
    if (a->frozen) return (long long)a->length;
    pthread_mutex_lock(&a->lock);
    long long len = (long long)a->length;
    pthread_mutex_unlock(&a->lock);
    return len;
}

void* spec_array_get(SpecArray* a, long long idx) {
    if (!a) spec_panic("Null pointer access on uninitialized Array");
    if (a->frozen) {
        if (idx < 0 || (size_t)idx >= a->length) {
            spec_panic_bounds("Array", idx, a->length);
            return NULL;
        }
        void* val = a->items[idx];
        if (a->elem_kind == SPEC_ELEM_OBJECT && val) {
            spec_retain(val);
            spec_claim_pool(val);
        }
        return val;
    }
    pthread_mutex_lock(&a->lock);
    if (idx < 0 || (size_t)idx >= a->length) {
        size_t len = a->length;
        pthread_mutex_unlock(&a->lock);
        spec_panic_bounds("Array", idx, len);
        return NULL;
    }
    void* val = a->items[idx];
    if (a->elem_kind == SPEC_ELEM_OBJECT && val) {
        spec_retain(val);
        spec_claim_pool(val);
    }
    pthread_mutex_unlock(&a->lock);
    return val;
}

void spec_array_set(SpecArray* a, long long idx, void* item) {
    if (!a) spec_panic("Null pointer access on uninitialized Array");
    if (a->frozen) { spec_panic("Mutation attempted on frozen Array"); return; }
    pthread_mutex_lock(&a->lock);
    if (idx < 0 || (size_t)idx >= a->length) {
        size_t len = a->length;
        pthread_mutex_unlock(&a->lock);
        spec_panic_bounds("Array assignment", idx, len);
        return;
    }
    if (a->elem_kind == SPEC_ELEM_OBJECT) {
        if (item) spec_retain(item);
        if (a->items[idx]) spec_release(a->items[idx]);
    }
    a->items[idx] = item;
    pthread_mutex_unlock(&a->lock);
}

void* spec_array_pop(SpecArray* a, void* def) {
    if (!a) return def;
    if (a->frozen) { spec_panic("Mutation attempted on frozen Array"); return def; }
    pthread_mutex_lock(&a->lock);
    void* val = def;
    if (a->length > 0) {
        val = a->items[--a->length];
    } else if (a->elem_kind == SPEC_ELEM_OBJECT && def) {
        spec_retain(def);
    }
    pthread_mutex_unlock(&a->lock);
    return val;
}

void* spec_array_remove_at(SpecArray* a, long long idx, void* def) {
    if (!a || idx < 0) return def;
    if (a->frozen) { spec_panic("Mutation attempted on frozen Array"); return def; }
    pthread_mutex_lock(&a->lock);
    void* removed = def;
    if ((size_t)idx < a->length) {
        removed = a->items[idx];
        for (size_t i = (size_t)idx; i + 1 < a->length; i++) {
            a->items[i] = a->items[i + 1];
        }
        a->length--;
    } else if (a->elem_kind == SPEC_ELEM_OBJECT && def) {
        spec_retain(def);
    }
    pthread_mutex_unlock(&a->lock);
    return removed;
}

void spec_array_clear(SpecArray* a) {
    if (!a) return;
    if (a->frozen) { spec_panic("Mutation attempted on frozen Array"); return; }
    pthread_mutex_lock(&a->lock);
    for (size_t i = 0; i < a->length; i++) {
        if (!a->items[i]) continue;
        if (a->elem_kind == SPEC_ELEM_OBJECT) spec_release(a->items[i]);
    }
    a->length = 0;
    pthread_mutex_unlock(&a->lock);
}

void spec_array_freeze(SpecArray* a) {
    if (!a) return;
    pthread_mutex_lock(&a->lock);
    a->frozen = true;
    pthread_mutex_unlock(&a->lock);
}

/* Thread-Safe Spec Hash Map (FNV-1a, chained, growing power-of-two table) */
#define SPEC_MAP_INITIAL_BUCKETS 64
typedef struct SpecMapEntry {
    char* key;
    void* value;
    bool is_str;
    struct SpecMapEntry* next;
} SpecMapEntry;

typedef struct {
    SpecMapEntry** buckets;
    size_t nbuckets;
    size_t length;
    int val_kind;
    bool frozen;
    pthread_mutex_t lock;
} SpecMap;

static inline size_t spec_hash_key(const char* key, size_t nbuckets) {
    size_t h = 1469598103934665603ULL;
    while (*key) {
        h ^= (unsigned char)(*key++);
        h *= 1099511628211ULL;
    }
    return h & (nbuckets - 1);
}

/* Doubles the table once the load factor reaches 1, so chains stay short
   however large the map grows. Caller holds the map lock. */
static void spec_map_grow(SpecMap* m) {
    if (m->length < m->nbuckets) return;
    size_t nb = m->nbuckets * 2;
    SpecMapEntry** grown = (SpecMapEntry**)spec_xmalloc(sizeof(SpecMapEntry*) * nb);
    memset(grown, 0, sizeof(SpecMapEntry*) * nb);
    for (size_t i = 0; i < m->nbuckets; i++) {
        SpecMapEntry* curr = m->buckets[i];
        while (curr) {
            SpecMapEntry* next = curr->next;
            size_t idx = spec_hash_key(curr->key, nb);
            curr->next = grown[idx];
            grown[idx] = curr;
            curr = next;
        }
    }
    free(m->buckets);
    m->buckets = grown;
    m->nbuckets = nb;
}

void spec_map_destroy(void* self) {
    SpecMap* m = (SpecMap*)self;
    if (m) {
        pthread_mutex_destroy(&m->lock);
        for (size_t i = 0; i < m->nbuckets; i++) {
            SpecMapEntry* curr = m->buckets[i];
            while (curr) {
                SpecMapEntry* next = curr->next;
                if (curr->key) free(curr->key);
                if (curr->is_str && curr->value) free(curr->value);
                else if (m->val_kind == SPEC_ELEM_OBJECT && curr->value) spec_release(curr->value);
                free(curr);
                curr = next;
            }
        }
        free(m->buckets);
        m->buckets = NULL;
    }
}

static SpecMap* spec_map_new_kind(int kind) {
    SpecMap* m = (SpecMap*)spec_alloc(sizeof(SpecMap), spec_map_destroy);
    m->val_kind = kind;
    m->frozen = false;
    m->nbuckets = SPEC_MAP_INITIAL_BUCKETS;
    m->buckets = (SpecMapEntry**)spec_xmalloc(sizeof(SpecMapEntry*) * m->nbuckets);
    memset(m->buckets, 0, sizeof(SpecMapEntry*) * m->nbuckets);
    pthread_mutexattr_t attr;
    pthread_mutexattr_init(&attr);
    pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
    pthread_mutex_init(&m->lock, &attr);
    pthread_mutexattr_destroy(&attr);
    return m;
}

SpecMap* spec_map_new(void) {
    return spec_map_new_kind(SPEC_ELEM_NONE);
}

SpecMap* spec_map_new_object(void) {
    return spec_map_new_kind(SPEC_ELEM_OBJECT);
}

void spec_map_set(SpecMap* m, String key, String val) {
    if (!m || !key) return;
    if (m->frozen) { spec_panic("Mutation attempted on frozen Map"); return; }
    const char* ck = spec_buf_to_cstring((SpecBuf*)key);
    const char* cv = val ? spec_buf_to_cstring((SpecBuf*)val) : NULL;
    pthread_mutex_lock(&m->lock);
    size_t idx = spec_hash_key(ck, m->nbuckets);
    SpecMapEntry* curr = m->buckets[idx];
    while (curr) {
        if (strcmp(curr->key, ck) == 0) {
            if (curr->is_str && curr->value) free(curr->value);
            else if (m->val_kind == SPEC_ELEM_OBJECT && curr->value) spec_release(curr->value);
            curr->value = (void*)spec_xstrdup(cv ? cv : "");
            curr->is_str = true;
            pthread_mutex_unlock(&m->lock);
            return;
        }
        curr = curr->next;
    }
    spec_map_grow(m);
    idx = spec_hash_key(ck, m->nbuckets);
    SpecMapEntry* e = (SpecMapEntry*)spec_xmalloc(sizeof(SpecMapEntry));
    e->key = spec_xstrdup(ck);
    e->value = (void*)spec_xstrdup(cv ? cv : "");
    e->is_str = true;
    e->next = m->buckets[idx];
    m->buckets[idx] = e;
    m->length++;
    pthread_mutex_unlock(&m->lock);
}

void spec_map_set_any(SpecMap* m, String key, void* val) {
    if (!m || !key) return;
    if (m->frozen) { spec_panic("Mutation attempted on frozen Map"); return; }
    const char* ck = spec_buf_to_cstring((SpecBuf*)key);
    pthread_mutex_lock(&m->lock);
    size_t idx = spec_hash_key(ck, m->nbuckets);
    SpecMapEntry* curr = m->buckets[idx];
    while (curr) {
        if (strcmp(curr->key, ck) == 0) {
            if (curr->is_str && curr->value) free(curr->value);
            else if (m->val_kind == SPEC_ELEM_OBJECT && curr->value) spec_release(curr->value);
            if (m->val_kind == SPEC_ELEM_OBJECT && val) spec_retain(val);
            curr->value = val;
            curr->is_str = false;
            pthread_mutex_unlock(&m->lock);
            return;
        }
        curr = curr->next;
    }
    if (m->val_kind == SPEC_ELEM_OBJECT && val) spec_retain(val);
    spec_map_grow(m);
    idx = spec_hash_key(ck, m->nbuckets);
    SpecMapEntry* e = (SpecMapEntry*)spec_xmalloc(sizeof(SpecMapEntry));
    e->key = spec_xstrdup(ck);
    e->value = val;
    e->is_str = false;
    e->next = m->buckets[idx];
    m->buckets[idx] = e;
    m->length++;
    pthread_mutex_unlock(&m->lock);
}

void spec_map_set_any_transfer(SpecMap* m, String key, void* val) {
    if (!m || !key) return;
    if (m->frozen) { spec_panic("Mutation attempted on frozen Map"); return; }
    const char* ck = spec_buf_to_cstring((SpecBuf*)key);
    pthread_mutex_lock(&m->lock);
    size_t idx = spec_hash_key(ck, m->nbuckets);
    SpecMapEntry* curr = m->buckets[idx];
    while (curr) {
        if (strcmp(curr->key, ck) == 0) {
            if (curr->is_str && curr->value) free(curr->value);
            else if (m->val_kind == SPEC_ELEM_OBJECT && curr->value) spec_release(curr->value);
            curr->value = val;
            curr->is_str = false;
            pthread_mutex_unlock(&m->lock);
            return;
        }
        curr = curr->next;
    }
    spec_map_grow(m);
    idx = spec_hash_key(ck, m->nbuckets);
    SpecMapEntry* e = (SpecMapEntry*)spec_xmalloc(sizeof(SpecMapEntry));
    e->key = spec_xstrdup(ck);
    e->value = val;
    e->is_str = false;
    e->next = m->buckets[idx];
    m->buckets[idx] = e;
    m->length++;
    pthread_mutex_unlock(&m->lock);
}

void* spec_map_get(SpecMap* m, String key, void* _default) {
    if (!m || !key) return _default;
    const char* ck = spec_buf_to_cstring((SpecBuf*)key);
    if (m->frozen) {
        size_t idx = spec_hash_key(ck, m->nbuckets);
        SpecMapEntry* curr = m->buckets[idx];
        while (curr) {
            if (strcmp(curr->key, ck) == 0) {
                void* res = curr->value;
                if (curr->is_str) res = (void*)spec_string_from_chars(res ? (const char*)res : "");
                return res;
            }
            curr = curr->next;
        }
        return _default;
    }
    pthread_mutex_lock(&m->lock);
    size_t idx = spec_hash_key(ck, m->nbuckets);
    SpecMapEntry* curr = m->buckets[idx];
    while (curr) {
        if (strcmp(curr->key, ck) == 0) {
            void* res = curr->value;
            if (curr->is_str) res = (void*)spec_string_from_chars(res ? (const char*)res : "");
            pthread_mutex_unlock(&m->lock);
            return res;
        }
        curr = curr->next;
    }
    pthread_mutex_unlock(&m->lock);
    return _default;
}

bool spec_map_has(SpecMap* m, String key) {
    if (!m || !key) return false;
    const char* ck = spec_buf_to_cstring((SpecBuf*)key);
    if (m->frozen) {
        size_t idx = spec_hash_key(ck, m->nbuckets);
        SpecMapEntry* curr = m->buckets[idx];
        while (curr) {
            if (strcmp(curr->key, ck) == 0) return true;
            curr = curr->next;
        }
        return false;
    }
    pthread_mutex_lock(&m->lock);
    size_t idx = spec_hash_key(ck, m->nbuckets);
    SpecMapEntry* curr = m->buckets[idx];
    while (curr) {
        if (strcmp(curr->key, ck) == 0) {
            pthread_mutex_unlock(&m->lock);
            return true;
        }
        curr = curr->next;
    }
    pthread_mutex_unlock(&m->lock);
    return false;
}

bool spec_map_remove(SpecMap* m, String key) {
    if (!m || !key) return false;
    if (m->frozen) { spec_panic("Mutation attempted on frozen Map"); return false; }
    const char* ck = spec_buf_to_cstring((SpecBuf*)key);
    pthread_mutex_lock(&m->lock);
    size_t idx = spec_hash_key(ck, m->nbuckets);
    SpecMapEntry* curr = m->buckets[idx];
    SpecMapEntry* prev = NULL;
    while (curr) {
        if (strcmp(curr->key, ck) == 0) {
            if (prev) prev->next = curr->next;
            else m->buckets[idx] = curr->next;
            free(curr->key);
            if (curr->is_str && curr->value) free(curr->value);
            else if (m->val_kind == SPEC_ELEM_OBJECT && curr->value) spec_release(curr->value);
            free(curr);
            m->length--;
            pthread_mutex_unlock(&m->lock);
            return true;
        }
        prev = curr;
        curr = curr->next;
    }
    pthread_mutex_unlock(&m->lock);
    return false;
}

long long spec_map_length(SpecMap* m) {
    if (!m) return 0;
    if (m->frozen) return (long long)m->length;
    pthread_mutex_lock(&m->lock);
    long long cnt = (long long)m->length;
    pthread_mutex_unlock(&m->lock);
    return cnt;
}

SpecArray* spec_map_keys(SpecMap* m) {
    SpecArray* a = spec_array_new_object();
    if (!m) return a;
    if (m->frozen) {
        for (size_t i = 0; i < m->nbuckets; i++) {
            SpecMapEntry* curr = m->buckets[i];
            while (curr) {
                spec_array_add_owned(a, (void*)spec_string_from_chars(curr->key));
                curr = curr->next;
            }
        }
        return a;
    }
    pthread_mutex_lock(&m->lock);
    for (size_t i = 0; i < m->nbuckets; i++) {
        SpecMapEntry* curr = m->buckets[i];
        while (curr) {
            spec_array_add_owned(a, (void*)spec_string_from_chars(curr->key));
            curr = curr->next;
        }
    }
    pthread_mutex_unlock(&m->lock);
    return a;
}

void spec_map_freeze(SpecMap* m) {
    if (!m) return;
    pthread_mutex_lock(&m->lock);
    m->frozen = true;
    pthread_mutex_unlock(&m->lock);
}

/* Spec Loop Control Intrinsic */
typedef struct SpecLoopControl {
    bool stopped;
    void* callback;
    void (*on_complete)(void* callback, struct SpecLoopControl* control);
} SpecLoopControl;

typedef struct SpecLoopControl LoopControl;

/* The decoupled loop object: instances are runtime-managed state
   machines; the type is the opaque handle the runner signatures
   reference. */
typedef struct Loop Loop;

SpecLoopControl* LoopControl_new(void) {
    SpecLoopControl* c = (SpecLoopControl*)spec_alloc(sizeof(SpecLoopControl), NULL);
    if (c) {
        c->stopped = false;
        c->callback = NULL;
        c->on_complete = NULL;
    }
    return c;
}

void LoopControl_stop(SpecLoopControl* c) {
    if (c) c->stopped = true;
}

/* Spec Async Task Manager */
static int spec_in_flight_tasks = 0;
static pthread_mutex_t spec_task_mutex = PTHREAD_MUTEX_INITIALIZER;
static pthread_cond_t spec_task_cond = PTHREAD_COND_INITIALIZER;

void spec_async_task_started(void) {
    pthread_mutex_lock(&spec_task_mutex);
    spec_in_flight_tasks++;
    pthread_mutex_unlock(&spec_task_mutex);
}

void spec_async_task_finished(void) {
    pthread_mutex_lock(&spec_task_mutex);
    spec_in_flight_tasks--;
    if (spec_in_flight_tasks <= 0) {
        spec_in_flight_tasks = 0;
        pthread_cond_broadcast(&spec_task_cond);
    }
    pthread_mutex_unlock(&spec_task_mutex);
}

void spec_drain_async_tasks(void) {
    pthread_mutex_lock(&spec_task_mutex);
    while (spec_in_flight_tasks > 0) {
        pthread_cond_wait(&spec_task_cond, &spec_task_mutex);
    }
    pthread_mutex_unlock(&spec_task_mutex);
}

/* File Package Primitives with Callbacks and Async Worker Support */
static inline void spec_call_closure_int(SpecClosure* cls, long long arg1) {
    if (cls && cls->fn) { ((void (*)(void*, long long))cls->fn)(cls->env, arg1); }
}

/* the no-argument closure invoker for the
   conditional floor. */
static inline void spec_call_closure_0(SpecClosure* cls) {
    if (cls && cls->fn) { ((void (*)(void*))cls->fn)(cls->env); }
}

/* The conditional floor: the single primitive.
   `else` is composed above it as `if(!check, else)`. */
static inline void spec_branch(SpecClosure* check, SpecClosure* then) {
    if (check && check->fn) {
        if (((bool (*)(void*))check->fn)(check->env)) {
            spec_call_closure_0(then);
        }
    }
}

/* The iteration floor: the single loop primitive.
   `until` composes above it (run once, then while !evaluate); repeat
   counts; run drives the Loop protocol. */
static inline void spec_while(SpecClosure* evaluate, SpecClosure* iterate) {
    while (evaluate && evaluate->fn && ((bool (*)(void*))evaluate->fn)(evaluate->env)) {
        spec_call_closure_0(iterate);
    }
}
static inline void spec_call_closure_str(SpecClosure* cls, void* arg1) {
    if (cls && cls->fn) { ((void (*)(void*, void*))cls->fn)(cls->env, arg1); }
}

/* No-op callback singleton: the default for optional error callbacks */
static void _spec_noop_cb(void* env, const char* msg) { (void)env; (void)msg; }
static SpecClosure* _spec_noop_closure = NULL;
static inline SpecClosure* spec_noop_closure(void) {
    if (!_spec_noop_closure) { _spec_noop_closure = spec_closure_new((void*)_spec_noop_cb, NULL, NULL); }
    return _spec_noop_closure;
}

/* Per-Type Constructors: invoked by : assignment for each type. */
String spec_string_intern(const char* c);
String spec_string_from_chars(const char* c);
/* Each constructor takes the source value and produces the type's
   canonical internal representation. For primitives this is a cast;
   for composite types it involves allocation and initialisation. */
static inline long long spec_construct_int(long long v) { return v; }
static inline unsigned char spec_construct_byte(long long v) {
    if (v < 0 || v > 255) spec_panic_byte_range(v);
    return (unsigned char)v;
}

static inline double spec_construct_float(double v) { return v; }

static inline bool spec_construct_bool(bool v) { return v; }

static inline String spec_construct_string(const void* src) {
    if (!src) return spec_string_intern("");
    return spec_string_copy((String)src);
}
/* String: the managed string type (initially char*, transitions to SpecBuf) */
typedef SpecBuf* String;

/* Unified Growable Buffer: elem_size=1 for bytes, 8 for pointers */
typedef struct SpecBuf {
    void* data;
    size_t length;
    size_t capacity;
    size_t elem_size;
    int elem_kind;
} SpecBuf;

void spec_buf_destroy(void* self) {
    SpecBuf* b = (SpecBuf*)self;
    if (!b) return;
    if (b->data && b->elem_size == 8 && b->elem_kind != 0) {
        void** items = (void**)b->data;
        for (size_t i = 0; i < b->length; i++) {
            if (!items[i]) continue;
            if (b->elem_kind == 1) spec_release(items[i]);
        }
    }
    if (b->data) { free(b->data); b->data = NULL; }
}

/* The compilation arena: bump allocation over growing blocks. */
typedef struct ArenaBlock {
    struct ArenaBlock* next;
    size_t used;
    size_t cap;
    char* data;
} ArenaBlock;

typedef struct SpecArena {
    ArenaBlock* head;
    size_t used;
} SpecArena;

#define ARENA_BLOCK_SIZE (2 * 1024 * 1024)

static ArenaBlock* arena_block_new(size_t cap) {
    ArenaBlock* b = (ArenaBlock*)malloc(sizeof(ArenaBlock) + cap);
    if (!b) { fprintf(stderr, "[Spec Panic] Out of memory\n"); exit(1); }
    b->data = (char*)(b + 1);
    b->cap = cap;
    b->used = 0;
    b->next = NULL;
    return b;
}

static void* spec_arena_alloc(SpecArena* a, size_t size) {
    size = (size + 15) & ~(size_t)15;
    if (!a->head || a->head->used + size > a->head->cap) {
        size_t cap = ARENA_BLOCK_SIZE;
        if (size > cap) cap = size;
        ArenaBlock* nb = arena_block_new(cap);
        nb->next = a->head;
        a->head = nb;
    }
    void* p = a->head->data + a->head->used;
    a->head->used += size;
    a->used += size;
    memset(p, 0, size);
    return p;
}

SpecArena* spec_arena_new(void) {
    return (SpecArena*)calloc(1, sizeof(SpecArena));
}

void spec_arena_drain(SpecArena* a) {
    ArenaBlock* b = a->head;
    while (b) {
        ArenaBlock* next = b->next;
        free(b);
        b = next;
    }
    a->head = NULL;
    a->used = 0;
}

/* Object arena: header-carrying allocations from arena memory. Refcounts
   guard aliasing during compilation; the pending finalizers (field
   releases) run at drain, then the blocks free wholesale. */
typedef struct ArenaFinalizer {
    struct ArenaFinalizer* next;
    SpecHeader* header;
} ArenaFinalizer;

static pthread_mutex_t _spec_arena_mutex = PTHREAD_MUTEX_INITIALIZER;
static ArenaFinalizer* _spec_object_arena_finalizers = NULL;
static SpecArena _spec_object_arena = { NULL, 0 };

void spec_arena_drain_objects(void);

void* spec_arena_alloc_object(size_t size, void (*destroy)(void*)) {
    static int drain_registered = 0;
    pthread_mutex_lock(&_spec_arena_mutex);
    if (!drain_registered) {
        atexit(spec_arena_drain_objects);
        drain_registered = 1;
    }
    char* mem = (char*)spec_arena_alloc(&_spec_object_arena, sizeof(SpecHeader) + size);
    SpecHeader* h = (SpecHeader*)mem;
    h->ref_count = 1;
    h->destroy = destroy;
    /* Arena-owned: release runs the destructor (freeing malloc'd data)
       but the header block stays for the wholesale drain. Refcounts stay
       accurate so transients reclaim their data during compilation. */
    h->sflags = SPEC_S_ARENA;
    h->slen = 0;
    ArenaFinalizer* f = (ArenaFinalizer*)spec_arena_alloc(&_spec_object_arena, sizeof(ArenaFinalizer));
    f->next = _spec_object_arena_finalizers;
    f->header = h;
    _spec_object_arena_finalizers = f;
    pthread_mutex_unlock(&_spec_arena_mutex);
    return (void*)(mem + sizeof(SpecHeader));
}

void spec_arena_drain_objects(void) {
    pthread_mutex_lock(&_spec_arena_mutex);
    ArenaFinalizer* f = _spec_object_arena_finalizers;
    while (f) {
        if (f->header->destroy) {
            void (*d)(void*) = f->header->destroy;
            f->header->destroy = NULL;
            d((void*)(f->header + 1));
        }
        f = f->next;
    }
    _spec_object_arena_finalizers = NULL;
    spec_arena_drain(&_spec_object_arena);
    pthread_mutex_unlock(&_spec_arena_mutex);
}

long long spec_arena_used(SpecArena* a) {
    return (long long)a->used;
}

SpecArray* spec_dir_list(SpecBuf* path) {
    SpecArray* res = spec_array_new_object();
    if (!path) return res;
    DIR* d = opendir(spec_buf_to_cstring(path));
    if (!d) return res;
    struct dirent* ent;
    while ((ent = readdir(d)) != NULL) {
        if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
        spec_array_add_owned(res, spec_string_from_bytes(ent->d_name, strlen(ent->d_name)));
    }
    closedir(d);
    return res;
}
SpecBuf* spec_exe_dir(void) {
    char buf[4096];
    ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
    if (n <= 0) return spec_string_from_bytes(".", 1);
    buf[n] = '\0';
    char* slash = strrchr(buf, '/');
    if (!slash) return spec_string_from_bytes(".", 1);
    return spec_string_from_bytes(buf, (size_t)(slash - buf));
}
long long spec_file_size(SpecBuf* path) {
    struct stat st;
    if (stat(spec_buf_to_cstring(path), &st) != 0) return -1;
    return (long long)st.st_size;
}
SpecBuf* spec_buf_new(size_t elem_size, int elem_kind) {
    SpecBuf* b = (SpecBuf*)spec_alloc(sizeof(SpecBuf), spec_buf_destroy);
    b->data = NULL;
    b->length = 0;
    b->capacity = 0;
    b->elem_size = elem_size;
    b->elem_kind = elem_kind;
    return b;
}

static void spec_buf_grow(SpecBuf* b, size_t needed) {
    size_t need = needed + ((b->elem_size == 1) ? 1 : 0);
    if (b->length + need <= b->capacity) return;
    size_t cap = (b->capacity == 0) ? 16 : b->capacity * 2;
    while (cap < b->length + need) cap *= 2;
    if (cap > SIZE_MAX / b->elem_size) spec_panic("Buffer capacity overflow");
    b->data = spec_xrealloc(b->data, cap * b->elem_size);
    b->capacity = cap;
}
void spec_buf_push_byte(SpecBuf* b, long long v) {
    if (!b) return;
    spec_buf_grow(b, 1);
    ((unsigned char*)b->data)[b->length++] = (unsigned char)v;
    ((unsigned char*)b->data)[b->length] = 0;
}
void spec_buf_append_bytes(SpecBuf* b, const char* s) {
    if (!b || !s) return;
    size_t n = strlen(s);
    if (n == 0) return;
    spec_buf_grow(b, n);
    memcpy((unsigned char*)b->data + b->length, s, n);
    b->length += n;
    ((unsigned char*)b->data)[b->length] = 0;
}
void spec_buf_append_buf(SpecBuf* dst, SpecBuf* src) {
    if (!dst || !src || src->length == 0) return;
    if (dst->elem_size != 1 || src->elem_size != 1) return;
    if (dst == src) {
        size_t n = dst->length;
        spec_buf_grow(dst, n);
        memcpy((unsigned char*)dst->data + n, dst->data, n);
        dst->length += n;
        ((unsigned char*)dst->data)[dst->length] = 0;
        return;
    }
    spec_buf_grow(dst, src->length);
    memcpy((unsigned char*)dst->data + dst->length, src->data, src->length);
    dst->length += src->length;
    ((unsigned char*)dst->data)[dst->length] = 0;
}
void spec_buf_push_ptr(SpecBuf* b, void* item) {
    if (!b) return;
    spec_buf_grow(b, 1);
    if (b->elem_kind == 1 && item) spec_retain(item);
    ((void**)b->data)[b->length++] = item;
}

void spec_buf_report(SpecClosure* error, const char* msg) {
    spec_call_closure_str(error ? error : spec_noop_closure(), spec_string_from_bytes(msg, strlen(msg)));
}
long long spec_buf_get_byte(SpecBuf* b, long long idx, long long def) {
    if (!b) { return def; }
    if (idx < 0 || (size_t)idx >= b->length) return def;
    return (long long)((unsigned char*)b->data)[idx];
}
long long spec_buf_count_byte(SpecBuf* b, long long byte_val) {
    if (!b || b->length == 0) return 0;
    unsigned char target = (unsigned char)byte_val;
    const unsigned char* p = (const unsigned char*)b->data;
    size_t len = b->length;
    long long count = 0;
    while (len > 0) {
        const unsigned char* found = (const unsigned char*)memchr(p, target, len);
        if (!found) break;
        count++;
        size_t offset = (size_t)(found - p) + 1;
        p += offset;
        len -= offset;
    }
    return count;
}

void spec_buf_set_byte(SpecBuf* b, long long idx, long long v, SpecClosure* error) {
    if (!b) { spec_buf_report(error, "buffer is uninitialized"); return; }
    if (idx < 0 || (size_t)idx >= b->length) {
        char msg[96];
        snprintf(msg, sizeof(msg), "buffer assignment out of bounds: index %lld for length %zu", idx, b->length);
        spec_buf_report(error, msg);
        return;
    }
    ((unsigned char*)b->data)[idx] = (unsigned char)v;
}

long long spec_buf_pop_byte(SpecBuf* b, long long def, SpecClosure* error) {
    if (!b) { spec_buf_report(error, "buffer is uninitialized"); return def; }
    if (b->length == 0) {
        spec_buf_report(error, "buffer pop on empty buffer");
        return def;
    }
    long long out = (long long)((unsigned char*)b->data)[--b->length];
    ((unsigned char*)b->data)[b->length] = 0;
    return out;
}
void* spec_buf_get_ptr(SpecBuf* b, long long idx, void* def, SpecClosure* error) {
    if (!b) { spec_buf_report(error, "buffer is uninitialized"); return def; }
    if (idx < 0 || (size_t)idx >= b->length) {
        char msg[96];
        snprintf(msg, sizeof(msg), "buffer index out of bounds: index %lld for length %zu", idx, b->length);
        spec_buf_report(error, msg);
        return def;
    }
    return ((void**)b->data)[idx];
}

void spec_buf_set_ptr(SpecBuf* b, long long idx, void* item, SpecClosure* error) {
    if (!b) { spec_buf_report(error, "buffer is uninitialized"); return; }
    if (idx < 0 || (size_t)idx >= b->length) {
        char msg[96];
        snprintf(msg, sizeof(msg), "buffer assignment out of bounds: index %lld for length %zu", idx, b->length);
        spec_buf_report(error, msg);
        return;
    }
    if (b->elem_kind == 1) {
        if (item) spec_retain(item);
        if (((void**)b->data)[idx]) spec_release(((void**)b->data)[idx]);
    }
    ((void**)b->data)[idx] = item;
}

void* spec_buf_pop_ptr(SpecBuf* b, void* def, SpecClosure* error) {
    if (!b) { return def; }
    if (b->length == 0) {
        spec_buf_report(error, "buffer pop on empty buffer");
        if (b->elem_kind == 1 && def) spec_retain(def);
        return def;
    }
    return ((void**)b->data)[--b->length];
}

long long spec_buf_length(SpecBuf* b) {
    return b ? (long long)b->length : 0;
}

void spec_buf_clear(SpecBuf* b) {
    if (!b) return;
    if (b->data && b->elem_size == 8 && b->elem_kind != 0) {
        void** items = (void**)b->data;
        for (size_t i = 0; i < b->length; i++) {
            if (!items[i]) continue;
            if (b->elem_kind == 1) spec_release(items[i]);
        }
    }
    b->length = 0;
    if (b->data && b->elem_size == 1) ((unsigned char*)b->data)[0] = 0;
}
const char* spec_buf_to_cstring(SpecBuf* b) {
    if (!b || b->length == 0) return "";
    return (const char*)b->data;
}
/* String: managed string backed by SpecBuf (elem_size=1) */
typedef SpecBuf* String;

String spec_string_from_literal(const char* lit) {
    String b = spec_buf_new(1, 0);
    if (lit && *lit) spec_buf_append_bytes(b, lit);
    return b;
}

String spec_string_from_bytes(const char* data, size_t n) {
    String b = spec_buf_new(1, 0);
    if (data && n) {
        spec_buf_grow(b, n);
        memcpy((unsigned char*)b->data, data, n);
        b->length = n;
        ((unsigned char*)b->data)[b->length] = 0;
    }
    return b;
}

String spec_string_copy(String b) {
    if (!b || b->length == 0) return spec_buf_new(1, 0);
    return spec_string_from_bytes((const char*)b->data, b->length);
}

bool spec_string_bytes_equal(String b, const char* c, size_t n) {
    if (!b || b->length != n) return false;
    if (n == 0) return true;
    return memcmp(b->data, c, n) == 0;
}
long long spec_string_length(String b) {
    return spec_buf_length(b);
}

bool spec_string_equals(String a, String b) {
    if (a == b) return true;
    if (!a || !b) return false;
    if (a->length != b->length) return false;
    if (a->length == 0) return true;
    return memcmp(a->data, b->data, a->length) == 0;
}

long long spec_string_compare(String a, String b) {
    if (a == b) return 0;
    if (!a) return b ? -1 : 0;
    if (!b) return 1;
    const unsigned char* pa = (const unsigned char*)a->data;
    const unsigned char* pb = (const unsigned char*)b->data;
    long long n = a->length < b->length ? a->length : b->length;
    for (long long i = 0; i < n; i++) {
        if (pa[i] != pb[i]) {
            return (long long)pa[i] - (long long)pb[i];
        }
    }
    return (long long)a->length - (long long)b->length;
}

String spec_string_concat(String a, String b) {
    if (!a) a = spec_string_from_bytes("", 0);
    if (!b || b->length == 0) return a;
    SpecHeader* h = SPEC_HEADER(a);
    if (!(atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_IMMORTAL) &&
        atomic_load_explicit(&h->ref_count, memory_order_relaxed) == 1) {
        spec_buf_append_buf(a, b);
        return a;
    }
    String res = spec_buf_new(1, 0);
    if (a->length) spec_buf_append_buf(res, a);
    spec_buf_append_buf(res, b);
    spec_release(a);
    return res;
}
String spec_string_substring(String b, long long start, long long end) {
    if (!b) return spec_string_from_bytes("", 0);
    long long len = (long long)b->length;
    long long s = start < 0 ? 0 : start;
    long long e = end > len ? len : end;
    if (s >= e) return spec_string_from_bytes("", 0);
    return spec_string_from_bytes((const char*)b->data + s, (size_t)(e - s));
}

long long spec_string_index_of(String b, String needle, long long def) {
    return spec_string_index_of_from(b, needle, 0, def);
}

long long spec_string_index_of_from(String b, String needle, long long from, long long def) {
    if (!b || !needle) return def;
    if (from < 0) from = 0;
    if (needle->length == 0) return (from <= (long long)b->length) ? from : def;
    long long slen = (long long)b->length;
    long long nlen = (long long)needle->length;
    if (from + nlen > slen) return def;
    const unsigned char* haystack = (const unsigned char*)b->data;
    const unsigned char* nd = (const unsigned char*)needle->data;
    for (long long i = from; i + nlen <= slen; i++) {
        if (haystack[i] == nd[0] && memcmp(haystack + i, nd, (size_t)nlen) == 0) return i;
    }
    return def;
}

/* Spec Byte Buffer: compact [Byte] storage (the string builder floor) */
typedef struct {
    unsigned char* data;
    size_t length;
    size_t capacity;
} SpecByteBuffer;

void spec_bytebuffer_destroy(void* self) {
    SpecByteBuffer* b = (SpecByteBuffer*)self;
    if (b && b->data) { free(b->data); b->data = NULL; }
}

SpecByteBuffer* spec_bytebuffer_new(void) {
    SpecByteBuffer* b = (SpecByteBuffer*)spec_alloc(sizeof(SpecByteBuffer), spec_bytebuffer_destroy);
    b->data = NULL;
    b->length = 0;
    b->capacity = 0;
    return b;
}

void spec_bytebuffer_push(SpecByteBuffer* b, long long v) {
    if (!b) return;
    if (b->length >= b->capacity) {
        b->capacity = (b->capacity == 0) ? 16 : b->capacity * 2;
        b->data = (unsigned char*)spec_xrealloc(b->data, b->capacity);
    }
    b->data[b->length++] = (unsigned char)v;
}

void spec_bytebuffer_append_string(SpecByteBuffer* b, const char* s) {
    if (!b || !s) return;
    size_t n = strlen(s);
    if (n == 0) return;
    if (b->length + n > b->capacity) {
        size_t cap = (b->capacity == 0) ? 16 : b->capacity;
        while (cap < b->length + n) cap *= 2;
        b->data = (unsigned char*)spec_xrealloc(b->data, cap);
        b->capacity = cap;
    }
    memcpy(b->data + b->length, s, n);
    b->length += n;
}

void spec_bytebuffer_report(SpecClosure* error, const char* msg) {
    spec_call_closure_str(error ? error : spec_noop_closure(), spec_string_from_bytes(msg, strlen(msg)));
}

long long spec_bytebuffer_get(SpecByteBuffer* b, long long idx, long long def, SpecClosure* error) {
    if (!b) { spec_bytebuffer_report(error, "byte buffer is uninitialized"); return def; }
    if (idx < 0 || (size_t)idx >= b->length) {
        char msg[96];
        snprintf(msg, sizeof(msg), "byte buffer index out of bounds: index %lld for length %zu", idx, b->length);
        spec_bytebuffer_report(error, msg);
        return def;
    }
    return (long long)b->data[idx];
}

void spec_bytebuffer_set(SpecByteBuffer* b, long long idx, long long v, SpecClosure* error) {
    if (!b) { spec_bytebuffer_report(error, "byte buffer is uninitialized"); return; }
    if (idx < 0 || (size_t)idx >= b->length) {
        char msg[96];
        snprintf(msg, sizeof(msg), "byte buffer assignment out of bounds: index %lld for length %zu", idx, b->length);
        spec_bytebuffer_report(error, msg);
        return;
    }
    b->data[idx] = (unsigned char)v;
}

long long spec_bytebuffer_pop(SpecByteBuffer* b, long long def, SpecClosure* error) {
    if (!b) { spec_bytebuffer_report(error, "byte buffer is uninitialized"); return def; }
    if (b->length == 0) {
        spec_bytebuffer_report(error, "byte buffer pop on empty buffer");
        return def;
    }
    return (long long)b->data[--b->length];
}

long long spec_bytebuffer_length(SpecByteBuffer* b) {
    return b ? (long long)b->length : 0;
}

void spec_bytebuffer_clear(SpecByteBuffer* b) {
    if (b) b->length = 0;
}

String spec_bytebuffer_to_string(SpecByteBuffer* b) {
    if (!b || b->length == 0) return spec_string_intern("");
    return spec_string_from_bytes((const char*)b->data, b->length);
}
/* Spec Vec: lean pointer-vector skeleton for non-byte [T] (methods in a later phase) */
typedef struct {
    void** items;
    size_t length;
    size_t capacity;
    int elem_kind;
} SpecVec;

void spec_vec_destroy(void* self) {
    SpecVec* v = (SpecVec*)self;
    if (v) {
        for (size_t i = 0; i < v->length; i++) {
            if (!v->items[i]) continue;
            if (v->elem_kind == 1) spec_release(v->items[i]);
        }
        if (v->items) free(v->items);
    }
}

SpecVec* spec_vec_new_kind(int kind) {
    SpecVec* v = (SpecVec*)spec_alloc(sizeof(SpecVec), spec_vec_destroy);
    v->items = NULL;
    v->length = 0;
    v->capacity = 0;
    v->elem_kind = kind;
    return v;
}

SpecVec* spec_vec_new(void) {
    return spec_vec_new_kind(0);
}

SpecVec* spec_vec_new_object(void) {
    return spec_vec_new_kind(1);
}

SpecVec* spec_vec_new_string(void) {
    return spec_vec_new_object();
}

void spec_vec_push(SpecVec* v, void* item) {
    if (!v) return;
    if (v->length >= v->capacity) {
        size_t ncap = (v->capacity == 0) ? 8 : v->capacity * 2;
        v->items = (void**)spec_xrealloc(v->items, sizeof(void*) * ncap);
        v->capacity = ncap;
    }
    if (v->elem_kind == 1 && item) spec_retain(item);
    v->items[v->length++] = item;
}

void spec_vec_report(SpecClosure* error, const char* msg) {
    spec_call_closure_str(error ? error : spec_noop_closure(), spec_string_from_bytes(msg, strlen(msg)));
}

void* spec_vec_get(SpecVec* v, long long idx, void* def, SpecClosure* error) {
    if (!v) { spec_vec_report(error, "vector is uninitialized"); return def; }
    if (idx < 0 || (size_t)idx >= v->length) {
        char msg[96];
        snprintf(msg, sizeof(msg), "vector index out of bounds: index %lld for length %zu", idx, v->length);
        spec_vec_report(error, msg);
        return def;
    }
    void* val = v->items[idx];
    return val;
}

void spec_vec_set(SpecVec* v, long long idx, void* item, SpecClosure* error) {
    if (!v) { spec_vec_report(error, "vector is uninitialized"); return; }
    if (idx < 0 || (size_t)idx >= v->length) {
        char msg[96];
        snprintf(msg, sizeof(msg), "vector assignment out of bounds: index %lld for length %zu", idx, v->length);
        spec_vec_report(error, msg);
        return;
    }
    if (v->elem_kind == 1) {
        if (item) spec_retain(item);
        if (v->items[idx]) spec_release(v->items[idx]);
    }
    v->items[idx] = item;
}

void* spec_vec_pop(SpecVec* v, void* def, SpecClosure* error) {
    if (!v) { spec_vec_report(error, "vector is uninitialized"); return def; }
    if (v->length == 0) {
        spec_vec_report(error, "vector pop on empty vector");
        if (v->elem_kind == 1 && def) spec_retain(def);
        return def;
    }
    return v->items[--v->length];
}

long long spec_vec_length(SpecVec* v) {
    return v ? (long long)v->length : 0;
}

void spec_vec_clear(SpecVec* v) {
    if (!v) return;
    for (size_t i = 0; i < v->length; i++) {
        if (!v->items[i]) continue;
        if (v->elem_kind == 1) spec_release(v->items[i]);
    }
    v->length = 0;
}

typedef struct {
    String path;
    String content;
    String def;
    SpecClosure* on_success_read;
    SpecClosure* on_success_write;
    SpecClosure* on_error;
} SpecFileTask;

String spec_file_read(String path, String def, SpecClosure* on_success, SpecClosure* on_error) {
    if (!path || path->length == 0) {
        if (on_error) spec_call_closure_str(on_error, spec_string_intern("File error: Empty or invalid file path provided"));
        return def ? def : spec_string_intern("");
    }
    const char* pc = spec_buf_to_cstring((SpecBuf*)path);
    FILE* f = fopen(pc, "rb");
    if (!f) {
        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));
        return def ? def : spec_string_intern("");
    }
    if (fseek(f, 0, SEEK_END) != 0) {
        fclose(f);
        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));
        return def ? def : spec_string_intern("");
    }
    long size = ftell(f);
    if (size < 0) {
        fclose(f);
        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));
        return def ? def : spec_string_intern("");
    }
    fseek(f, 0, SEEK_SET);
    char* buf = (char*)malloc((size_t)size + 1);
    if (!buf) {
        fclose(f);
        if (on_error) spec_call_closure_str(on_error, spec_string_intern("File error: Memory allocation failed during read"));
        return def ? def : spec_string_intern("");
    }
    size_t read_bytes = fread(buf, 1, size, f);
    fclose(f);
    String out = spec_string_from_bytes(buf, read_bytes);
    free(buf);
    if (on_success) spec_call_closure_str(on_success, out);
    return out;
}
bool spec_file_write(String path, String content, SpecClosure* on_success, SpecClosure* on_error) {
    if (!path || path->length == 0) {
        if (on_error) spec_call_closure_str(on_error, spec_string_intern("File error: Empty or invalid file path provided"));
        return false;
    }
    const char* pc = spec_buf_to_cstring((SpecBuf*)path);
    size_t len = content ? ((SpecBuf*)content)->length : 0;
    const char* cc = len ? (const char*)((SpecBuf*)content)->data : "";
    FILE* f = fopen(pc, "wb");
    if (!f) {
        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));
        return false;
    }
    size_t written = fwrite(cc, 1, len, f);
    if (fclose(f) != 0) written = (size_t)-1;
    if (written != len) {
        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));
        return false;
    }
    if (on_success) spec_call_closure_int(on_success, (long long)written);
    return true;
}
bool spec_file_append(String path, String content, SpecClosure* on_success, SpecClosure* on_error) {
    if (!path || path->length == 0) {
        if (on_error) spec_call_closure_str(on_error, spec_string_intern("File error: Empty or invalid file path provided"));
        return false;
    }
    const char* pc = spec_buf_to_cstring((SpecBuf*)path);
    size_t len = content ? ((SpecBuf*)content)->length : 0;
    if (len == 0) {
        if (on_success) spec_call_closure_int(on_success, 0);
        return true;
    }
    const char* cc = (const char*)((SpecBuf*)content)->data;
    FILE* f = fopen(pc, "ab");
    if (!f) {
        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));
        return false;
    }
    size_t written = fwrite(cc, 1, len, f);
    if (fclose(f) != 0) written = (size_t)-1;
    if (written != len) {
        if (on_error) spec_call_closure_str(on_error, spec_string_from_bytes(strerror(errno), strlen(strerror(errno))));
        return false;
    }
    if (on_success) spec_call_closure_int(on_success, (long long)written);
    return true;
}
static void* spec_file_read_worker(void* arg) {
    SpecFileTask* task = (SpecFileTask*)arg;
    String res = spec_file_read(task->path, task->def, task->on_success_read, task->on_error);
    if (res) spec_release(res);
    if (task->path) spec_release(task->path);
    if (task->def) spec_release(task->def);
    if (task->on_success_read) spec_release(task->on_success_read);
    if (task->on_error) spec_release(task->on_error);
    free(task);
    spec_pool_thread_cleanup();
    spec_async_task_finished();
    return NULL;
}

void spec_file_read_async(String path, String def, SpecClosure* on_success, SpecClosure* on_error) {
    SpecFileTask* task = (SpecFileTask*)spec_xmalloc(sizeof(SpecFileTask));
    memset(task, 0, sizeof(SpecFileTask));
    task->path = path ? (String)spec_retain((void*)path) : NULL;
    task->def = def ? (String)spec_retain((void*)def) : NULL;
    task->on_success_read = (SpecClosure*)spec_retain(on_success);
    task->on_error = (SpecClosure*)spec_retain(on_error);
    spec_async_task_started();
    pthread_t tid;
    if (pthread_create(&tid, NULL, spec_file_read_worker, task) != 0) {
        spec_file_read_worker(task);
        return;
    }
    pthread_detach(tid);
}

static void* spec_file_write_worker(void* arg) {
    SpecFileTask* task = (SpecFileTask*)arg;
    spec_file_write(task->path, task->content, task->on_success_write, task->on_error);
    if (task->path) spec_release(task->path);
    if (task->content) spec_release(task->content);
    if (task->on_success_write) spec_release(task->on_success_write);
    if (task->on_error) spec_release(task->on_error);
    free(task);
    spec_pool_thread_cleanup();
    spec_async_task_finished();
    return NULL;
}

void spec_file_write_async(String path, String content, SpecClosure* on_success, SpecClosure* on_error) {
    SpecFileTask* task = (SpecFileTask*)spec_xmalloc(sizeof(SpecFileTask));
    memset(task, 0, sizeof(SpecFileTask));
    task->path = path ? (String)spec_retain((void*)path) : NULL;
    task->content = content ? (String)spec_retain((void*)content) : NULL;
    task->on_success_write = (SpecClosure*)spec_retain(on_success);
    task->on_error = (SpecClosure*)spec_retain(on_error);
    spec_async_task_started();
    pthread_t tid;
    if (pthread_create(&tid, NULL, spec_file_write_worker, task) != 0) {
        spec_file_write_worker(task);
        return;
    }
    pthread_detach(tid);
}

bool spec_file_exists(String path) {
    if (!path) return false;
    FILE* f = fopen(spec_buf_to_cstring((SpecBuf*)path), "r");
    if (f) {
        fclose(f);
        return true;
    }
    return false;
}
bool spec_file_remove(String path) {
    if (!path || path->length == 0) return false;
    return remove(spec_buf_to_cstring((SpecBuf*)path)) == 0;
}
String spec_file_temp(String template) {
    if (!template || template->length == 0) template = spec_string_intern("/tmp/spec_XXXXXX");
    const char* tpl = spec_buf_to_cstring((SpecBuf*)template);
    size_t len = strlen(tpl);
    char* buf = (char*)spec_xmalloc(len + 16);
    strcpy(buf, tpl);
    if (!strstr(buf, "XXXXXX")) {
        strcat(buf, "_XXXXXX");
    }
    int fd = mkstemp(buf);
    if (fd == -1) {
        free(buf);
        return spec_string_intern("");
    }
    close(fd);
    String res = spec_string_from_chars(buf);
    free(buf);
    return res;
}
/* Process Package Primitives */
long long spec_process_execute(String command, SpecArray* args) {
    if (!command) return -1;
    const char* cc = spec_buf_to_cstring((SpecBuf*)command);
    /* Each argument is passed to the shell as ONE single-quoted word (a
       quote inside becomes quote, backslash, quote, quote), so spaces and
       shell metacharacters in arguments stay data. The command word
       itself is left to the shell. */
    size_t total_len = strlen(cc) + 1;
    if (args) {
        for (size_t i = 0; i < args->length; i++) {
            if (!args->items[i]) continue;
            const char* a = spec_buf_to_cstring((SpecBuf*)args->items[i]);
            size_t quotes = 0;
            for (size_t k = 0; a[k]; k++) if (a[k] == 39) quotes++;
            total_len += strlen(a) + 3 * quotes + 3;
        }
    }
    char* cmd_line = (char*)spec_xmalloc(total_len + 1);
    char* w = cmd_line;
    size_t cmd_len = strlen(cc);
    memcpy(w, cc, cmd_len);
    w += cmd_len;
    if (args) {
        for (size_t i = 0; i < args->length; i++) {
            if (!args->items[i]) continue;
            const char* a = spec_buf_to_cstring((SpecBuf*)args->items[i]);
            *w++ = ' ';
            *w++ = 39;
            for (size_t k = 0; a[k]; k++) {
                if (a[k] == 39) { *w++ = 39; *w++ = 92; *w++ = 39; *w++ = 39; }
                else *w++ = a[k];
            }
            *w++ = 39;
        }
    }
    *w = 0;
    int status = system(cmd_line);
    free(cmd_line);
    if (status == -1) return -1;
    if (WIFSIGNALED(status)) return 128 + (long long)WTERMSIG(status);
    return (long long)WEXITSTATUS(status);
}
void spec_process_sleep(long long ms) {
    if (ms <= 0) return;
    struct timespec ts;
    ts.tv_sec = ms / 1000;
    ts.tv_nsec = (ms % 1000) * 1000000L;
    nanosleep(&ts, NULL);
}

long long spec_process_get_pid(void) {
    return (long long)getpid();
}

/* Math Package Primitives */
double spec_math_round(double v) { return round(v); }
double spec_math_floor(double v) { return floor(v); }
double spec_math_ceil(double v) { return ceil(v); }
double spec_math_abs(double v) { return fabs(v); }
static inline long long spec_math_abs_int(long long v) { return v < 0 ? -v : v; }
double spec_math_min(double a, double b) { return (a < b) ? a : b; }
double spec_math_max(double a, double b) { return (a > b) ? a : b; }
double spec_math_clamp(double v, double lo, double hi) {
    if (hi < lo) return lo;
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}
double spec_math_sqrt(double v) { return v < 0.0 ? 0.0 : sqrt(v); }
double spec_math_sin(double v) { return sin(v); }
double spec_math_cos(double v) { return cos(v); }
double spec_math_tan(double v) { return tan(v); }
double spec_math_atan2(double y, double x) { return atan2(y, x); }
double spec_math_log(double v) { return v <= 0.0 ? 0.0 : log(v); }
double spec_math_log2(double v) { return v <= 0.0 ? 0.0 : log2(v); }
double spec_math_pow(double base, double exp) { return pow(base, exp); }
long long spec_math_to_int(double v) {
    if (v != v) return 0;
    if (v >= 9223372036854775808.0) return 9223372036854775807LL;
    if (v <= -9223372036854775808.0) return (-9223372036854775807LL - 1);
    return (long long)v;
}
double spec_math_to_float(long long v) { return (double)v; }

double spec_math_random(double min, double max) {
    if (min >= max) return ((double)rand() / ((double)RAND_MAX + 1.0));
    return min + ((double)rand() / ((double)RAND_MAX + 1.0)) * (max - min);
}

/* Integer Base Conversion */
String spec_int_to_base(long long v, long long base, long long digits) {
    if (base < 2 || base > 36) base = 10;
    if (digits < 0) digits = 0;
    const char* digs = "0123456789abcdefghijklmnopqrstuvwxyz";
    char buf[80];
    int idx = 79;
    buf[idx] = '\0';
    int neg = v < 0;
    unsigned long long u = neg ? (unsigned long long)(-(v + 1)) + 1ULL : (unsigned long long)v;
    if (u == 0) buf[--idx] = '0';
    while (u > 0) { buf[--idx] = digs[u % (unsigned long long)base]; u /= (unsigned long long)base; }
    while ((79 - idx) < (int)digits && idx > 0) buf[--idx] = '0';
    if (neg && idx > 0) buf[--idx] = '-';
    return spec_string_from_chars(buf + idx);
}

/* Terminal Metrics */
long long spec_term_width(void) {
    if (!isatty(1)) return 0;
    struct winsize ws;
    if (ioctl(1, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0) return (long long)ws.ws_col;
    char* cols = getenv("COLUMNS");
    if (cols) return (long long)atoi(cols);
    return 78;
}

long long spec_term_height(void) {
    if (!isatty(1)) return 0;
    struct winsize ws;
    if (ioctl(1, TIOCGWINSZ, &ws) == 0 && ws.ws_row > 0) return (long long)ws.ws_row;
    char* lines = getenv("LINES");
    if (lines) return (long long)atoi(lines);
    return 24;
}

/* Atomic Slots: dynamically growing chunked table.
   Starts low (0 chunks allocated) and allocates chunks on demand.
   Level 0 holds 16 slots; level k (k >= 1) holds 2^(k+3) slots.
   Total addressable capacity exceeds 2^60 slots with zero reallocations,
   so slot pointers are permanent and all reads/writes are lock-free. */
static _Atomic(atomic_llong*) _spec_atomic_levels[64];
static pthread_mutex_t _spec_atomic_mutex = PTHREAD_MUTEX_INITIALIZER;

static atomic_llong* spec_atomic_slot_ptr(long long slot) {
    if (slot < 0) {
        spec_panic_bounds("Atomic slot", slot, 0);
    }
    size_t level = 0;
    size_t offset = 0;
    size_t chunk_size = 16;
    if (slot < 16) {
        level = 0;
        offset = (size_t)slot;
        chunk_size = 16;
    } else {
        int highest_bit = 63 - __builtin_clzll((unsigned long long)slot);
        level = (size_t)(highest_bit - 3);
        if (level >= 64) {
            spec_panic_bounds("Atomic slot index too large", slot, 0);
        }
        chunk_size = (size_t)1ULL << highest_bit;
        offset = (size_t)slot - chunk_size;
    }

    atomic_llong* chunk = atomic_load_explicit(&_spec_atomic_levels[level], memory_order_acquire);
    if (!chunk) {
        pthread_mutex_lock(&_spec_atomic_mutex);
        chunk = atomic_load_explicit(&_spec_atomic_levels[level], memory_order_relaxed);
        if (!chunk) {
            chunk = (atomic_llong*)calloc(chunk_size, sizeof(atomic_llong));
            if (!chunk) { spec_panic("Out of memory allocating atomic slots"); }
            atomic_store_explicit(&_spec_atomic_levels[level], chunk, memory_order_release);
        }
        pthread_mutex_unlock(&_spec_atomic_mutex);
    }
    return &chunk[offset];
}

long long spec_atomic_add(long long slot, long long v) {
    atomic_llong* p = spec_atomic_slot_ptr(slot);
    return atomic_fetch_add(p, v) + v;
}

long long spec_atomic_put(long long slot, long long v) {
    atomic_llong* p = spec_atomic_slot_ptr(slot);
    atomic_store(p, v);
    return v;
}

long long spec_atomic_get(long long slot) {
    atomic_llong* p = spec_atomic_slot_ptr(slot);
    return atomic_load(p);
}

/* Per-Thread RNG (xorshift64*, lock-free, self-seeding) */
static __thread unsigned long long _spec_rng_state = 0;

static unsigned long long spec_rng_next(void) {
    unsigned long long x = _spec_rng_state;
    x ^= x >> 12;
    x ^= x << 25;
    x ^= x >> 27;
    _spec_rng_state = x;
    return x * 0x2545F4914F6CDD1DULL;
}

void spec_fast_random_seed(long long idx) {
    _spec_rng_state = 0x9E3779B97F4A7C15ULL ^ ((unsigned long long)idx * 0xBF58476D1CE4E5B9ULL + 0x94D049BB133111EBULL);
    if (_spec_rng_state == 0) _spec_rng_state = 1;
    spec_rng_next();
    spec_rng_next();
    spec_rng_next();
}

double spec_fast_random(void) {
    if (_spec_rng_state == 0) spec_fast_random_seed(0x5DEECE66DULL);
    return (double)(spec_rng_next() >> 11) * (1.0 / 9007199254740992.0);
}

/* Parallel Fan-Out */
typedef long long (*SpecWorkerFn)(void* env, long long idx, long long count);
typedef struct { SpecWorkerFn fn; void* env; long long idx; long long count; } SpecParallelTask;

static void* spec_parallel_worker(void* arg) {
    SpecParallelTask* t = (SpecParallelTask*)arg;
    spec_fast_random_seed(t->idx);
    long long r = t->fn(t->env, t->idx, t->count);
    free(t);
    spec_pool_thread_cleanup();
    return (void*)(intptr_t)r;
}

long long spec_parallel_run(long long threads, long long iterations, void* worker_closure) {
    if (threads < 1) threads = 1;
    SpecClosure* cls = (SpecClosure*)worker_closure;
    if (!cls || !cls->fn) spec_panic("Parallel:run received null worker Function");
    pthread_t* tids = (pthread_t*)spec_xmalloc(sizeof(pthread_t) * (size_t)threads);
    bool* spawned = (bool*)spec_xmalloc(sizeof(bool) * (size_t)threads);
    long long total = 0;
    long long base = iterations / threads;
    long long rem = iterations % threads;
    for (long long i = 0; i < threads; i++) {
        SpecParallelTask* t = (SpecParallelTask*)spec_xmalloc(sizeof(SpecParallelTask));
        t->fn = (SpecWorkerFn)cls->fn;
        t->env = cls->env;
        t->idx = i;
        t->count = base + (i < rem ? 1 : 0);
        spawned[i] = (pthread_create(&tids[i], NULL, spec_parallel_worker, t) == 0);
        if (!spawned[i]) {
            total += (long long)(intptr_t)spec_parallel_worker(t);
        }
    }
    for (long long i = 0; i < threads; i++) {
        if (!spawned[i]) continue;
        void* ret = NULL;
        pthread_join(tids[i], &ret);
        total += (long long)(intptr_t)ret;
    }
    free(tids);
    free(spawned);
    return total;
}

/* Type Name Introspection */
String spec_type_name(const void* obj) {
    if (!obj) return spec_string_intern("");
    return spec_string_intern(*((const char**)obj));
}

/* Identity hash: a stable per-object value derived from the address
   (mixed so neighboring allocations differ). The default toString's
   hash component. */
long long spec_object_hash(const void* obj) {
    if (!obj) return 0;
    unsigned long long h = (unsigned long long)(intptr_t)obj;
    h ^= h >> 33;
    h *= 0xff51afd7ed558ccdULL;
    h ^= h >> 33;
    return (long long)h;
}

/* Reference identity (the Introspection floor): pointer equality —
   the runtime's identity notion (held singletons and enum variants
   are distinct live instances, so address equality is the test). */
static inline bool spec_same_ref(const void* a, const void* b) {
    return a == b;
}

/* Held-member metadata: per-class held-member name
   tables, registered by the emitted Held Metadata section (the tables
   preserve declaration order — the ordinal index). Field slots carry
   the once-guard accessor's address; function slots are NULL. The
   tentative array definition is completed by the generated registry,
   which always carries the {0,0,0,0} terminator. */
typedef struct SpecHeldEntry {
    const char* type_name;
    const char* const* names;
    int count;
    void* (*const* getters)(void);
} SpecHeldEntry;
static const SpecHeldEntry spec_held_registry[];

static const SpecHeldEntry* spec_held_entry_of(const void* obj) {
    if (!obj) return 0;
    const char* tn = *((const char**)obj);
    if (!tn) return 0;
    for (int i = 0; spec_held_registry[i].type_name; i++) {
        if (strcmp(spec_held_registry[i].type_name, tn) == 0) return &spec_held_registry[i];
    }
    return 0;
}

long long spec_held_count(const void* obj) {
    const SpecHeldEntry* e = spec_held_entry_of(obj);
    return e ? (long long)e->count : 0;
}

String spec_held_name(const void* obj, long long index) {
    const SpecHeldEntry* e = spec_held_entry_of(obj);
    if (!e || index < 0 || index >= (long long)e->count) return spec_string_intern("");
    return spec_string_intern(e->names[index]);
}

bool spec_has_held(const void* obj, String name) {
    const SpecHeldEntry* e = spec_held_entry_of(obj);
    if (!e) return false;
    for (int i = 0; i < e->count; i++) {
        if (spec_string_equals(spec_string_intern(e->names[i]), name)) return true;
    }
    return false;
}

/* The ordinal scan : the first held-FIELD index whose
   lazily-constructed instance is the object itself. The desugared
   enum variants are held singletons in declaration order, so this is
   the variant's ordinal. Calling it initializes the class's held
   singletons (the once-guards are idempotent). -1 when the class
   holds no fields or the object is not one of them. */
long long spec_held_index_of(const void* obj) {
    const SpecHeldEntry* e = spec_held_entry_of(obj);
    if (!e || !e->getters) return -1;
    for (int i = 0; i < e->count; i++) {
        if (e->getters[i]) {
            void* inst = e->getters[i]();
            bool hit = (inst == (void*)obj);
            spec_release(inst);
            if (hit) return (long long)i;
        }
    }
    return -1;
}

/* Class Registry Introspection : the runtime reflection floor. The
   generator emits one SpecClassMeta per class (class order) into
   spec_class_registry; these helpers query that registry. Declared
   `static inline` and consumed by nobody until the wrapper methods
   land (the two-part landing): unused static inlines are never
   emitted, so the not-yet-defined registry extern cannot break a
   link in the interim. The floor is domain-neutral — it describes
   classes and methods; conventions live in consumers. */
typedef struct SpecMethodMeta {
    const char* name;
    void* fn;
    int flags;          /* bit 0: void return; bit 1: zero params */
    int line;
} SpecMethodMeta;

typedef struct SpecClassMeta {
    const char* name;
    const char* source_file;
    const char** base_names;
    int base_count;
    void* (*construct)(void);
    const SpecMethodMeta* methods;
    int method_count;
} SpecClassMeta;

extern const SpecClassMeta* const spec_class_registry[];
/* Defined by the emitted registry (Land B). Declared here so the
   helpers compile; the inline bodies are never emitted while unconsumed,
   so no reference materializes until the definition exists. */
int spec_class_registry_count(void);

static inline const SpecClassMeta* spec_class_meta(int index) {
    if (index < 0 || index >= spec_class_registry_count()) return NULL;
    return spec_class_registry[index];
}

static inline const SpecClassMeta* spec_class_find(const char* name) {
    if (!name) return NULL;
    for (int i = 0; i < spec_class_registry_count(); i++) {
        const SpecClassMeta* m = spec_class_registry[i];
        if (m && m->name && strcmp(m->name, name) == 0) return m;
    }
    return NULL;
}

/* Own methods first, then up the base lattice — inherited methods
   resolve through base_names, so invocation works on derived
   instances (prefix struct layout). */
static inline const SpecMethodMeta* spec_class_find_method(
        const SpecClassMeta* cls, const char* name) {
    if (!cls || !name) return NULL;
    for (int i = 0; i < cls->method_count; i++) {
        if (strcmp(cls->methods[i].name, name) == 0) return &cls->methods[i];
    }
    for (int b = 0; b < cls->base_count; b++) {
        const SpecClassMeta* base = spec_class_find(cls->base_names[b]);
        const SpecMethodMeta* m = spec_class_find_method(base, name);
        if (m) return m;
    }
    return NULL;
}

static inline void* spec_class_construct_by_meta(const SpecClassMeta* cls) {
    if (!cls || !cls->construct) return NULL;
    return cls->construct();
}

/* The v1 invoke contract: void, zero parameters. Anything else is a
   loud panic — the bounds-check philosophy, never a silent miss. */
static inline void spec_invoke_void_by_meta(void* instance,
        const SpecMethodMeta* m) {
    if (!m || !m->fn || (m->flags & 3) != 3) {
        spec_panic("Introspection:invoke supports void zero-parameter methods only");
    }
    ((void (*)(void*))m->fn)(instance);
}

/* Clock & Memory Metrics */
long long spec_clock_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ((long long)ts.tv_sec * 1000) + (ts.tv_nsec / 1000000);
}

long long spec_mem_peak_kb(void) {
    struct rusage ru;
    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0;
    return (long long)ru.ru_maxrss;
}

long long spec_thread_count(void) {
    FILE* f = fopen("/proc/self/status", "r");
    if (!f) return 1;
    char line[256];
    long long n = 1;
    while (fgets(line, sizeof(line), f)) {
        if (strncmp(line, "Threads:", 8) == 0) { n = atoll(line + 8); break; }
    }
    fclose(f);
    return n;
}

/* Process Resource Monitoring (instantaneous RSS and CPU sampling) */
static pthread_t _spec_mon_thread;
static _Atomic bool _spec_mon_active = false;
static _Atomic long long _spec_mon_sample_count = 0;
static _Atomic long long _spec_mon_mem_sum_kb = 0;
static _Atomic long long _spec_mon_peak_mem_kb = 0;
static _Atomic long long _spec_mon_peak_cpu_pct = 0;
static long long _spec_mon_start_wall_us = 0;
static long long _spec_mon_start_cpu_us = 0;
static long long _spec_mon_total_wall_us = 0;
static long long _spec_mon_total_cpu_us = 0;

long long spec_monitor_avg_cpu_pct(void) {
    if (_spec_mon_total_wall_us <= 0) return 0;
    return (_spec_mon_total_cpu_us * 100) / _spec_mon_total_wall_us;
}

long long spec_monitor_peak_cpu_pct(void) {
    return _spec_mon_peak_cpu_pct;
}

long long spec_monitor_avg_mem_kb(void) {
    long long count = _spec_mon_sample_count;
    if (count <= 0) return _spec_mon_peak_mem_kb;
    return _spec_mon_mem_sum_kb / count;
}

long long spec_monitor_peak_mem_kb(void) {
    return _spec_mon_peak_mem_kb;
}

static void* _spec_monitor_worker(void* arg) {
    (void)arg;
    struct timespec sleep_ts = {0, 20000000}; /* 20ms */
    long long page_size = sysconf(_SC_PAGESIZE);
    if (page_size <= 0) page_size = 4096;

    struct timespec last_ts;
    clock_gettime(CLOCK_MONOTONIC, &last_ts);
    long long last_wall_us = ((long long)last_ts.tv_sec * 1000000) + (last_ts.tv_nsec / 1000);
    struct rusage last_ru;
    getrusage(RUSAGE_SELF, &last_ru);
    long long last_cpu_us = ((long long)last_ru.ru_utime.tv_sec + last_ru.ru_stime.tv_sec) * 1000000 + (last_ru.ru_utime.tv_usec + last_ru.ru_stime.tv_usec);

    while (_spec_mon_active) {
        nanosleep(&sleep_ts, NULL);
        if (!_spec_mon_active) break;

        long long cur_rss_kb = 0;
        FILE* f = fopen("/proc/self/statm", "r");
        if (f) {
            long long dummy = 0, rss_pages = 0;
            if (fscanf(f, "%lld %lld", &dummy, &rss_pages) == 2) {
                cur_rss_kb = (rss_pages * page_size) / 1024;
            }
            fclose(f);
        }
        if (cur_rss_kb > 0) {
            _spec_mon_mem_sum_kb += cur_rss_kb;
            _spec_mon_sample_count++;
            if (cur_rss_kb > _spec_mon_peak_mem_kb) {
                _spec_mon_peak_mem_kb = cur_rss_kb;
            }
        }

        struct timespec now_ts;
        clock_gettime(CLOCK_MONOTONIC, &now_ts);
        long long now_wall_us = ((long long)now_ts.tv_sec * 1000000) + (now_ts.tv_nsec / 1000);
        struct rusage now_ru;
        getrusage(RUSAGE_SELF, &now_ru);
        long long now_cpu_us = ((long long)now_ru.ru_utime.tv_sec + now_ru.ru_stime.tv_sec) * 1000000 + (now_ru.ru_utime.tv_usec + now_ru.ru_stime.tv_usec);

        long long d_wall = now_wall_us - last_wall_us;
        long long d_cpu = now_cpu_us - last_cpu_us;
        if (d_wall >= 15000) {
            long long cpu_pct = (d_cpu * 100) / d_wall;
            if (cpu_pct > _spec_mon_peak_cpu_pct) {
                _spec_mon_peak_cpu_pct = cpu_pct;
            }
            last_wall_us = now_wall_us;
            last_cpu_us = now_cpu_us;
        }
    }
    return NULL;
}

void spec_monitor_start(void) {
    if (_spec_mon_active) return;
    _spec_mon_sample_count = 0;
    _spec_mon_mem_sum_kb = 0;
    _spec_mon_peak_mem_kb = 0;
    _spec_mon_peak_cpu_pct = 0;

    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    _spec_mon_start_wall_us = ((long long)ts.tv_sec * 1000000) + (ts.tv_nsec / 1000);

    struct rusage ru;
    getrusage(RUSAGE_SELF, &ru);
    _spec_mon_start_cpu_us = ((long long)ru.ru_utime.tv_sec + ru.ru_stime.tv_sec) * 1000000 + (ru.ru_utime.tv_usec + ru.ru_stime.tv_usec);

    _spec_mon_active = true;
    pthread_create(&_spec_mon_thread, NULL, _spec_monitor_worker, NULL);
}

void spec_monitor_stop(void) {
    if (!_spec_mon_active) return;
    _spec_mon_active = false;
    pthread_join(_spec_mon_thread, NULL);

    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    long long end_wall_us = ((long long)ts.tv_sec * 1000000) + (ts.tv_nsec / 1000);

    struct rusage ru;
    getrusage(RUSAGE_SELF, &ru);
    long long end_cpu_us = ((long long)ru.ru_utime.tv_sec + ru.ru_stime.tv_sec) * 1000000 + (ru.ru_utime.tv_usec + ru.ru_stime.tv_usec);

    _spec_mon_total_wall_us = end_wall_us - _spec_mon_start_wall_us;
    _spec_mon_total_cpu_us = end_cpu_us - _spec_mon_start_cpu_us;

    if (ru.ru_maxrss > _spec_mon_peak_mem_kb) {
        _spec_mon_peak_mem_kb = ru.ru_maxrss;
    }
    long long avg_cpu = spec_monitor_avg_cpu_pct();
    if (avg_cpu > _spec_mon_peak_cpu_pct) {
        _spec_mon_peak_cpu_pct = avg_cpu;
    }
}

/* Error Output Primitive */
void spec_error_line(String s) {
    const char* cs = s ? spec_buf_to_cstring((SpecBuf*)s) : "";
    fprintf(stderr, "%s\n", cs);
}

/* The console floor (the sysinternal binding targets): the wrappers
   name these consOut/consIn/line on the Spec side; the C names are
   the internal provenance. */
void spec_print_line(String s) {
    printf("%s\n", s ? spec_buf_to_cstring((SpecBuf*)s) : "");
}

void spec_print(String s) {
    printf("%s", s ? spec_buf_to_cstring((SpecBuf*)s) : "");
    fflush(stdout);
}

/* Reads one line from stdin (the trailing newline stripped) and hands
   it to the on-line closure; at end of input nothing is handed over. */
void spec_read_line(SpecClosure* on_line) {
    char* _line = NULL;
    size_t _cap = 0;
    ssize_t _n = getline(&_line, &_cap, stdin);
    if (_n >= 0) {
        if (_n > 0 && _line[_n - 1] == '\n') _line[_n - 1] = '\0';
        String text = spec_string_from_chars(_line);
        spec_call_closure_str(on_line, text);
        spec_release(text);
    }
    free(_line);
}

/* Terminates the current process with the given exit status. */
void spec_process_exit(long long status) {
    exit((int)status);
}
