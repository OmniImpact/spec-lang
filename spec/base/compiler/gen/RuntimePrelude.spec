    long long ms = ns / 1000000LL;
    if (ms > 1) {
        Sleep((DWORD)(ms - 1));
    }
    while (spec_time_monotonic_ns() < target) {
        Sleep(0);
    }
#else
    struct timespec ts;
    ts.tv_sec = ns / 1000000000LL;
    ts.tv_nsec = ns % 1000000000LL;
    while (nanosleep(&ts, &ts) == -1 && errno == EINTR) {
    }
#endif
}

