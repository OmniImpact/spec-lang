/* Spec Automated Reference Counting (ARC) Primitives */
#define SPEC_S_IMMORTAL 1u
#define SPEC_S_HASLEN 2u
#define SPEC_S_ARENA 4u
typedef struct {
    _Atomic uint32_t ref_count;
    void (*destroy)(void*);
    _Atomic uint32_t sflags;
    uint32_t slen;
} SpecHeader;

#define SPEC_HEADER(obj) (((SpecHeader*)(obj)) - 1)

static inline void* spec_alloc(size_t size, void (*destroy)(void*)) {
    SpecHeader* h = (SpecHeader*)calloc(1, sizeof(SpecHeader) + size);
    if (!h) { fprintf(stderr, "[Spec Panic] Out of memory\n"); exit(1); }
    h->ref_count = 1;
    h->destroy = destroy;
    return (void*)(h + 1);
}

/* Checked allocation: a failed allocation is a loud panic, never a
   NULL dereference or a silently dropped (and leaked) block. */
static inline void* spec_xmalloc(size_t n) {
    void* p = malloc(n ? n : 1);
    if (!p) { fprintf(stderr, "[Spec Panic] Out of memory\n"); exit(1); }
    return p;
}

static inline void* spec_xrealloc(void* old, size_t n) {
    void* p = realloc(old, n ? n : 1);
    if (!p) { fprintf(stderr, "[Spec Panic] Out of memory\n"); exit(1); }
    return p;
}

static inline char* spec_xstrdup(const char* s) {
    size_t n = strlen(s) + 1;
    char* p = (char*)spec_xmalloc(n);
    memcpy(p, s, n);
    return p;
}

static inline void* spec_retain(void* obj) {
    if (!obj) return NULL;
    SpecHeader* h = SPEC_HEADER(obj);
    if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_IMMORTAL) return obj;
    atomic_fetch_add_explicit(&h->ref_count, 1, memory_order_relaxed);
    return obj;
}

static inline void spec_release(void* obj) {
    if (!obj) return;
    SpecHeader* h = SPEC_HEADER(obj);
    if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_IMMORTAL) return;
    if (atomic_load_explicit(&h->ref_count, memory_order_relaxed) == 0) {
        void (*d)(void*) = h->destroy;
        h->destroy = NULL;
        if (d) d(obj);
        return;
    }
    if (atomic_fetch_sub_explicit(&h->ref_count, 1, memory_order_acq_rel) == 1) {
        void (*d)(void*) = h->destroy;
        h->destroy = NULL;
        if (d) d(obj);
        /* Arena-owned headers live in arena blocks: run the destructor
           (freeing the object's malloc'd data) but never free(h) — the
           wholesale drain reclaims the block. */
        if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_ARENA) return;
        free(h);
    }
}

static inline void* spec_assign(void** dest, void* src) {
    if (src) spec_retain(src);
    if (*dest) spec_release(*dest);
    *dest = src;
    return src;
}

static inline void* spec_assign_transfer(void** dest, void* src) {
    if (*dest) spec_release(*dest);
    *dest = src;
    return src;
}

static inline void spec_scope_cleanup(void* pptr) {
    void* obj = *(void**)pptr;
    if (obj) spec_release(obj);
}

