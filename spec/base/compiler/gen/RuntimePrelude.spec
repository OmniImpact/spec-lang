}

long long spec_thread_count(void) {
    FILE* f = fopen("/proc/self/status", "r");
    if (!f) return 1;
    char line[256];
    long long n = 1;
    while (fgets(line, sizeof(line), f)) {
        if (strncmp(line, "Threads:", 8) == 0) { n = atoll(line + 8); break; }
    }
    fclose(f);
    return n;
}

