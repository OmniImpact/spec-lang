/* SpecBox: Heap-allocated reference cell for shared mutable closure captures */
typedef struct SpecBox {
    int64_t val;
    bool is_arc;
} SpecBox;

static inline void spec_box_destroy(void* self) {
    SpecBox* b = (SpecBox*)self;
    if (b) {
        if (b->is_arc && b->val) {
            spec_release((void*)b->val);
            b->val = 0;
        }
    }
