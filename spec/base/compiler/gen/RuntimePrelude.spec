/* Spec Runtime Panic & Safety Utilities */




bool spec_is_subclass_of(const char* actual, const char* target);

static inline void* spec_cast_check(const void* obj, const char* target) {
    if (!obj) return NULL;
    const char* actual = *((const char**)obj);
    if (!spec_is_subclass_of(actual, target)) {
        spec_panic_cast(actual, target);
    }
    return (void*)obj;
}

/* The process object arena flag: the compiler driver activates it; user
   programs never do. Lives at the top so every container constructor
   below can consult it. */
extern bool _spec_arena_active;
void* spec_arena_alloc_object(size_t size, void (*destroy)(void*));
void spec_arena_drain_objects(void);


/* Spec Automated Reference Counting (ARC) Primitives */
#define SPEC_S_IMMORTAL 1u
#define SPEC_S_HASLEN 2u
#define SPEC_S_ARENA 4u
typedef struct {
    _Atomic uint32_t ref_count;
    void (*destroy)(void*);
    _Atomic uint32_t sflags;
    uint32_t slen;
} SpecHeader;

#define SPEC_HEADER(obj) (((SpecHeader*)(obj)) - 1)

static inline void* spec_alloc(size_t size, void (*destroy)(void*)) {
    SpecHeader* h = (SpecHeader*)calloc(1, sizeof(SpecHeader) + size);
    if (!h) { fprintf(stderr, "[Spec Panic] Out of memory\n"); exit(1); }
    h->ref_count = 1;
    h->destroy = destroy;
    return (void*)(h + 1);
}

/* Checked allocation: a failed allocation is a loud panic, never a
   NULL dereference or a silently dropped (and leaked) block. */
static inline void* spec_xmalloc(size_t n) {
    void* p = malloc(n ? n : 1);
    if (!p) { fprintf(stderr, "[Spec Panic] Out of memory\n"); exit(1); }
    return p;
}

static inline void* spec_xrealloc(void* old, size_t n) {
    void* p = realloc(old, n ? n : 1);
    if (!p) { fprintf(stderr, "[Spec Panic] Out of memory\n"); exit(1); }
    return p;
}

static inline char* spec_xstrdup(const char* s) {
    size_t n = strlen(s) + 1;
    char* p = (char*)spec_xmalloc(n);
    memcpy(p, s, n);
    return p;
}

static inline void* spec_retain(void* obj) {
    if (!obj) return NULL;
    SpecHeader* h = SPEC_HEADER(obj);
    if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_IMMORTAL) return obj;
    atomic_fetch_add_explicit(&h->ref_count, 1, memory_order_relaxed);
    return obj;
}

static inline void spec_release(void* obj) {
    if (!obj) return;
    SpecHeader* h = SPEC_HEADER(obj);
    if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_IMMORTAL) return;
    if (atomic_load_explicit(&h->ref_count, memory_order_relaxed) == 0) {
        void (*d)(void*) = h->destroy;
        h->destroy = NULL;
        if (d) d(obj);
        return;
    }
    if (atomic_fetch_sub_explicit(&h->ref_count, 1, memory_order_acq_rel) == 1) {
        void (*d)(void*) = h->destroy;
        h->destroy = NULL;
        if (d) d(obj);
        /* Arena-owned headers live in arena blocks: run the destructor
           (freeing the object's malloc'd data) but never free(h) — the
           wholesale drain reclaims the block. */
        if (atomic_load_explicit(&h->sflags, memory_order_relaxed) & SPEC_S_ARENA) return;
        free(h);
    }
}

static inline void* spec_assign(void** dest, void* src) {
    if (src) spec_retain(src);
    if (*dest) spec_release(*dest);
    *dest = src;
    return src;
}

static inline void* spec_assign_transfer(void** dest, void* src) {
    if (*dest) spec_release(*dest);
    *dest = src;
    return src;
}

static inline void spec_scope_cleanup(void* pptr) {
    void* obj = *(void**)pptr;
    if (obj) spec_release(obj);
}

#define SPEC_AUTO __attribute__((cleanup(spec_scope_cleanup)))

/* Spec String Core: refcounted, NUL-terminated, optionally interned.
   A String value is a char* into a spec_alloc block whose header carries
   a cached length and an immortal flag for interned literals. */
#define SPEC_INTERN_INITIAL_CAP 256
typedef struct SpecInternEntry {
    String s;
    uint64_t hash;
    struct SpecInternEntry* next;
} SpecInternEntry;

typedef struct SpecInternTable {
    size_t capacity;
    size_t mask;
    size_t count;
    _Atomic(SpecInternEntry*) buckets[];
} SpecInternTable;

/* The intern table reads LOCK-FREE — the emitted
   code interns every string literal on its hottest paths. Entries are
   immortal and never removed. The table starts low (256 buckets) and doubles
   on demand under _spec_intern_lock. During a resize, new entry wrappers are
   built into the new table while the old table and its chains stay untouched,
   so concurrent readers never experience data races. */
static _Atomic(SpecInternTable*) _spec_intern_table = NULL;
static pthread_mutex_t _spec_intern_lock = PTHREAD_MUTEX_INITIALIZER;

static inline uint64_t spec_intern_hash(const char* c, size_t n) {
    uint64_t h = 1469598103934665603ULL;
    for (size_t i = 0; i < n; i++) {
        h ^= (unsigned char)c[i];
        h *= 1099511628211ULL;
    }
    return h;
}

static SpecInternTable* spec_intern_table_new(size_t cap) {
    size_t total_size = sizeof(SpecInternTable) + sizeof(_Atomic(SpecInternEntry*)) * cap;
    SpecInternTable* tbl = (SpecInternTable*)spec_xmalloc(total_size);
    tbl->capacity = cap;
    tbl->mask = cap - 1;
    tbl->count = 0;
    for (size_t i = 0; i < cap; i++) {
        atomic_init(&tbl->buckets[i], NULL);
    }
    return tbl;
}

static void spec_intern_resize_under_lock(void) {
    SpecInternTable* old_tbl = atomic_load_explicit(&_spec_intern_table, memory_order_relaxed);
    size_t new_cap = old_tbl->capacity * 2;
    SpecInternTable* new_tbl = spec_intern_table_new(new_cap);
    new_tbl->count = old_tbl->count;
    for (size_t i = 0; i < old_tbl->capacity; i++) {
        SpecInternEntry* curr = atomic_load_explicit(&old_tbl->buckets[i], memory_order_relaxed);
        while (curr) {
            size_t nb = curr->hash & new_tbl->mask;
            SpecInternEntry* ne = (SpecInternEntry*)spec_xmalloc(sizeof(SpecInternEntry));
            ne->s = curr->s;
            ne->hash = curr->hash;
            ne->next = atomic_load_explicit(&new_tbl->buckets[nb], memory_order_relaxed);
            atomic_store_explicit(&new_tbl->buckets[nb], ne, memory_order_relaxed);
            curr = curr->next;
        }
    }
    atomic_store_explicit(&_spec_intern_table, new_tbl, memory_order_release);
}

/* Claim pool: adopts ownership claims in read positions (call arguments,
   conditions, chain targets). The pool is a THREAD-LOCAL STACK that
   starts low and grows: spec_pool_frame marks the depth,
   spec_pool_release_to releases everything above it, and the generated
   code frames each claimed call (mark before the arguments, release
   after the dispatch) so transients die exactly at the call boundary —
   no eviction window, no heuristic tail. */
extern __thread void** _spec_pool_stack;
extern __thread size_t _spec_pool_top;
extern __thread size_t _spec_pool_cap;



static inline void spec_pool_auto_cleanup(size_t* pmark) {
    if (pmark) spec_pool_release_to(*pmark);
}
#define SPEC_POOL_AUTO size_t _spec_pool_mark __attribute__((cleanup(spec_pool_auto_cleanup))) = spec_pool_frame()

static inline void spec_pool_thread_cleanup(void) {
    if (_spec_pool_stack) {
        spec_pool_release_to(0);
        free(_spec_pool_stack);
        _spec_pool_stack = NULL;
        _spec_pool_top = 0;
        _spec_pool_cap = 0;
    }
}


/* Spec First-Class Closure Representation */
