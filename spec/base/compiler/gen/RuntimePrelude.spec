    SOCKET s = accept((SOCKET)fd, NULL, NULL);
    if (s == INVALID_SOCKET) {
        _spec_emit_last_sock_error(on_error, "Socket error: accept() failed");
        return -1;
    }
    return (long long)s;
#else
    int s = accept((int)fd, NULL, NULL);
    if (s < 0) {
        _spec_emit_last_sock_error(on_error, "Socket error: accept() failed");
    }
    return (long long)s;
#endif
}

