String spec_file_temp_cb(String template, SpecClosure* on_error) {
#if defined(_WIN32)
    CreateDirectoryA("/tmp", NULL);
#endif
    if (!template || template->length == 0) template = spec_string_intern("/tmp/spec_XXXXXX");
    const char* tpl = spec_buf_to_cstring((SpecBuf*)template);
    size_t len = strlen(tpl);
    char* buf = (char*)spec_xmalloc(len + 32);
    strcpy(buf, tpl);
    char suffix[64];
    suffix[0] = '\0';
    char* xpos = strstr(buf, "XXXXXX");
    if (!xpos) {
        strcat(buf, "_XXXXXX");
    } else {
        if (strlen(xpos + 6) < sizeof(suffix)) {
            strcpy(suffix, xpos + 6);
        }
        xpos[6] = '\0';
    }
    int fd = mkstemp(buf);
#if defined(_WIN32)
    if (fd == -1 && (strncmp(tpl, "/tmp/", 5) == 0 || strcmp(tpl, "/tmp") == 0)) {
        char temp_dir[MAX_PATH];
        DWORD td_len = GetTempPathA(MAX_PATH, temp_dir);
        if (td_len > 0 && td_len < MAX_PATH) {
            const char* base = strrchr(tpl, '/');
            const char* b2 = strrchr(tpl, '\\');
            if (b2 && (!base || b2 > base)) base = b2;
            if (base) base++; else base = tpl;
            free(buf);
            buf = (char*)spec_xmalloc(strlen(temp_dir) + strlen(base) + 32);
            sprintf(buf, "%s%s", temp_dir, base);
            suffix[0] = '\0';
            xpos = strstr(buf, "XXXXXX");
            if (!xpos) {
                strcat(buf, "_XXXXXX");
            } else {
                if (strlen(xpos + 6) < sizeof(suffix)) {
                    strcpy(suffix, xpos + 6);
                }
                xpos[6] = '\0';
            }
            fd = mkstemp(buf);
        }
    }
#endif
    if (fd == -1) {
        int saved_errno = errno;
        free(buf);
        _spec_emit_str_error(on_error, strerror(saved_errno));
        return spec_string_intern("");
    }
    close(fd);
    if (suffix[0] != '\0') {
        size_t final_len = strlen(buf) + strlen(suffix) + 1;
        char* final_path = (char*)spec_xmalloc(final_len);
        sprintf(final_path, "%s%s", buf, suffix);
        if (rename(buf, final_path) != 0) {
            int saved_errno = errno;
            free(final_path);
            free(buf);
            _spec_emit_str_error(on_error, strerror(saved_errno));
            return spec_string_intern("");
        }
        String res = spec_string_from_chars(final_path);
        free(final_path);
        free(buf);
        return res;
    }
    String res = spec_string_from_chars(buf);
    free(buf);
    return res;
}

String spec_file_temp(String template) {
    return spec_file_temp_cb(template, NULL);
}

long long spec_process_execute(String command, SpecArray* args) {
    if (!command) return -1;
    const char* cc = spec_buf_to_cstring((SpecBuf*)command);
#if defined(_WIN32)
    size_t total_len = strlen(cc) + 1;
    if (args) {
        for (size_t i = 0; i < args->length; i++) {
            if (!args->items[i]) continue;
            const char* a = spec_buf_to_cstring((SpecBuf*)args->items[i]);
            total_len += strlen(a) * 2 + 4;
        }
    }
    char* cmd_line = (char*)spec_xmalloc(total_len + 1);
    char* w = cmd_line;
    size_t cmd_len = strlen(cc);
    memcpy(w, cc, cmd_len);
    w += cmd_len;
    if (args) {
        for (size_t i = 0; i < args->length; i++) {
            if (!args->items[i]) continue;
            const char* a = spec_buf_to_cstring((SpecBuf*)args->items[i]);
            *w++ = ' ';
            bool needs_quote = (*a == 0);
            for (size_t k = 0; a[k]; k++) {
                if (a[k] == ' ' || a[k] == '\t' || a[k] == '\n' || a[k] == '\v' || a[k] == '\"') {
                    needs_quote = true;
                    break;
                }
            }
            if (!needs_quote) {
                size_t alen = strlen(a);
                memcpy(w, a, alen);
                w += alen;
            } else {
                *w++ = '\"';
                size_t slashes = 0;
                for (size_t k = 0; a[k]; k++) {
                    if (a[k] == '\\') {
                        slashes++;
                    } else if (a[k] == '\"') {
                        for (size_t s = 0; s < slashes * 2 + 1; s++) *w++ = '\\';
                        *w++ = '\"';
                        slashes = 0;
                    } else {
                        for (size_t s = 0; s < slashes; s++) *w++ = '\\';
                        *w++ = a[k];
                        slashes = 0;
                    }
                }
                for (size_t s = 0; s < slashes * 2; s++) *w++ = '\\';
                *w++ = '\"';
            }
        }
    }
    *w = 0;
    STARTUPINFOA si;
    PROCESS_INFORMATION pi;
    memset(&si, 0, sizeof(si));
    si.cb = sizeof(si);
    memset(&pi, 0, sizeof(pi));
    DWORD exit_code = 1;
    if (CreateProcessA(NULL, cmd_line, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {
        WaitForSingleObject(pi.hProcess, INFINITE);
        GetExitCodeProcess(pi.hProcess, &exit_code);
        CloseHandle(pi.hProcess);
        CloseHandle(pi.hThread);
        free(cmd_line);
        return (long long)exit_code;
    }
    int status = system(cmd_line);
    free(cmd_line);
    return (long long)status;
#else
    /* Each argument is passed to the shell as ONE single-quoted word (a
       quote inside becomes quote, backslash, quote, quote), so spaces and
       shell metacharacters in arguments stay data. The command word
       itself is left to the shell. */
    size_t total_len = strlen(cc) + 1;
    if (args) {
        for (size_t i = 0; i < args->length; i++) {
            if (!args->items[i]) continue;
            const char* a = spec_buf_to_cstring((SpecBuf*)args->items[i]);
            size_t quotes = 0;
            for (size_t k = 0; a[k]; k++) if (a[k] == 39) quotes++;
            total_len += strlen(a) + 3 * quotes + 3;
        }
    }
    char* cmd_line = (char*)spec_xmalloc(total_len + 1);
    char* w = cmd_line;
    size_t cmd_len = strlen(cc);
    memcpy(w, cc, cmd_len);
    w += cmd_len;
    if (args) {
        for (size_t i = 0; i < args->length; i++) {
            if (!args->items[i]) continue;
            const char* a = spec_buf_to_cstring((SpecBuf*)args->items[i]);
            *w++ = ' ';
            *w++ = 39;
            for (size_t k = 0; a[k]; k++) {
                if (a[k] == 39) { *w++ = 39; *w++ = 92; *w++ = 39; *w++ = 39; }
                else *w++ = a[k];
            }
            *w++ = 39;
        }
    }
    *w = 0;
    int status = system(cmd_line);
    free(cmd_line);
    if (status == -1) return -1;
    if (WIFSIGNALED(status)) return 128 + (long long)WTERMSIG(status);
    return (long long)WEXITSTATUS(status);
#endif
}

static int g_spec_argc = 0;
static char** g_spec_argv = NULL;

void spec_set_cli_args(int argc, char** argv) {
    g_spec_argc = argc;
    g_spec_argv = argv;
}

static void spec_cli_arg_set(SpecMap* args, String key, String val) {
    String prev = (String)spec_map_get(args, key, NULL);
    if (prev) {
        spec_map_set(args, key, spec_string_concat(prev, spec_string_concat(spec_string_intern("\n"), val)));
    } else {
        spec_map_set(args, key, val);
    }
}

SpecMap* spec_cli_args_map(long long argc_ll, char** argv) {
    int argc = (int)argc_ll;
    spec_set_cli_args(argc, argv);
    SpecMap* args = spec_map_new();
    int pos_idx = 0;
    for (int i = 1; i < argc; i++) {
        if (strncmp(argv[i], "--", 2) == 0) {
            const char* eq = strchr(argv[i] + 2, '=');
            if (eq) {
                int klen = (int)(eq - (argv[i] + 2));
                spec_cli_arg_set(args, spec_string_from_bytes(argv[i] + 2, klen), spec_string_from_chars(eq + 1));
            } else {
                const char* key = argv[i] + 2;
                const char* val = "true";
                if (i + 1 < argc && argv[i + 1][0] != '-') {
                    val = argv[++i];
                }
                spec_cli_arg_set(args, spec_string_from_chars(key), spec_string_from_chars(val));
            }
        } else if (argv[i][0] == '-' && argv[i][1] != 0) {
            const char* eq = strchr(argv[i] + 1, '=');
            if (eq) {
                int klen = (int)(eq - (argv[i] + 1));
                spec_cli_arg_set(args, spec_string_from_bytes(argv[i] + 1, klen), spec_string_from_chars(eq + 1));
            } else {
                const char* key = argv[i] + 1;
                const char* val = "true";
                if (i + 1 < argc && argv[i + 1][0] != '-') {
                    val = argv[++i];
                }
                spec_cli_arg_set(args, spec_string_from_chars(key), spec_string_from_chars(val));
            }
        } else {
            char pos_buf[16];
            snprintf(pos_buf, sizeof(pos_buf), "%d", pos_idx++);
            spec_cli_arg_set(args, spec_string_from_chars(pos_buf), spec_string_from_chars(argv[i]));
            spec_cli_arg_set(args, spec_string_intern(""), spec_string_from_chars(argv[i]));
        }
    }
    return args;
}

SpecArray* spec_process_raw_args(void) {
    SpecArray* out = spec_array_new_object();
    for (int i = 1; i < g_spec_argc; i++) {
        spec_array_add_owned(out, (void*)spec_string_from_chars(g_spec_argv[i] ? g_spec_argv[i] : ""));
    }
    return out;
}

